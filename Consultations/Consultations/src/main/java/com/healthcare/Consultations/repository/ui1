<app-page-title
[Title]="dashboardTitle"
  [Component]="COMPONENT.ADMIN_MAIN"
  [BreadcrumbArray]="breadcrumbArray"
  [isRadioButtonRequired] = true
  [radioButtonValues] = "dashboards"
(radioSelection)="onRadioSelectionChanged($event)"
></app-page-title>
<div class="container-fluid p-2 px-md-5" *ngIf="selectedDashboard === 'Service'">
  <div class="DSA_wb_customTab DSA_navTab DSA_wb_Primary mb-5">
    <mat-tab-group disableRipple class="bg-white"  animationDuration="0ms" (selectedTabChange)='tabChange($event)'>
      <mat-tab label="Inbox">
        <div class="row pt-5 pb-2 px-4">
          <div class="col-8">
            <div class="capsule-button" (click)="toggleByAction(tab.inbox , selection.viewAll)" [ngClass]="{'active':viewAllInbox===true}">VIEW ALL</div>
            <div class="capsule-button" (click)="toggleByAction(tab.inbox , selection.myActions)" [ngClass]="{'active':myActionsInbox===true}">MY ACTIONS</div>
            <div class="capsule-button" (click)="toggleByAction(tab.inbox , selection.others)" [ngClass]="{'active':othersInbox===true}">OTHERS</div>
          </div>
          <div class="col-4">
            <!-- <div class="text-success count-text" *ngIf="submittedAndResubmittedApis">{{submittedAndResubmittedApis.length}} Submitted APIs</div> -->
            <div class="text-success count-text" *ngIf="submittedApis">{{submittedTotalCount}} Submitted APIs</div>
          </div>
        </div>
        <!-- Inbox Request Table -->
        <app-api-requests-table
          [apis]="submittedApis"
          *ngIf="submittedApis"
          [tab]='tab.inbox'
          [totalCount]="submittedTotalCount"
          [pageNum]="pageNum"
          (pageChange)="onInboxPageChange($event)"
          (sortChange)="onSortChange($event.sortField, $event.sortOrder)"
        ></app-api-requests-table>


      </mat-tab>

      <mat-tab label="Approved">
        <div class="row pt-5 pb-2 px-4">
          <div class="col-8">
            <div class="capsule-button" (click)="toggleByAction(tab.approved , selection.viewAll)" [ngClass]="{'active':viewAllApproved===true}">VIEW ALL</div>
            <div class="capsule-button" (click)="toggleByAction(tab.approved , selection.myActions)" [ngClass]="{'active':myActionsApproved===true}">MY ACTIONS</div>
            <div class="capsule-button" (click)="toggleByAction(tab.approved , selection.others)" [ngClass]="{'active':othersApproved===true}">OTHERS</div>
          </div>
          <div class="col-4">
            <div class="text-success count-text" *ngIf="approvedApis">{{approvedTotalCount}} Approved APIs</div>
          </div>
        </div>
        <!-- Approved Request Table -->
        <app-api-requests-table [apis]="approvedApis"
        *ngIf="approvedApis"
        [tab]='tab.approved'
        [totalCount]="approvedTotalCount"
        [pageNum]="pageNum"
        (pageChange)="onApprovedPageChange($event)"
        (sortChange)="onSortChange($event.sortField, $event.sortOrder)"
        ></app-api-requests-table>
      </mat-tab>
      <mat-tab label="Pending">
        <div class="row pt-5 pb-2 px-4">
          <div class="col-8">
            <div class="capsule-button" (click)="toggleByAction(tab.pending , selection.viewAll)" [ngClass]="{'active':viewAllPending===true}">VIEW ALL</div>
            <div class="capsule-button" (click)="toggleByAction(tab.pending , selection.myActions)" [ngClass]="{'active':myActionsPending===true}">MY ACTIONS</div>
            <div class="capsule-button" (click)="toggleByAction(tab.pending , selection.others)" [ngClass]="{'active':othersPending===true}">OTHERS</div>
          </div>
          <div class="col-4">
            <div class="text-success count-text" *ngIf="pendingApis">{{pendingTotalCount}} Pending APIs</div>
          </div>
        </div>
        <!-- Pending Request Table -->
        <app-api-requests-table [apis]="pendingApis"
          [tab]='tab.pending'
          [totalCount]="pendingTotalCount"
          [pageNum]="pageNum"
          *ngIf="pendingApis"
          (pageChange)="onPendingPageChange($event)"
          (sortChange)="onSortChange($event.sortField, $event.sortOrder)"
        ></app-api-requests-table>
      </mat-tab>
      <mat-tab label="Rejected">
        <div class="row pt-5 pb-2 px-4">
          <div class="col-8">
            <div class="capsule-button" (click)="toggleByAction(tab.rejected , selection.viewAll)" [ngClass]="{'active':viewAllRejected===true}">VIEW ALL</div>
            <div class="capsule-button" (click)="toggleByAction(tab.rejected , selection.myActions)" [ngClass]="{'active':myActionsRejected===true}">MY ACTIONS</div>
            <div class="capsule-button" (click)="toggleByAction(tab.rejected , selection.others)" [ngClass]="{'active':othersRejected===true}">OTHERS</div>
          </div>
          <div class="col-4">
            <div class="text-success count-text" *ngIf="rejectedApis">{{rejectedTotalCount}} Rejected APIs</div>
          </div>
        </div>
        <!-- Rejected Request Table -->
        <app-api-requests-table [apis]="rejectedApis"
          [tab]='tab.rejected'
