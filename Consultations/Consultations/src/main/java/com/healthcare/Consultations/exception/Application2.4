4436
Create new DB Table for apicloud.api_resource_links


This user story is to make the necessary Database changes to hold Resource Links in the DB.  

Implementation Details:

CREATE TABLE apicloud.api_resource_links (
    link_id BIGSERIAL PRIMARY KEY,
    api_family_id BIGINT NOT NULL,
    category_id INTEGER NOT NULL,
    subcategory_id INTEGER NOT NULL,
    title VARCHAR(255) ,
    url TEXT NOT NULL,
    created_ts TIMESTAMP WITHOUT TIME ZONE DEFAULT NOW(),
    updated_ts TIMESTAMP WITHOUT TIME ZONE DEFAULT NOW(),
    
    CONSTRAINT fk_api_resource_links_family FOREIGN KEY (api_family_id)
        REFERENCES apicloud.api_families(api_family_id) ON DELETE CASCADE,
    CONSTRAINT fk_api_resource_links_category FOREIGN KEY (category_id)
        REFERENCES apicloud.api_resource_categories(category_id) ON DELETE RESTRICT,
    CONSTRAINT fk_api_resource_links_subcategory FOREIGN KEY (subcategory_id)
        REFERENCES apicloud.api_resource_subcategories(subcategory_id) ON DELETE RESTRICT
);

-- Indexes for performance
CREATE INDEX idx_api_resource_links_family ON apicloud.api_resource_links(api_family_id);
CREATE INDEX idx_api_resource_links_category ON apicloud.api_resource_links(category_id);
CREATE INDEX idx_api_resource_links_subcategory ON apicloud.api_resource_links(subcategory_id);
CREATE INDEX idx_api_resource_links_family_category ON apicloud.api_resource_links(api_family_id, category_id);  
 

