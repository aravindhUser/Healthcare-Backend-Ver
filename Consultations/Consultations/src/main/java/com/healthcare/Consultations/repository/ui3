table {
  width: 100%;
}

.table-header{
  color: #000000;
  font-size: 14px;
  font-weight: 600;
}

.table-link{
  color:#004366;
  cursor: pointer;
}

//Vert-Menu
.mat-menu-item {
  text-align: left;
  font: normal normal normal 14px;
  letter-spacing: 0px;
  color: #141414;
  opacity: 1;
  line-height: 16px;
  height: 30px;
  .reject_option {
    color: #c93b3b;
  }

  .pending_option{
    color: #D97800;
  }
}

//--------------------------//
.mat-table {
  width: 100%;
  table-layout: fixed;
}

.mat-header-cell, .mat-cell {
  padding:12px 12px;
  line-height: 20px;
  font-size: 14px;
  
  vertical-align: middle;
  box-sizing: border-box;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mat-row, .mat-header-row {
  height: 52px;
}

.api-name {
  display: inline-block;
  width: 100%;
  cursor: pointer;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mat-cell * , .mat-header-cell * {
  margin: 0;
  padding: 0;
  line-height: inherit;
}
