 <div class="row mt-5 pl-0">
        <div class="col pl-0">
             <span class="sub-heading">Supporting Resources</span>
             <hr />
        </div>
    </div>
 
    <div class="row">
 
    <!-- LEFT COLUMN -->
    <div class="col-md-6">
      <ng-container *ngFor="let cat of supportingResources">
        <ng-container *ngIf="cat.categoryName === 'documentation' || cat.categoryName === 'source-control'">
         
          <div class="mb-4">
            <div class="font-weight-bold text-sm mb-2">
              {{ getCategoryTitle(cat.categoryName) }}
            </div>
 
            <div *ngFor="let resources of cat.resources" class="row mb-1">
              <div class="col-md-6 field-name">
                {{ getSubCategoryTitle(resources.title) }}
              </div>
              <div class="col-md-6">
                <a *ngIf="resources.link" [href]="resources.link" target="_blank" class="resource-link">
                  {{ resources.link }}
                </a>
                <span *ngIf="!resources.link">
                  Link unavailable
                </span>
              </div>
            </div>
          </div>
        </ng-container>
      </ng-container>
    </div>
 
    <!-- RIGHT COLUMN -->
    <div class="col-md-6">
      <ng-container *ngFor="let cat of supportingResources">
        <ng-container *ngIf="cat.categoryName === 'reference' || cat.categoryName === 'testing'">

          <div class="mb-4">
            <div class="font-weight-bold text-sm mb-2">
              {{ getCategoryTitle(cat.categoryName) }}
            </div>
 
            <div *ngFor="let resources of cat.resources" class="row mb-1">
              <div class="col-md-6 field-name">
                {{ getSubCategoryTitle(resources.title) }}
              </div>
              <div class="col-md-6">
                <a *ngIf="resources.link" [href]="resources.link" target="_blank" class="resource-link">
                  {{ resources.link }}
                </a>
                <span *ngIf="!resources.link">
                  Link unavailable
                </span>
              </div>
            </div>
          </div>
        </ng-container>
      </ng-container>
    </div>
 
  </div>
