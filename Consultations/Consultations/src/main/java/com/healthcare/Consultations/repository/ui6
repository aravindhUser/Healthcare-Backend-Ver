table {
  width: 100%;
}

.table-header{
  color: #000000;
  font-size: 14px;
  font-weight: 600;
}

.table-link{
  color:#004366;
  cursor: pointer;
}

//Vert-Menu
.mat-menu-item {
  text-align: left;
  font: normal normal normal 14px;
  letter-spacing: 0px;
  color: #141414;
  opacity: 1;
  line-height: 16px;
  height: 30px;
  .reject_option {
    color: #c93b3b;
  }

  .pending_option{
    color: #D97800;
  }
}
.mat-table {
  width: 100%;
  table-layout: fixed;
}
 
.mat-header-cell,
.mat-cell {
  padding: 10px 12px;
  font-size: 14px;
  line-height: 18px;
 
  vertical-align: middle;
  box-sizing: border-box;
 
  white-space: normal;
  word-break: break-word;
}

.mat-header-cell {
  font-weight: 600;
  text-align: center;
 
  word-break: keep-all;
  overflow-wrap: normal;
}

.mat-row,
.mat-header-row {
  min-height: 52px;
}

.mat-cell *,
.mat-header-cell * {
  margin: 0;
  padding: 0;
  line-height: inherit;
}

.mat-column-apiDetails\.apiName {
  width: 23%;
 
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
 
.mat-column-apiDetails\.apiVersion {
  width: 4%;
  text-align: center;
 
  white-space: nowrap;
}

.mat-column-apiDetails\.apiGatewayName {
  width: 9%;
}

.mat-column-apiDetails\.basePath {
  width: 14%;
 
  word-break: break-all;
}
 
.mat-column-api\.clientTrackingInfo\.pinxt {
  width: 10%;
  text-align: center;
 
  word-break: break-all;
}
 
.mat-column-api\.clientTrackingInfo\.pinxt a {
  word-break: keep-all;
}
 
.mat-column-apiDetails\.requestedBy,
.mat-column-actionBy {
  width: 13%;
  text-align: left;
 
  word-break: break-all;
}
 

.mat-column-apiDetails\.requestedTimestamp {
  width: 8%;
  text-align: center;
 
  word-break: keep-all;
}
 

.mat-column-actionTs {
  width: 9%;
  text-align: center;
 
  word-break: keep-all;
}

.mat-column-status {
  width: 8%;
  text-align: center;
 
  white-space: nowrap;
}

.mat-column-action {
  width: 6%;
  text-align: center;
 
  white-space: nowrap;
}
 
.mat-column-action button {
  min-width: 32px;
  padding: 0;
}

.mat-header-cell {
  max-height: 36px;
  overflow: hidden;
}
