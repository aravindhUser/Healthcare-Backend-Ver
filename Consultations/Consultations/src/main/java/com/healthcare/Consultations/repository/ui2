import {
  AfterViewInit,
  Component,
  Input,
  OnInit,
  OnChanges,
  ViewChild,
  Inject,
  Output,
  EventEmitter
} from '@angular/core';
import { MatPaginator } from '@angular/material/paginator';
import { MatSort } from '@angular/material/sort';
import { MatTableDataSource } from '@angular/material/table';
import { IDashboard } from '../../../../core/models/iDashboard';
import { Router } from '@angular/router';

import { MatDialog, MatDialogRef, MAT_DIALOG_DATA } from '@angular/material/dialog';
import { ApiSubmissionService } from 'src/app/core/services/publish/api-submission.service';
import { PageTitleFilterService } from 'src/app/core/services/ui-util/page-title-filter/page-title-filter.service';
import { StateVariablesService } from 'src/app/core/services/ui-util/state-variables/state-variables.service';
import { DashboardStorage } from '../../../../../assets/constants/app.constants';
import { Status } from 'src/app/core/enum/DashboardStatus.enum';
import { EnvironmentLoaderService } from 'src/app/core/config/environment-loader.service';
import { DialogBoxComponent } from 'src/app/shared/components/dialog-box/dialog-box.component';
import { DialogBoxActionEnum } from 'src/app/core/enum/DialogBoxActionEnum';


enum Tab{
  inbox = 'inbox',
  approved = 'approved',
  pending = 'pending',
  rejected = 'rejected'
}

interface DialogData {
  title: string;
  message: string;
  redirection: string;
}

@Component({
  selector: 'app-api-requests-table',
  templateUrl: './api-requests-table.component.html',
  styleUrls: ['./api-requests-table.component.scss'],
})
export class ApiRequestsTableComponent implements OnInit, OnChanges, AfterViewInit {
  @Input() apis: IDashboard[];
  @Input() tab: string;
  @Input() totalCount: number = 0;
  @Input() pageNum: number = 1;
  @Output() pageChange = new EventEmitter<{pageSize: number, pageNum: number}>();
  @Output() sortChange = new EventEmitter<{sortField: string, sortOrder: string}>();
  dataSource: MatTableDataSource<IDashboard>;
  displayedColumns: string[] = ['apiDetails.apiName', 'apiDetails.apiVersion','apiDetails.apiGatewayName', 'apiDetails.basePath', 'api.clientTrackingInfo.pinxt','apiDetails.requestedBy', 'actionBy', 'apiDetails.requestedTimestamp','actionTs','status', 'action'];
  selectedTab = 'inbox';

  title: string;
  message: string;
  redirection: string;

  statusOptions = Status;
  filter1='';
  filter2='';
  filter3='';
  globalMatch=true;
  firstMatch=true;
  secondMatch=true;
  thirdMatch= true;

  actionHistory:any;//Code for implementing PINXTSS-2604

  reqBy: string = '';   // for passing in requestedBy in the update call in approval
  reqTS: string = '';
  private paginator: MatPaginator;
  private sort: MatSort;
  private paginatorSubscribed = false;
  private sortSubscribed = false;
  jiraBasePath: string;
  constructor(private router: Router,
    private pageTitlefilterService: PageTitleFilterService,
    private stateVariablesService:StateVariablesService,
    public dialog: MatDialog,
    private apiSubmissionService: ApiSubmissionService,
    public readonly envService: EnvironmentLoaderService
    ) {
      //This is intentional
    }

  ngOnInit(): void {
    this.jiraBasePath = this.envService.getEnvConfig().jiraTicket;
    this.dataSource = new MatTableDataSource<IDashboard>(this.apis);
  }

  ngOnChanges() {
    if (this.dataSource) {
      this.dataSource.data = this.apis;
    }
    if (this.paginator) {
      this.paginator.length = this.totalCount;
      this.paginator.pageIndex = (this.pageNum || 1) - 1;
    }
  }

  @ViewChild(MatSort) set matSort(ms: MatSort) {
    this.sort = ms;
    if (this.sort && !this.sortSubscribed) {
      this.sortSubscribed = true;
      this.sort.sortChange.subscribe(() => {
        const sortField = this.mapSortField(this.sort.active);
        const sortOrder = this.sort.direction || 'desc';
        this.sortChange.emit({ sortField, sortOrder });
      });
    }
  }

  @ViewChild(MatPaginator) set matPaginator(mp: MatPaginator) {
    this.paginator = mp;
    if (this.paginator) {
      this.paginator.length = this.totalCount;
      this.paginator.pageIndex = (this.pageNum || 1) - 1;
      if (!this.paginatorSubscribed) {
        this.paginatorSubscribed = true;
        this.paginator.page.subscribe(() => {
          this.pageNum = this.paginator.pageIndex + 1;
          this.pageChange.emit({
            pageSize: this.paginator.pageSize,
            pageNum: this.pageNum
          });
        });
      }
    }
  }



  mapSortField(columnName: string): string {
    const fieldMap = {
      'apiDetails.apiName': 'apiName',
      'apiDetails.apiVersion': 'apiVersion',
      'apiDetails.apiGatewayName': 'apiGatewayName',
      'apiDetails.basePath': 'basePath',
      'api.clientTrackingInfo.pinxt': 'pinxt',
      'apiDetails.requestedBy': 'requestedBy',
      'actionBy': 'actionBy',
      'apiDetails.requestedTimestamp': 'requestedTimestamp',
      'actionTs': 'lastUpdated',
      'status': 'status'
    };
    return fieldMap[columnName] || columnName;
  }
  ngAfterViewInit() {
    this.stateVariablesService.adminApiViewerSelectedTab.subscribe(
      x => {
        this.selectedTab = x;
        // Reset sort and paginator visual indicators when tab changes
        if (this.tab === x) {
          if (this.sort) {
            this.sort.active = 'actionTs';
            this.sort.direction = 'desc';
          }
          if (this.paginator) {
            this.paginator.pageSize = 10;
            this.paginator.pageIndex = 0;
          }
        }
      }
    );
  }

  viewApi(api) {
    sessionStorage.removeItem(DashboardStorage.selectedDashboardObjAdmin);
    localStorage.removeItem(DashboardStorage.swaggerEditorData);
    localStorage.removeItem(DashboardStorage.swaggerEditorUpdatedData)
    sessionStorage.removeItem('basePath');
    sessionStorage.removeItem(DashboardStorage.dashboardOverviewReview);
    sessionStorage.removeItem('swaggerInfo');
    sessionStorage.removeItem('securityData');
    sessionStorage.removeItem('overrideData');
    sessionStorage.removeItem(DashboardStorage.dashboardStateSnapshotReview);
    sessionStorage.removeItem(DashboardStorage.selectedDashboardObjProfile);
    sessionStorage.removeItem('pluginChangedFromCI');
    sessionStorage.removeItem('resourceChangedFromSwagger');
    sessionStorage.removeItem('resubmitFlowInitiatedBy');
    sessionStorage.removeItem('cmdbAppId');
    sessionStorage.removeItem('producerTeamId');//Code for implementing PINXTSS-3086
    sessionStorage.removeItem('operationsTeamId');//Code for implementing PINXTSS-3086
    sessionStorage.removeItem('nextClicked');
    sessionStorage.removeItem('initialResourcePaths');
    sessionStorage.removeItem('originalTargetBasePath');
    sessionStorage.removeItem('monitoringInfo');//Code for implementing PINXTSS-3722
    let id= api.requestId;
    this.apiSubmissionService.getDashboardEntryById(id).subscribe((data) => {
      // Code for implementing PINXTSS-2604 start
      this.actionHistory = data["actionHistory"];
      // this.actionHistory.sort((a,b)=>new Date(b.actionTimestamp).getTime()-new Date(a.actionTimestamp).getTime());
      let currentUser = JSON.parse(localStorage.getItem('currentUser'));
      if(currentUser.userId===this.actionHistory[this.actionHistory.length-1].actionBy && this.envService.getEnvConfig().isAdminSelfApprovalEnabled===false){
        const popupData = { action: DialogBoxActionEnum.COMMON_ALERT_BOX, commonAlertBox:{title:'Invalid Request', message:"Admin can't review self-submitted APIs."} };
        this.dialog.open(DialogBoxComponent, {width: '750px', data: popupData, });
      }
      else{
      // Code for implementing PINXTSS-2604 end
      sessionStorage.setItem(DashboardStorage.selectedDashboardObjAdmin, JSON.stringify(data));
      sessionStorage.setItem('specF','OAS (Swagger)');
      // sessionStorage.setItem('apiName','');//Commeneted for test purpose
      sessionStorage.setItem('apiName',data["apiDetails"].apiName);//Code for implementing PINXTSS-2218
      sessionStorage.setItem('publishType','Save & Publish');
      let cpAttachedPlugins = data["apiDetails"]["cpAttachedPlugins"] || []
      sessionStorage.setItem("cpAttachedPlugins", JSON.stringify(cpAttachedPlugins))
      let spAttachedPlugins = data["apiDetails"]["spAttachedPlugins"] || []
      sessionStorage.setItem("spAttachedPlugins", JSON.stringify(spAttachedPlugins))
      //let overrides = data["apiDetails"]["overrides"] || []
      //sessionStorage.setItem("overrides", JSON.stringify(overrides))
      let targetMapping = data["apiDetails"]["targetMapping"] || []
      sessionStorage.setItem("targetMapping", JSON.stringify(targetMapping))
      sessionStorage.setItem("initialTargetMapping", JSON.stringify(targetMapping));
      // sessionStorage.setItem('apiName','');//Commenetd for test purpose
      sessionStorage.setItem('originalTargetBasePath', data["apiDetails"]["targetBasePath"]);
      this.router.navigate(['/admin/viewapi']);
    }//Code for implementing PINXTSS-2604
    },
    (err) => {
      console.log(err)
    }
    )
  }

  updateApi(api, status: Status){
   this.reqBy = api.apiDetails.requestedBy;
   this.reqTS = api.apiDetails.requestedTimestamp;


   this.apiSubmissionService
      .approveAPIDirectly(api.apiDetails, api.requestId, status, this.reqBy, this.reqTS)
      .then((data) => {
        data.subscribe(
          (x) => {
            this.title = 'Success';
            this.redirection = '/admin';

            if (status === Status.Pending) {
              this.message = 'API has been moved to pending status.';
            } else if (status === Status.Rejected) {
              this.message = 'API has been rejected successfully.';
            } else if (status === Status.Approved) {
              this.message = 'API has been approved successfully.';
            } else {
              this.message =
                'Backend responded with dashboard status as ' + status + '.';
            }
            sessionStorage.removeItem(DashboardStorage.selectedDashboardObjAdmin);
            localStorage.removeItem(DashboardStorage.swaggerEditorData);
            sessionStorage.removeItem('basePath');
            sessionStorage.removeItem(DashboardStorage.dashboardOverviewReview);
            sessionStorage.removeItem('swaggerInfo');
            sessionStorage.removeItem('securityData');
            this.openDialog();
          },
          (err) => {
            this.title = 'Request failed';
            this.message = 'Request failed, please try again later.';
            this.redirection = '/admin';
          }
        );
      })
      .catch((err) => {
        this.title = 'Failed';
        this.message = 'Submission failed. Please try again later.';
        this.redirection = '/admin';
        this.openDialog();
      });
  }


  openDialog(): void {
     this.dialog.open(SubmittedApiDialog, {
      width: '400px',
      data: { title: this.title, message: this.message, redirection: this.redirection },
    });
  }
}


@Component({
  selector: 'app-submit-api-dialog',
  templateUrl: 'submit-api.dialog.html',
})
export class SubmittedApiDialog {
  constructor(
    public dialogRef: MatDialogRef<SubmittedApiDialog>,
    @Inject(MAT_DIALOG_DATA) public data: DialogData
  ) {
  //This is intentional
  }

  onClose(): void {
    this.dialogRef.close();
    window.location.reload();
  }
}

