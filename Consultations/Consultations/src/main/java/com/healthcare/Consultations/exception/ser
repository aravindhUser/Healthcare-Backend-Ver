Optional<List<ApiResourceLinks>> OptionalLinks =
                            Optional.ofNullable(
                                    apiResourceLinksRepository.findApiResourceLinksByApiFamilyId(apiFamilyId));

                      List<ApiResourceLinks> links = OptionalLinks
                                    .filter(list -> !list.isEmpty())
                                    .orElse(Collections.emptyList());

                      List<ApiResourceLinksDTO> linkDTOs = links.stream()
                                    .map(link -> modelMapper.map(link, ApiResourceLinksDTO.class))
                                    .collect(Collectors.toList());

                    apientity.setApiResourceLinks(linkDTOs);

                    logger.info("traceId={} transactionId={} - Retrieved API {} with {} resource links",
                            xTraceId, transactionID, id, linkDTOs.size());

                   List<Long> linkIds = linkDTOs.stream()
                                    .map(ApiResourceLinksDTO::getLinkId)
                                            .collect(Collectors.toList());

                  logger.debug("traceId={} transactionId={} - API resource linkIds: {}",
                            xTraceId, transactionID, id, linkIds);
                }
                catch (Exception ex) {
                    logger.error("traceId={} transactionId={} - Failed to retrieve resource links for API {} : {}",
                            xTraceId, transactionID, id, ex.getMessage(),ex);
                }
                logger.info("traceId={} transactionId={} - Successfully built API response for apiId={}",
                        xTraceId, transactionID, id);

                logger.info("apientity object for response:{}", apientity);
                return new ResponseEntity(apientity, HttpStatus.OK);

            } else {
                throw new RecordNotFoundException("No record exist for given id");
            }
        } catch (RecordNotFoundException e){
            throw e;
        } catch(Exception e) {
            logger.error("Exception occured in getApiWithId method:{}", e);
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
                    "Exception occured in getApiWithId method:", e);
        }
    }
