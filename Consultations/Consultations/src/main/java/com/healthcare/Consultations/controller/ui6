  @HostListener('document:click', ['$event'])
  handleOutsideClick(event: MouseEvent) {
    const target = event.target as HTMLElement;
    const insideDomain = target.closest('.domain-filter-chip');
    const insideGateway = target.closest('.gateway-filter-chip');

    if (!insideDomain && this.isDomainDropdownOpen) {
      this.applyDomainFilter();
    }
    if (!insideGateway && this.isGatewayDropdownOpen) {
      this.applyGatewayFilter();
    }
  }

