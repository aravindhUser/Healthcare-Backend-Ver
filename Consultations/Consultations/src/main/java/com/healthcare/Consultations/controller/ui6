  onKeyUp(event: KeyboardEvent) {
    const input = event.target as HTMLInputElement;
    clearTimeout(this.searchTimeout);
    this.searchTimeout = setTimeout(() => {
      this.searchTerm = input.value;
      this.pageNum = 1;//Code to implement PINXTSS-3106
      this.paginator.firstPage();//Code to implement PINXTSS-3106
      this.updateApis();
    }, this.apiListOpensearchTimeoutInterval); // .3 second delay
  
    // Clear error message and reset hasError
    this.errorMessage = '';
    this.hasError = false;
    this.noRecords = false;
  }
  
  public loadAllApis() {
    this.apiService.getApisOnDomainChange("", this.searchTerm,this.pageNum, this.pageSize).subscribe(
      (data) => {
        try {
          this.allApis = data["documents"] || [];          
          this.totalItems = data["totalNumOfDocuments"];
          this.noRecords = this.allApis.length === 0;
          this.hasError = false;
          console.log('All APIs loaded:', this.allApis);
          this.dataSource.data = this.allApis;
          // this.paginator.length = this.totalItems; // Set the total number of items in the paginator//Code commented to implement APIMC-4419
          // Code to implement APIMC-4419 start
          if (this.paginator) {
            this.paginator.length = this.totalItems;
          }
          // Code to implement APIMC-4419 end
        } catch (error) {
          this.hasError = true;
          this.errorMessage = 'We encountered a problem while reading the search results.';
          console.error('Error parsing API data:', error);
        }
      },
      (error) => {
        if (error.status === 400) {
          this.hasError = true;
          this.errorMessage = 'Something went wrong with your request. Please check your input and try again.';
        } 
        else if (error.status === 200) {
          this.hasError = true;
          this.errorMessage = 'We encountered a problem while reading the search results.';
        } else {
          this.hasError = true;
          this.errorMessage = 'We encountered a problem while attempting to retrieve search results.';
        }
        this.noRecords = false;
        console.error('Error loading APIs -->', error);
      }
    );
  }

  onPageChange(event: PageEvent) {
