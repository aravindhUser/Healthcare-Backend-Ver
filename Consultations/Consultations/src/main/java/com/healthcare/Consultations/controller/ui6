    //   domain = 'Enterprise';
    // }else if(this.changedCategory === 'Favorites'){
    //   domain = 'Favorites';
    // }

     if(this.changedCategory === 'Favorites'){
      domain = 'Favorites';
    }

    else if(this.selectedDomains.length > 0){
      domain = this.selectedDomains.join(',');
    }

    else if(this.selectedGateway){
      domain = this.selectedGateway;
    }

    let searchText = '';
    searchText = this.searchTerm;

    // if (this.searchTerm.length >= 3) {
    //   searchText = this.searchTerm;
    // } else {
    //   searchText = '';
    // }
  
    this.apiService.getApisOnDomainChange(domain, searchText,this.pageNum, this.pageSize).subscribe(
      (data) => {
        try {
          this.allApis = data["documents"] || [];
          this.totalItems = data["totalNumOfDocuments"];
          this.noRecords = this.allApis.length === 0;
          this.hasError = false;
          // console.log(this.allApis);
          this.dataSource.data = this.allApis;
          this.paginator.length = this.totalItems; // Set the total number of items in the paginator
        } catch (error) {
          this.hasError = true;
          this.errorMessage = 'Error parsing API data. Please try again later.';
          console.error('Error parsing API data:', error);
        }
      },
      (error) => {
        if (error.status === 400) {
          this.hasError = true;
          this.errorMessage = 'Bad request. Please check your input and try again.';
        } else {
          this.hasError = true;
          this.errorMessage = 'We encountered a problem while attempting to retrieve search results';
        }
        this.noRecords = false;
        console.error('Error loading APIs:', error);
      }
    );
  }

  // Code to implement APIMC-4419 start
  toggleFavorite(api: any) {
    if (this.loadingStars.has(api.apiId)) return;
    
    this.loadingStars.add(api.apiId);
    
    if (api.favorited) {
      // Remove from favorites
      this.apiService.removeFromFavorites(api.apiId).subscribe(
        (response) => {
          api.favorited = false;
          this.loadingStars.delete(api.apiId);
          
          // If we're in favorites tab, refresh the list to update count
          if (this.changedCategory === 'Favorites') {
            // Check if current page will be empty after unfavoriting
            const currentPageStartIndex = (this.pageNum - 1) * this.pageSize;
            const remainingItems = this.totalItems - 1; // Subtract 1 for the unfavorited item
            
            if (currentPageStartIndex >= remainingItems && this.pageNum > 1) {
              // Navigate to previous page if current page will be empty
              this.pageNum = Math.max(1, Math.ceil(remainingItems / this.pageSize));
              this.paginator.pageIndex = this.pageNum - 1;
            }
            
            this.updateApis();
          } else {
            // For non-favorites tabs, just update the favorited status without sorting
            const currentData = [...this.dataSource.data];
            const apiIndex = currentData.findIndex(item => item.apiId === api.apiId);
            if (apiIndex !== -1) {
              currentData[apiIndex] = { ...currentData[apiIndex], favorited: false };
              this.dataSource.data = currentData;
            }
          }
        },
        (error) => {
            // Code for mock start
            // api.favorited = false;
            // this.loadingStars.delete(api.apiId);
            // Code for mock end
            const errorMessage = 'Failed to remove from favorites. Please try again.';
            const data = { action: DialogBoxActionEnum.COMMON_ALERT_BOX, commonAlertBox:{title:'Error', message:errorMessage} };
            const dialogRef = this.dialog.open(DialogBoxComponent, {
              width: '600px',
              data,
            });
            this.loadingStars.delete(api.apiId);
        }
      );
    } else {
      // Add to favorites
      this.apiService.addToFavorites(api.apiId).subscribe(
        (response) => {
          api.favorited = true;
          this.loadingStars.delete(api.apiId);
          
          // For non-favorites tabs, just update the favorited status without sorting
          const currentData = [...this.dataSource.data];
          const apiIndex = currentData.findIndex(item => item.apiId === api.apiId);
          if (apiIndex !== -1) {
            currentData[apiIndex] = { ...currentData[apiIndex], favorited: true };
            this.dataSource.data = currentData;
          }
        },
        (error) => {
            // Code for mock start
            // api.favorited = true;
            // this.loadingStars.delete(api.apiId);
            // Code for mock end
            const errorMessage = 'Failed to add to favorites. Please try again.';
            const data = { action: DialogBoxActionEnum.COMMON_ALERT_BOX, commonAlertBox:{title:'Error', message:errorMessage} };
            const dialogRef = this.dialog.open(DialogBoxComponent, {
              width: '600px',
              data,
            });
            this.loadingStars.delete(api.apiId);
        }
      );
    }
  }
