package com.infy.api.cloud.entity;

import java.sql.Timestamp;

import com.fasterxml.jackson.annotation.JsonIgnore;
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.SequenceGenerator;
import jakarta.persistence.Table;
import lombok.Data;

import org.hibernate.annotations.CreationTimestamp;
import org.hibernate.annotations.UpdateTimestamp;

@Entity
@Table(name = "api_resource_links", schema = "apicloud")
@Data
public class ApiResourceLinks {

    @Id
    @SequenceGenerator(name = "APICLOUD.API_RESOURCE_LINKS_ID_SEQ", sequenceName = "APICLOUD.API_RESOURCE_LINKS_ID_SEQ", allocationSize = 1)
    @GeneratedValue(strategy = GenerationType.SEQUENCE, generator = "APICLOUD.API_RESOURCE_LINKS_ID_SEQ")
    @Column(name = "link_id")
    private Long linkId;

    @Column(name = "api_family_id")
    @JsonIgnore
    private Integer apiFamilyId;

    @Column(name = "category_id")
    private Integer categoryId;

    @Column(name = "subcategory_id")
    private Integer subcategoryId;

    @Column(name = "title")
    private String title;

    @Column(name = "url")
    private String url;

    @Column(name = "created_ts")
    @JsonIgnore
    @CreationTimestamp
    private Timestamp createdTs;

    @Column(name = "updated_ts")
    @JsonIgnore
    @UpdateTimestamp
    private Timestamp updatedTs;
}


