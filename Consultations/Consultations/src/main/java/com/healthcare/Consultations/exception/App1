public ResponseEntity<DasboardMasterRequest> getDashboardId(long id, String jwtToken, String transactionID,
			String xTraceId) throws RecordNotFoundException {
		log.info("Inside getDashboardId method  :");
		DasboardMasterRequest dmr = new DasboardMasterRequest();
		AdminDashboard dashboardEntity = adminDashboardRepository.getById(id);
		if (dashboardEntity == null)
			throw new RecordNotFoundException("No Record found for given ID");
		List<DashboardActionHistoryModel> actionHistoryModels = new ArrayList<>();
		try {

			List<DashboardActionHistory> actionHistoryEntity = actionHistoryRepository
					.getAllDashBoardAction(dashboardEntity.getRequestId());
			for (DashboardActionHistory x : actionHistoryEntity) {
				DashboardActionHistoryModel actionHistoryModel = new DashboardActionHistoryModel();
				actionHistoryModel.setActionBy(x.getActionBy());
				actionHistoryModel.setActionTimestamp(x.getActionTimestamp());
				actionHistoryModel.setCommentText(x.getCommentText());
				actionHistoryModel.setStatus(x.getStatus());
				actionHistoryModels.add(actionHistoryModel);
			}
			dmr.setRequestId(dashboardEntity.getRequestId());
			dmr.setActionBy(dashboardEntity.getActionBy());
			dmr.setActionTs(dashboardEntity.getActionTimestamp());
			dmr.setStatus(dashboardEntity.getStatus());
			dmr.setCommentText(dashboardEntity.getCommentText());
			dmr.setSubmissionType(dashboardEntity.getSubmissionType());
		} catch (ApiCallException e) {
			log.error("Inside ApiCallException catch block :{}", e.getMessage());
			throw new ApiCallException(e.getMessage());
		}
		ResponseEntity<ApiResponse> resultTagApi = null;
		try {
			HttpHeaders header = new HttpHeaders();
			header.add(CONTENTTYPE, APPJSON);
			header.add(AUTH, KEY);
			header.add(AppConstant.XJWT, jwtToken);
			header.add(AppConstant.XTRANSACTIONID, transactionID);
			header.add(AppConstant.XTRACEID, xTraceId);
            header.add("target","dev-beta");
			HttpEntity<String> apisEntity = new HttpEntity(header);
			String url = appConfig.getApiServicePath() + "/" + dashboardEntity.getApiId();
			resultTagApi = restTemplate.exchange(url, HttpMethod.GET, apisEntity, ApiResponse.class);
			log.info("Inside restTemplate Call of getDashboardId method :{}", resultTagApi);
		} catch (RestClientException e) {
			log.error("Inside Catch Block of restTemplate of getDashboardId method:{}", e.getMessage());
			throw new ApiCallException("We Encountered an issue while trying to fetch the API " + e);
		}

		try {
			ApiResponse apiReq1 = resultTagApi.getBody();

			dmr.setApiDetails(apiReq1);
			dmr.setActionHistory(actionHistoryModels);

			DashboardExtension dashboardExtension = new DashboardExtension();
			if (dashboardEntity.getApiGateway() != null && !dashboardEntity.getApiGateway().isEmpty()) {
				if (dashboardEntity.getApiGateway().contains("|")) {
					String[] apiMgmtData = dashboardEntity.getApiGateway().split("\\|");
					List<String> apiMgmtlist = Arrays.asList(apiMgmtData);
					dashboardExtension.setApiMgmt(apiMgmtlist);
				} else {
					dashboardExtension.setApiMgmt(List.of(dashboardEntity.getApiGateway()));
				}
			}

			dashboardExtension.setCicd(dashboardEntity.getCicdPipeline());
			dashboardExtension.setRepository(dashboardEntity.getRepository());
			dashboardExtension.setStub(dashboardEntity.getStubMock());
			dashboardExtension.setTemplate(dashboardEntity.getTemplateType());
			dashboardExtension.setTest(dashboardEntity.getTestSuite());

			dmr.setExtension(dashboardExtension);
			dmr.setClientTrackingInfo(jiraService.fetchMainStoryKey("" + dashboardEntity.getApiId()));
			return new ResponseEntity<>(dmr, HttpStatus.OK);

		} catch (RecordNotFoundException e) {
			log.error("Inside catch block of getDashboardId:{}", e.getMessage());

			throw new RecordNotFoundException("No Record found for given ID");

		}

	}
