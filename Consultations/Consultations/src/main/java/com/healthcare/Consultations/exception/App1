package com.infy.api.cloud.repository;

import com.infy.api.cloud.entity.ApiResourceLinks;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface ApiResourceLinksRepository extends JpaRepository<ApiResourceLinks,Long> {

    @Query("""
            SELECT rl 
            FROM ApiResourceLinks rl
            WHERE rl.apiFamilyId = :apiFamilyId
            ORDER BY rl.categoryId ASC, rl.subcategoryId ASC, rl.linkId ASC
            """)
    List<ApiResourceLinks> findApiResourceLinksByApiFamilyId(@Param("apiFamilyId")Integer apiFamilyId);
}

