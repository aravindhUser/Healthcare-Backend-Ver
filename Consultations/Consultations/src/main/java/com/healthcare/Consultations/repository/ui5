table {
  width: 100%;
}
 
.mat-table {
  width: 100%;
  table-layout: fixed;
}
 
.table-header {
  color: #000000;
  font-size: 14px;
  font-weight: 600;
}
 
.mat-header-cell {
  padding: 12px 12px;
  line-height: 16px;
  text-align: center;
 

  word-break: keep-all;
  overflow-wrap: normal;
  white-space: normal;
}
 
.mat-cell {
  padding: 10px 12px !important;
  font-size: 14px;
  line-height: 18px !important;
 
  vertical-align: middle;
  box-sizing: border-box;
 
  white-space: normal;
  word-break: break-word;
}

.mat-row,
.mat-header-row {
  min-height: 52px;
}
 
.mat-cell *,
.mat-header-cell * {
  margin: 0 !important;
  padding: 0 !important;
  line-height: inherit;
}
 
.mat-column-apiDetails\.apiName {
  width: 23%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
 
.mat-column-apiDetails\.apiVersion {
  width: 4%;
  text-align: center;
  white-space: nowrap;
}

.mat-column-apiDetails\.apiGatewayName {
  width: 9%;
}

.mat-column-apiDetails\.basePath {
  width: 14%;
}

.mat-column-api\.clientTrackingInfo\.pinxt {
  width: 10%;
  text-align: center;
 
  white-space: normal !important;
  word-break: keep-all;
  overflow-wrap: break-word;
}
 
.mat-column-apiDetails\.requestedBy {
  width: 13%;
  text-align: left;
 
  white-space: normal !important;
  word-break: normal !important;
  overflow-wrap: anywhere;
}
 
.mat-column-actionBy {
  width: 13%;
  text-align: left;
 
  white-space: normal !important;
  word-break: normal !important;
  overflow-wrap: anywhere;
}
 
.mat-column-apiDetails\.requestedTimestamp {
  width: 8%;
  text-align: center;
 
  white-space: normal !important;
  word-break: keep-all;
}
 
.mat-column-actionTs {
  width: 9%;
  text-align: center;
 
  white-space: normal !important;
  word-break: keep-all;
}

.mat-column-status {
  width: 8%;
  text-align: center;
 
  white-space: nowrap !important;
  overflow: hidden;
  text-overflow: ellipsis;
}
 
.mat-column-action {
  width: 6%;
  text-align: center;
  white-space: nowrap;
}
 
 
.mat-column-apiDetails\.basePath .mat-header-cell {
  white-space: normal !important;
  line-height: 16px;
  text-align: center;
}
 
.mat-column-apiDetails\.basePath .mat-header-cell::first-line {
  white-space: nowrap;
}
 
.mat-column-apiDetails\.requestedBy .mat-header-cell {
  white-space: normal !important;
  line-height: 16px;
  text-align: center;
 
  word-break: keep-all !important;
  overflow-wrap: normal !important;
}
 
.mat-column-apiDetails\.requestedBy .mat-header-cell::first-line {
  white-space: nowrap;
}
 
 
.mat-column-actionTs .mat-header-cell {
  white-space: normal !important;
  line-height: 16px;
  text-align: center;
 
  word-break: keep-all !important;
  overflow-wrap: normal !important;
}

.mat-column-actionTs .mat-header-cell::first-line {
  white-space: nowrap;
}
 
 
.mat-menu-item {
  text-align: left;
  font: normal normal normal 14px;
  letter-spacing: 0px;
  color: #141414;
  opacity: 1;
  line-height: 16px;
  height: 30px;
  .reject_option {
    color: #c93b3b;
  }
 
  .pending_option {
    color: #D97800;
  }
}
 
 
.table-link {
  color: #004366;
  cursor: pointer;
}
 
