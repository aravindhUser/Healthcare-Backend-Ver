import { Component, Input, OnInit } from '@angular/core';
import { Router } from '@angular/router';
import { DashboardModes } from 'src/app/core/enum/DashboardModes.enum';
import { ApiService } from 'src/app/core/services/api/api.service';
import { DashboardStorage } from 'src/assets/constants/app.constants';

@Component({
  selector: 'app-dashboard-add-resources',
  templateUrl: './dashboard-add-resources.component.html',
  styleUrls: ['./dashboard-add-resources.component.scss']
})
export class DashboardAddResourcesComponent implements OnInit {
  @Input() mode: DashboardModes;
  DashboardModes = DashboardModes;
  categoriesList: any;
  validationErrors: boolean[] = [];
  urlErrors: { [key: string]: string } = {};
  selectedApiData: any;

  constructor(
    private router: Router,
    private apiService: ApiService
  ) {

  }

  ngOnInit(): void {
    this.clearStaleResourceData();
    this.getCategories();
  }

  getCategories() {
    this.apiService.getCategories().subscribe(
      (response) => {
        this.categoriesList = response;
        this.loadResourceLinks();
      });
  }

  loadResourceLinks() {
    if (!this.categoriesList) return;

    let resources = [];

    if (this.mode === DashboardModes.PUBLISH) {
      const savedResources = sessionStorage.getItem('apiResources');
      if (savedResources) {
        resources = JSON.parse(savedResources);
      }
    } else if (this.mode === DashboardModes.REVIEW || this.mode === DashboardModes.RESUBMIT) {
      const savedResources = sessionStorage.getItem('apiResources');
      if (savedResources) {
        resources = JSON.parse(savedResources);
      } else {
        this.selectedApiData = this.mode === DashboardModes.REVIEW
          ? JSON.parse(sessionStorage.getItem(DashboardStorage.selectedDashboardObjAdmin))
          : JSON.parse(sessionStorage.getItem(DashboardStorage.selectedDashboardObjProfile));
        resources = this.selectedApiData?.apiDetails?.apiResourceLinks || [];
      }
    }

    this.categoriesList.categories.forEach(category => {
      category.subcategories.forEach(sub => {
        const resource = resources.find(r =>
          r.categoryId === category.categoryId &&
          r.subcategoryId === sub.subcategoryId
        );
        if (resource) {
          sub.resourceLink = resource.url;
          sub.linkId = resource.linkId;
        }
      });
    });
  }

  back() {
    if (this.mode === DashboardModes.PUBLISH) {
      this.router.navigateByUrl('/publishapi/apiattachplugins');
    }
    if (this.mode === DashboardModes.REVIEW) {
      this.router.navigateByUrl('admin/viewapiplugins');
    }
    if (this.mode === DashboardModes.RESUBMIT) {
      this.router.navigateByUrl('resubmitapi/reattachplugin');
    }
  }

  validateUrl(url: string): string | null {
    if (!url || url.trim() === '') return null;

    // Must use HTTPS
    if (!url.startsWith('https://')) {
      return 'URL must use HTTPS protocol';
    }

    // Check for malformed protocol
    if (/^htt[^p]/.test(url) || /^https?:[^/]/.test(url)) {
      return 'Malformed protocol';
    }

    // Check for missing or excess slashes
    if (/^https:\/[^/]/.test(url) || /^https:\/{3,}/.test(url)) {
      return 'Invalid protocol format';
    }

    // Check for multiple protocols
    if (url.match(/https?:\/\//g)?.length > 1) {
      return 'Multiple protocols not allowed';
    }

    try {
      const urlObj = new URL(url);

      // Validate hostname - no underscores, spaces, or special chars
      if (!/^[a-zA-Z0-9.-]+$/.test(urlObj.hostname)) {
        return 'Invalid characters in hostname';
      }

      return null;
    } catch {
      return 'Invalid URL format';
    }
  }

  buildPayload() {
    const payload = [];

    this.categoriesList.categories.forEach(category => {
      category.subcategories.forEach(sub => {
        if (sub.resourceLink && sub.resourceLink.trim() !== '') {
          const item: any = {
            categoryId: category.categoryId,
            subcategoryId: sub.subcategoryId,
            url: sub.resourceLink
          };

          if (sub.linkId && (this.mode === DashboardModes.REVIEW || this.mode === DashboardModes.RESUBMIT)) {
            item.linkId = sub.linkId;
          }
          payload.push(item);
        }
      });
    });

    return payload;
  }

  next() {
    this.validationErrors = [];
    this.urlErrors = {};
    let isValid = true;

    this.categoriesList.categories.forEach((category, i) => {
      category.subcategories.forEach((sub, j) => {
        const key = `${i}-${j}`;
        if (sub.resourceLink && sub.resourceLink.trim() !== '') {
          const error = this.validateUrl(sub.resourceLink);
          if (error) {
            this.urlErrors[key] = error;
            isValid = false;
          }
        }
      });

      if (category.isMandatory) {
        const hasResourceLink = category.subcategories.some(sub => sub.resourceLink && sub.resourceLink.trim() !== '');
        if (!hasResourceLink) {
          this.validationErrors[i] = true;
          isValid = false;
        }
      }
    });

    if (!isValid) return;

    const payload = this.buildPayload();
    console.log('Resources Payload:', payload);
    sessionStorage.setItem('apiResources', JSON.stringify(payload));

    if (this.mode === DashboardModes.PUBLISH) {
      this.router.navigateByUrl('/publishapi/apisummary');
    }
    if (this.mode === DashboardModes.REVIEW) {
      this.router.navigateByUrl('/admin/viewapisummary');
    }
    if (this.mode === DashboardModes.RESUBMIT) {
      this.router.navigateByUrl('/resubmitapi/reapisummary');
    }
  }

  clearStaleResourceData() {
    const savedResources = sessionStorage.getItem('apiResources');

    if (savedResources && this.mode !== DashboardModes.PUBLISH) {
      const currentApiData = this.mode === DashboardModes.REVIEW
        ? JSON.parse(sessionStorage.getItem(DashboardStorage.selectedDashboardObjAdmin))
        : JSON.parse(sessionStorage.getItem(DashboardStorage.selectedDashboardObjProfile));

      const lastApiId = sessionStorage.getItem('lastResourceApiId');
      const currentApiId = currentApiData?.apiId || currentApiData?.apiDetails?.apiId;

      if (lastApiId && currentApiId && lastApiId !== String(currentApiId)) {
        sessionStorage.removeItem('apiResources');
      }

      if (currentApiId) {
        sessionStorage.setItem('lastResourceApiId', String(currentApiId));
      }
    }
  }

  resetResources() {
    if (confirm('Are you sure that you want to reset the resources?')) {
      sessionStorage.removeItem('apiResources');

      if (this.categoriesList) {
        this.categoriesList.categories.forEach(category => {
          category.subcategories.forEach(sub => {
            sub.resourceLink = '';
          });
        });
      }
    }
  }

}
