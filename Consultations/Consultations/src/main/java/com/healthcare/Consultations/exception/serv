    @Test
    void testGetApiResourceLinks_OrderedByCategory() throws JsonMappingException, JsonProcessingException {
        Long apiId = 1L;
        Integer apiFamilyId = 100;

        Optional<GetApiRequest> entity = Optional.of(createGetApiRequest(apiId, apiFamilyId, true));

        ApiResourceLinks link1 = createResourceLink(1L, apiFamilyId, 1, 1, "First Link",  "https://example.com/first");
        ApiResourceLinks link2 = createResourceLink(2L, apiFamilyId, 2, 1, "Second Link", "https://example.com/second");
        ApiResourceLinks link3 = createResourceLink(3L, apiFamilyId, 2, 2, "Third Link",  "https://example.com/third");

        List<ApiResourceLinks> resourceLinks = Arrays.asList(link1, link2, link3);

        lenient().when(apiRepository.getAllApiById(apiId)).thenReturn(entity);
        lenient().when(apiResourceLinksRepository.findApiResourceLinksByApiFamilyId(apiFamilyId))
                .thenReturn(resourceLinks);

        ApiResponse response = service.getEntityOpt(entity);

        assertNotNull(response);
        assertEquals(3, response.getApiResourceLinks().size());
        assertEquals(1, response.getApiResourceLinks().get(0).getCategoryId());
        assertEquals(2, response.getApiResourceLinks().get(1).getCategoryId());
    }

    @Test
    void testGetApiResourceLinks_RepositoryException() {
        Long apiId = 1L;
