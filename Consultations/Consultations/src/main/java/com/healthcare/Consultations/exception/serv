private GetApiRequestImpl createGetApiRequest(Long apiId, Integer apiFamilyId, boolean sbTarget) {
        GetApiRequestImpl req = new GetApiRequestImpl();
        req.setApiId(apiId);
        req.setApiFamilyId(apiFamilyId);
        req.setSbTarget(sbTarget);
        return req;
    }

    private ApiResourceLinks createResourceLink(Long linkId,
                                                Integer apiFamilyId,
                                                int categoryId,
                                                int subcategoryId,
                                                String title,
                                                String url) {
        ApiResourceLinks link = new ApiResourceLinks();
        link.setLinkId(linkId);
        link.setApiFamilyId(apiFamilyId);
        link.setCategoryId(categoryId);
        link.setSubcategoryId(subcategoryId);
        link.setTitle(title);
        link.setUrl(url);
        return link;
    }

    @Test
    void testGetApiResourceLinks_Success() throws JsonMappingException, JsonProcessingException {
        Long apiId = 1L;
        Integer apiFamilyId = 100;

        Optional<GetApiRequest> entity = Optional.of(createGetApiRequest(apiId, apiFamilyId, true));

        ApiResourceLinks link1 = createResourceLink(1L, apiFamilyId, 1, 1, "Documentation", "https://example.com/docs");
        ApiResourceLinks link2 = createResourceLink(2L, apiFamilyId, 1, 2, "API Reference", "https://example.com/reference");

        List<ApiResourceLinks> resourceLinks = Arrays.asList(link1, link2);

        lenient().when(apiRepository.getAllApiById(apiId)).thenReturn(entity);
        lenient().when(apiResourceLinksRepository.findApiResourceLinksByApiFamilyId(apiFamilyId))
                .thenReturn(resourceLinks);

        ApiResponse response = service.getEntityOpt(entity);


        assertNotNull(response);
        assertNotNull(response.getApiResourceLinks());
        assertEquals(2, response.getApiResourceLinks().size());
        assertEquals("Documentation", response.getApiResourceLinks().get(0).getTitle());
        assertEquals("https://example.com/docs", response.getApiResourceLinks().get(0).getUrl());
    }

