all-apis.component.html
-----------------------------------------------
<app-page-title
  [Title]="'APIs'"
  [BreadcrumbArray]="breadcrumbArray"
  [apiCategory]="apiCategory"
  [Component]="COMPONENT.ALLAPIS"
  [IsFilterRequired]="false"
></app-page-title>

<div class="container-fluid p-2 px-md-5">
  <div class="p-3 px-md-5 py-md-4 bg-white shadow-sm" style="margin-bottom: 10px;">
    <div class="row" style="padding: 8px;">
      <div class="col-6">
        <mat-form-field class="DSA_Wb_custom-form-field">
          <!-- Below code commented to implement PINXTSS-2871 -->
          <!-- <input [(ngModel)]="searchTerm" (keyup)="onKeyUp($event)" matInput placeholder="Search API catalog" mattooltipclass="DSA_tooltip" class="iconRight mat-tooltip-trigger DSA_headersearchInput"> -->
          <!-- Above code commented to implement PINXTSS-2871 -->
           <!-- Code for implementing PINXTSS-2871 start -->
           <input [(ngModel)]="searchTerm" (input)="onKeyUp($event)" matInput placeholder="Search API catalog" mattooltipclass="DSA_tooltip" class="iconRight mat-tooltip-trigger DSA_headersearchInput">
           <!-- Code for implementing PINXTSS-2871 end -->
        </mat-form-field>
      </div>
    </div>
  </div>

  <div class="p-3 px-md-5 py-md-4 bg-white shadow-sm">
    <div class="row px-4">
       <!-- <div class="col-1" style="padding-right: -10px;"> -->
      <p style="color: gray; font-size: 18px; margin-bottom: 10px;">Filter By:</p>
       <!-- </div> -->
      <div class="col-11">
        <div class="capsule-button" (click)="onDomainChange('All')" [ngClass]="{'active':changedCategory === 'All'}">View All</div>
        <div class="capsule-button" (click)="onDomainChange('Favorites')" [ngClass]="{'active':changedCategory === 'Favorites'}">Favorites</div>
        <div class="capsule-button domain-filter-chip"
             [ngClass]="{'active': changedCategory === 'Domain' && domainsApplied}">
          <span (click)="toggleDomainDropdown()"
                [matTooltip]="selectedDomains.length > 1 ? getDomainTooltip() : ''"
                matTooltipPosition="above">{{ getDomainChipLabel() }}</span>
          <span class="dropdown-arrow" (click)="toggleDomainDropdown()">&#9660;</span>
          <span class="close-btn" *ngIf="selectedDomains.length > 0" (click)="clearDomainFilter(); $event.stopPropagation()">&#215;</span>
          <div class="domain-dropdown" *ngIf="isDomainDropdownOpen" (click)="$event.stopPropagation()">
            <div class="dropdown-header">Select Domains</div>
            <div class="dropdown-content">
              <div *ngIf="loadingDomains" class="dropdown-msg">Loading domains...</div>
              <div *ngIf="domainLoadError" class="dropdown-msg error">{{ domainLoadError }}</div>
              <div *ngIf="!loadingDomains && !domainLoadError && domainOptions.length === 0" class="dropdown-msg">No domains available</div>
              <div class="domain-option" *ngFor="let domain of domainOptions" (click)="toggleDomainSelection(domain)">
                <input type="checkbox" [checked]="isDomainSelected(domain)" (click)="$event.stopPropagation(); toggleDomainSelection(domain)">
                <label (click)="$event.preventDefault()">{{ domain }}</label>
              </div>
            </div>
            <div class="dropdown-footer">
              <button class="clear-btn" (click)="clearDomainSelection()">Clear</button>
              <button class="apply-btn" (click)="applyDomainFilter()">Apply</button>
            </div>
          </div>
        </div>

  <div class="gateway-filter-chip">
 
  <div class="capsule-button"
       [ngClass]="{'active': selectedGateway}"
       (click)="toggleGatewayDropdown($event)">
 
    <!-- When NOT selected -->
    <ng-container *ngIf="!selectedGateway">
      Gateway
      <span class="dropdown-arrow">▼</span>
    </ng-container>
 
    <!-- When selected -->
    <ng-container *ngIf="selectedGateway">
      <span class="gateway-label">Gateway :</span>
      <span class="gateway-value">{{ selectedGateway }}</span>
      <span class="dropdown-arrow">▼</span>
      <span class="chip-close"
            (click)="removeGatewayChip(); $event.stopPropagation();">
        ×
      </span>
    </ng-container>
 
  </div>
 
      <!-- DROPDOWN -->
      <div *ngIf="isGatewayDropdownOpen" class="gateway-dropdown" (click)="$event.stopPropagation()">
 
        <div class="dropdown-header">Select Gateway</div>
 
        <div *ngIf="isGatewayLoading" class="dropdown-loading">
          Loading gateways...
        </div>
 
        <div *ngIf="gatewayLoadError" class="dropdown-error">
          Failed to load gateways
        </div>
 
        <div *ngIf="!isGatewayLoading && !gatewayLoadError">
 
          <div *ngFor="let gateway of gatewayOptions" class="radio-option">
            <!-- <label style="cursor: pointer; width:100%; display: flex; align-items: center; gap: 8px;"> -->
              <label>
            <input type="radio"
                   name="gateway"
                   [value]="gateway"
                   [(ngModel)]="tempSelectedGateway"> 
            <span>{{ gateway }}</span>
            </label>
          </div>
 
        </div>
 
        <div class="dropdown-actions">
          <button class="clear-btn" (click)="clearGatewaySelection()">Clear</button>
          <button class="apply-btn" (click)="applyGatewayFilter()">Apply</button>
        </div>
 
      </div>
    </div>

     </div>
    </div>
    <div class="p-3 px-md-5 py-md-4">
      <div *ngIf="hasError" class="alert alert-danger">{{ errorMessage }}</div>
      <div *ngIf="noRecords" class="alert alert-info">Your search query returned no results.</div>
      <table mat-table [dataSource]="dataSource" matSort *ngIf="!hasError && !noRecords">
        <caption style="display: none;">User Table</caption>
        <!-- Code to implement APIMC-4419 start -->
         <ng-container matColumnDef="favorite">
          <th id="favorite" mat-header-cell *matHeaderCellDef class="favorite-column" mat-sort-header="favorite" [disabled]="changedCategory === 'Favorites'">
            Favorite
          </th>
          <td mat-cell *matCellDef="let user" class="favorite-column">
            <svg class="favorite-star"
              [style.width]="'22px'"
              [style.height]="'22px'"
              [style.cursor]="'pointer'"
              [style.fill]="user.favorited ? '#FFD700' : '#ccc'"
              [style.opacity]="loadingStars.has(user.apiId) ? '0.5' : '1'"
              [style.pointer-events]="loadingStars.has(user.apiId) ? 'none' : 'auto'"
              [matTooltip]="user.favorited ? 'Remove from Favorites' : 'Add to Favorites'"
              matTooltipPosition="above"
              title=""
              (click)="toggleFavorite(user)">
            <use [attr.xlink:href]="user.favorited ? 'assets/images/star-rating.icons.svg#star-filled' : 'assets/images/star-rating.icons.svg#star-empty'"></use>
          </svg>
          </td>
        </ng-container>
        <!-- Code to implement APIMC-4419 end -->
        <ng-container matColumnDef="apiName">
          <th id="apiName" mat-header-cell *matHeaderCellDef class="" mat-sort-header>
            API Name
          </th>
          <td mat-cell *matCellDef="let user" class="">
            <a [routerLink]="['/apidescription', user.requestId]">
              {{ user.apiName }}</a>
           </td>

        </ng-container>
        <ng-container matColumnDef="apiDescription">
          <th id="apiDescription" mat-header-cell *matHeaderCellDef class="" mat-sort-header>Description</th>
          <td mat-cell *matCellDef="let user" class="">
            <span [matTooltip]="user.apiDescription" matTooltipPosition="above">
            {{ user.apiDescription.length >100? user.apiDescription.substring(0,50) + "..." :user.apiDescription }}
            </span>
          </td>
        </ng-container>
        <ng-container matColumnDef="apiVersion">
          <th id="apiVersion" mat-header-cell *matHeaderCellDef class="" mat-sort-header>Version</th>
          <td mat-cell *matCellDef="let user" class="">
            {{ user.apiVersion }}
          </td>
        </ng-container>
        <ng-container matColumnDef="clientBasePath">
          <th id="clientBasePath" mat-header-cell *matHeaderCellDef class="" mat-sort-header>Client Base Path</th>
          <td mat-cell *matCellDef="let user" class="">
            {{ user.clientBasePath }}
          </td>
        </ng-container>
        <ng-container matColumnDef="gatewayName">
          <th id="gatewayName" mat-header-cell *matHeaderCellDef class="" mat-sort-header>Domain</th>
          <td mat-cell *matCellDef="let user" class="">
            {{ user.gatewayName }}
          </td>
        </ng-container>
        <ng-container matColumnDef="lifeCycleStage">
          <th id="lifeCycleStage" mat-header-cell *matHeaderCellDef class="" mat-sort-header>Lifecycle Stage</th>
          <td mat-cell *matCellDef="let user" class="">
            {{ user.lifeCycleStage }}
          </td>
        </ng-container>
        <ng-container matColumnDef="tags">
          <th id="tags" mat-header-cell *matHeaderCellDef class="" mat-sort-header>Tags</th>
          <td mat-cell *matCellDef="let user" class="">
            {{ user.tags }}
          </td>
        </ng-container>

        <tr mat-header-row *matHeaderRowDef="displayedColumns" sticky></tr>
        <tr mat-row *matRowDef="let row; columns: displayedColumns" [hidden]="changedCategory === 'Favorites' && !row.favorited"></tr> <!--Added hidden attribute to implement APIMC-4545-->
      </table>
    </div>
    <mat-paginator
      [length]="totalItems"
      [pageSizeOptions]="[10, 20, 30]"
      [pageSize]="pageSize"
      showFirstLastButtons
      (page)="onPageChange($event)">
    ></mat-paginator>
  </div>
</div>

<app-loader></app-loader>

