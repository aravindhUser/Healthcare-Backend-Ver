  getSupportingLink(category: string, subCategory: string): string | null {
    if(!this.supportingResources || this.supportingResources.length === 0) {
      return null;
    }

    const resource = this.supportingResources.find(res => res.categoryName === category && res.subCategoryName === subCategory && res.resourceLink && res.resourceLink.trim().length > 0);
    return resource ? resource.resourceLink : null;
  }

