            <div class="col pl-0">
                <div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>Description</p>
                        </div>
                        <div class="col-8 field-value-text">
                            {{ dashboardData?.apiDescription }}
                        </div>
                    </div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>Version</p>
                        </div>
                        <div class="col-10 field-value-text">
                            {{ dashboardData?.apiVersion }}
                        </div>
                    </div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>Base Path</p>
                        </div>
                        <div class="col-10 field-value-text">
                            {{ dashboardData?.basePath }}
                        </div>
                    </div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <!-- Below code commented to implement PINXTSS-2594 -->
                            <!-- <p>Service Owner(s)</p> -->
                            <!-- Above code commented to implement PINXTSS-2594 -->
