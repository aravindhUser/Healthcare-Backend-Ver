                             <p>Producer Team</p><!--Changed API Owner(s) to Producer Team to implement PINXTSS-3234-->
                             <!-- Code to implement PINXTSS-2594 end -->
                        </div>
                        <div class="col-10 field-value-text">
                            {{ serviceOwners }}
                        </div>
                    </div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>Operation Team</p><!--Changed Operations to Operation Team to implement PINXTSS-3234-->
                        </div>
                        <div class="col-10 field-value-text">
                            {{ operations }}
                        </div>
                    </div>
                    <!-- Code to implement PINXTSS-2049 Start -->
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>API Modality</p>
                        </div>
                        <div class="col-10 field-value-text">
                            {{ dashboardData?.modality }}
                        </div>
                    </div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>Capacity (TPS)</p>
                        </div>
                        <div class="col-10 field-value-text">
                            {{ dashboardData?.capacity }}
                        </div>
                    </div>
                     <!-- New section for Deployment Environments -->
                     <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>Deployment Environments</p>
                        </div>
                        <div class="col-10 field-value-text">
                            <ng-container *ngFor="let env of dashboardData?.deployedEnvironments">
                                <span>{{ env }}</span><span *ngIf="!isLastElement(env, dashboardData?.deployedEnvironments)">, </span>
                            </ng-container>
                        </div>
                    </div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>Lifecycle Stage</p>
                        </div>
                        <div class="col-10 field-value-text">
                            {{ dashboardData?.lifeCycleStage }}
                        </div>
                    </div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>Lifecycle Comment</p>
                        </div>
                        <div class="col-10 field-value-text">
                            {{ dashboardData?.lifeCycleComment }}
                        </div>
                    </div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>CMDB APP ID:</p>
                        </div>
                        <div class="col-10 field-value-text">
                            {{ cmdbAppId }}
                        </div>
                    </div>
                    <div class="row p-1 pl-0">
                        <div class="col-2 pl-0 field-name">
                            <p>CMDB APP Ref IDs:</p>
                        </div>
                        <div class="col-10 field-value-text">
                            <div *ngFor="let id of targetMapping">
