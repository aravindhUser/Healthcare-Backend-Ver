  getTeamName(teamType:string,teamId):string{
    let teamName = '';
    if(teamType.toUpperCase() === 'PRODUCER'){
      const producerTeams = sessionStorage.getItem('producerTeams')?JSON.parse(sessionStorage.getItem('producerTeams')):[];      
      const producer = producerTeams.find(team=> Number(team.id) === Number(teamId));
      teamName = producer?.name;
    }
    if(teamType.toUpperCase() === 'OPERATIONS'){
      const operationsTeams = sessionStorage.getItem('operationsTeams')?JSON.parse(sessionStorage.getItem('operationsTeams')):[];
      const operations = operationsTeams.find(team=> Number(team.id) === Number(teamId));
      teamName = operations?.name;
    }
    console.log("Dashboard Data: ",this.dashboardData);
    return teamName;
  }
