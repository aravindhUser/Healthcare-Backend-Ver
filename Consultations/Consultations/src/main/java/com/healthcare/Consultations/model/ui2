  // Helper method to format error messages
  private formatErrorMessage(errorMessage: string): string {
    const maxLineLength = 80;
    let formattedMessage = '';
    let currentLine = '';

    errorMessage.split(' ').forEach(word => {
      if ((currentLine + word).length > maxLineLength) {
        formattedMessage += currentLine + '\n';
        currentLine = word + ' ';
      } else {
        currentLine += word + ' ';
      }
    });

    formattedMessage += currentLine.trim();
    return formattedMessage;
  }

  // Code for implementing PINXTSS-2183 Start
  private getErrorFromCode(errorCode) {
    let errorResponseMessage = '';
    switch (errorCode) {
      case 400:
        errorResponseMessage = 'Bad Request';
        break;
      case 401:
        errorResponseMessage = 'Unauthorized';
        break;
      case 403:
        errorResponseMessage = 'Forbidden';
        break;
      case 404:
        errorResponseMessage = 'Not Found';
        break;
      case 500:
        errorResponseMessage = 'Internal Server Error';
        break;
      case 502:
        errorResponseMessage = 'Bad Gateway';
        break;
      case 503:
        errorResponseMessage = 'Service Unavailable';
        break;
      default:
        errorResponseMessage = `Unexpected Error: ${errorCode}`;
    }
    return errorResponseMessage;
  }
