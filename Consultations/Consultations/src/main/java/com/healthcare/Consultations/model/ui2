                let jiraHtml = "<br/> PiNxt JIRA #: <a href= " + jiraData.link + " target='_blank' >" + jiraData.jiraTicket + "</a>";
                this.message = this.message + jiraHtml;
  
              } else {
                this.message += "<br> JIRA is not responsive. Please contact the PiNxt admins at DL-SE-PINXT-DEVELOPMENT@charter.com to get a tracking number."
              }
            }  

            this.redirection = '/profile';

            sessionStorage.removeItem(this.readSnapshot);
            localStorage.removeItem(DashboardStorage.swaggerEditorData);
            localStorage.removeItem(DashboardStorage.swaggerEditorUpdatedData);
            sessionStorage.removeItem('basePath');
            sessionStorage.removeItem(this.sessionStorageOverviewSnapshot);
            sessionStorage.removeItem('swaggerInfo');
            sessionStorage.removeItem('apiName');
            sessionStorage.removeItem('securityData');
            sessionStorage.removeItem('wsdlContent');
            sessionStorage.removeItem('gQLEndpoint');
            sessionStorage.removeItem('cpAttachedPlugins');
            sessionStorage.removeItem('spAttachedPlugins');
            sessionStorage.removeItem('overrides');
            sessionStorage.removeItem('targetBasePath');
            sessionStorage.removeItem('targetMapping');
            sessionStorage.removeItem('lifeCycleStage');
            sessionStorage.removeItem('lifeCycleComment');
            localStorage.removeItem('raml-content');
            sessionStorage.removeItem('overrideData');
            sessionStorage.removeItem('monitoringInfo');//Code for implementing PINXTSS-3722
            sessionStorage.removeItem('supportingResources');//Code for implementing PINXTSS-4430


            if (sessionStorage.getItem('specF') === 'RAML') {
              let ramlFileName = JSON.parse(localStorage.getItem('config.currentFile')).name;
              let fileContentName = 'localStorageFilePersistence./' + ramlFileName
              localStorage.removeItem(fileContentName);
              localStorage.removeItem('config.currentFile');
            }
            sessionStorage.removeItem('specF');
            this.openDialog();
          },
          error: (err) => {
            this.title = 'Failed';
            this.message = 'Submission failed. Please try again later.';
            this.redirection = '/profile';

            this.openDialog();
          }
        });
      })
