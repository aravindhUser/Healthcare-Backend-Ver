  getJiraRef(submissionServiceResp) {
    let clientTrackingInfo = submissionServiceResp['clientTrackingInfo'];
    if (!clientTrackingInfo) {
      return undefined;
    }
    let pinxt = clientTrackingInfo['pinxt'];
    if (!pinxt) {
      return undefined;
    }
    return {
      jiraTicket: pinxt,
      link: this.envService.getEnvConfig().jiraTicket + pinxt
    }
  }

