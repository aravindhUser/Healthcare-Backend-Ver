table {
  width: 100%;
}

.table-header{
  color: #000000;
  font-size: 14px;
  font-weight: 600;
}

.table-link{
  color:#004366;
  cursor: pointer;
}

//Vert-Menu
.mat-menu-item {
  text-align: left;
  font: normal normal normal 14px;
  letter-spacing: 0px;
  color: #141414;
  opacity: 1;
  line-height: 16px;
  height: 30px;
  .reject_option {
    color: #c93b3b;
  }

  .pending_option{
    color: #D97800;
  }
}

//--------------------------//
.mat-table {
  width: 100%;
  table-layout: fixed;
}

.mat-header-cell, .mat-cell {
  padding: 10px 12px;
  line-height: 18px;
  font-size: 14px;

  vertical-align: middle;
  box-sizing: border-box;

  white-space: normal;
  word-break: break-word;
}



.mat-row, .mat-header-row {
  height: 52px;
}

.mat-column-apiDetails\.apiVersion,
.mat-column-status {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mat-cell * , .mat-header-cell * {
  margin: 0;
  padding: 0;
  line-height: inherit;
}

/* API Name - primary column */
.mat-column-apiDetails\.apiName {
  width: 20%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
 
/* Version - small */
.mat-column-apiDetails\.apiVersion {
  width: 5%;
  text-align: center;
}
 
/* Gateway Name */
.mat-column-apiDetails\.apiGatewayName {
  width: 10%;
}
 
/* Client Base Path */
.mat-column-apiDetails\.basePath {
  width: 15%;
}
 
/* JIRA */
.mat-column-api\.clientTrackingInfo\.pinxt {
  width: 8%;
  text-align: center;
}
 
/* Submitted By */
.mat-column-apiDetails\.requestedBy {
  width: 13%;
  word-break: break-word;
}
 
/* Action By */
.mat-column-actionBy {
  width: 13%;
  word-break: break-word;
}
 
/* Date */
.mat-column-apiDetails\.requestedTimestamp {
  width: 9%;
}
 
/* Last Updated */
.mat-column-actionTs {
  width: 9%;
}
 
/* Status */
.mat-column-status {
  width: 7%;
  text-align: center;
}
 
/* Action column (menu) */
.mat-column-action {
  width: 5%;
  text-align: center;
}
 
