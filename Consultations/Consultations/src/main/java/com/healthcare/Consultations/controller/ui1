        .filter-label {
            font-size: 14px;
            color: #666;
            font-weight: 500;
        }

        .filter-btn {
            padding: 6px 16px;
            border: none;
            border-radius: 16px;
            background-color: #e0e0e0;
            color: #333;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: 400;
        }

        .filter-btn:hover {
            background-color: #d0d0d0;
        }

        .filter-btn.active {
            background-color: #333;
            color: white;
            font-weight: 500;
        }

        /* Active Filter Chips */
        .active-filter-chip {
