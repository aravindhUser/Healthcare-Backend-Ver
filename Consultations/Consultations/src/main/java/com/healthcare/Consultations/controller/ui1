            cursor: pointer;
            font-size: 16px;
            line-height: 1;
            opacity: 0.8;
            margin-left: 4px;
        }

        .filter-chip-close:hover {
            opacity: 1;
        }

        .active-filter-chip:hover {
            background-color: #4355c8;
        }

        /* Tooltip */
        .tooltip {
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translateX(-50%);
            margin-bottom: 8px;
            padding: 8px 12px;
            background-color: #333;
            color: white;
            font-size: 12px;
            border-radius: 4px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
            z-index: 1001;
            max-width: 300px;
            white-space: normal;
            display: none;
        }

        .tooltip::after {
            content: '';
