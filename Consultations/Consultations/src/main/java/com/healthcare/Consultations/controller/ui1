    <script>
        // State management
        let selectedDomains = [];
        let selectedGateway = null;
        let activeFilter = 'viewAll'; // 'viewAll', 'favorites', 'domain', or 'gateway'

        // DOM elements
        const domainFilterBtn = document.getElementById('domainFilterBtn');
        const domainDropdown = document.getElementById('domainDropdown');
        const domainFilterContent = document.getElementById('domainFilterContent');
        const domainTooltip = document.getElementById('domainTooltip');
        const chipClose = document.getElementById('chipClose');
        const applyBtn = document.getElementById('applyBtn');
        const clearBtn = document.getElementById('clearBtn');
        const checkboxes = domainDropdown.querySelectorAll('input[type="checkbox"]');
        
        const gatewayFilterBtn = document.getElementById('gatewayFilterBtn');
        const gatewayDropdown = document.getElementById('gatewayDropdown');
        const gatewayFilterContent = document.getElementById('gatewayFilterContent');
        const gatewayChipClose = document.getElementById('gatewayChipClose');
        const gatewayApplyBtn = document.getElementById('gatewayApplyBtn');
        const gatewayClearBtn = document.getElementById('gatewayClearBtn');
        const radioButtons = gatewayDropdown.querySelectorAll('input[type="radio"]');
        
        const clearAllFilters = document.getElementById('clearAllFilters');
        const viewAllBtn = document.getElementById('viewAllBtn');
        const favoritesBtn = document.getElementById('favoritesBtn');

        // Toggle domain dropdown
        domainFilterBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            
            if (e.target === chipClose) {
                clearDomainFilter();
                return;
            }
            
            const isOpening = !domainDropdown.classList.contains('show');
            
            if (isOpening) {
                checkboxes.forEach(cb => {
                    const label = cb.nextElementSibling.textContent;
                    cb.checked = selectedDomains.includes(label);
                });
                gatewayDropdown.classList.remove('show');
            }
            
            domainDropdown.classList.toggle('show');
        });

        // Toggle gateway dropdown
        gatewayFilterBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            
            if (e.target === gatewayChipClose) {
                clearGatewayFilter();
                return;
            }
            
            const isOpening = !gatewayDropdown.classList.contains('show');
            
            if (isOpening) {
                radioButtons.forEach(rb => {
                    rb.checked = (rb.nextElementSibling.textContent === selectedGateway);
                });
                domainDropdown.classList.remove('show');
            }
            
            gatewayDropdown.classList.toggle('show');
        });

        // Close dropdowns when clicking outside
        document.addEventListener('click', (e) => {
            if (!domainDropdown.contains(e.target) && e.target !== domainFilterBtn && !domainFilterBtn.contains(e.target)) {
                if (domainDropdown.classList.contains('show')) {
                    applyDomainSelection();
                }
                domainDropdown.classList.remove('show');
            }
            
            if (!gatewayDropdown.contains(e.target) && e.target !== gatewayFilterBtn && !gatewayFilterBtn.contains(e.target)) {
                if (gatewayDropdown.classList.contains('show')) {
                    applyGatewaySelection();
                }
                gatewayDropdown.classList.remove('show');
            }
        });

        // Prevent dropdowns from closing when clicking inside
        domainDropdown.addEventListener('click', (e) => {
            e.stopPropagation();
        });
        
        gatewayDropdown.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // Update domain button display
        function updateDomainButtonDisplay() {
            if (selectedDomains.length === 0) {
                domainFilterContent.innerHTML = 'Domain';
                domainFilterBtn.classList.remove('has-selection');
                chipClose.style.display = 'none';
                domainTooltip.style.display = 'none';
            } else if (selectedDomains.length === 1) {
                domainFilterContent.innerHTML = `
                    <span class="filter-chip-label">Domain</span>
                    <span class="filter-chip-separator">:</span>
                    <span class="filter-chip-value">${selectedDomains[0]}</span>
                `;
                domainFilterBtn.classList.add('has-selection');
                chipClose.style.display = 'inline';
                domainTooltip.style.display = 'none';
            } else {
                domainFilterContent.innerHTML = `
                    <span class="filter-chip-label">Domain</span>
                    <span class="filter-chip-separator">:</span>
                    <span class="filter-chip-value">${selectedDomains.length} selected</span>
                `;
                domainFilterBtn.classList.add('has-selection');
                chipClose.style.display = 'inline';
                domainTooltip.textContent = selectedDomains.join(', ');
                domainTooltip.style.display = 'block';
            }
            
            updateActiveFilterState();
        }

        // Update gateway button display
        function updateGatewayButtonDisplay() {
            if (!selectedGateway) {
                gatewayFilterContent.innerHTML = 'Gateway';
                gatewayFilterBtn.classList.remove('has-selection');
                gatewayChipClose.style.display = 'none';
            } else {
                gatewayFilterContent.innerHTML = `
                    <span class="filter-chip-label">Gateway</span>
                    <span class="filter-chip-separator">:</span>
                    <span class="filter-chip-value">${selectedGateway}</span>
                `;
                gatewayFilterBtn.classList.add('has-selection');
                gatewayChipClose.style.display = 'inline';
            }
            
            updateActiveFilterState();
        }

        // Update which filter button is active (mutually exclusive)
        function updateActiveFilterState() {
            viewAllBtn.classList.remove('active');
            favoritesBtn.classList.remove('active');
            
            const hasFilters = selectedDomains.length > 0 || selectedGateway;
            
            if (hasFilters) {
                // Domain and/or Gateway are active
                activeFilter = 'filtered';
                clearAllFilters.style.display = 'inline';
            } else if (activeFilter === 'favorites') {
                favoritesBtn.classList.add('active');
                clearAllFilters.style.display = 'none';
            } else {
                activeFilter = 'viewAll';
                viewAllBtn.classList.add('active');
                clearAllFilters.style.display = 'none';
            }
        }

        // Show tooltip on hover for multi-select
        domainFilterBtn.addEventListener('mouseenter', () => {
            if (selectedDomains.length > 1) {
                domainTooltip.style.opacity = '1';
            }
        });

        domainFilterBtn.addEventListener('mouseleave', () => {
            domainTooltip.style.opacity = '0';
        });

        // Apply domain selection
        function applyDomainSelection() {
            selectedDomains = Array.from(checkboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.nextElementSibling.textContent);
            
            updateDomainButtonDisplay();
            console.log('Applied domains:', selectedDomains);
        }

        // Apply gateway selection
        function applyGatewaySelection() {
            const selectedRadio = Array.from(radioButtons).find(rb => rb.checked);
            selectedGateway = selectedRadio ? selectedRadio.nextElementSibling.textContent : null;
            
            updateGatewayButtonDisplay();
            console.log('Applied gateway:', selectedGateway);
        }

        // Clear domain filter
        function clearDomainFilter() {
            selectedDomains = [];
            checkboxes.forEach(cb => cb.checked = false);
            updateDomainButtonDisplay();
        }

        // Clear gateway filter
        function clearGatewayFilter() {
            selectedGateway = null;
            radioButtons.forEach(rb => rb.checked = false);
            updateGatewayButtonDisplay();
        }

        // Domain Apply button
        applyBtn.addEventListener('click', () => {
            applyDomainSelection();
            domainDropdown.classList.remove('show');
        });

        // Domain Clear button
        clearBtn.addEventListener('click', () => {
            checkboxes.forEach(cb => cb.checked = false);
        });

        // Gateway Apply button
        gatewayApplyBtn.addEventListener('click', () => {
            applyGatewaySelection();
            gatewayDropdown.classList.remove('show');
        });

        // Gateway Clear button
        gatewayClearBtn.addEventListener('click', () => {
            radioButtons.forEach(rb => rb.checked = false);
        });

        // Clear all filters
        clearAllFilters.addEventListener('click', (e) => {
            e.preventDefault();
            clearDomainFilter();
            clearGatewayFilter();
            activeFilter = 'viewAll';
            updateActiveFilterState();
        });

        // Close buttons on chips
        chipClose.addEventListener('click', (e) => {
            e.stopPropagation();
            clearDomainFilter();
            activeFilter = 'viewAll';
            updateActiveFilterState();
        });

        gatewayChipClose.addEventListener('click', (e) => {
            e.stopPropagation();
            clearGatewayFilter();
            activeFilter = 'viewAll';
            updateActiveFilterState();
        });

        // View All button
        viewAllBtn.addEventListener('click', () => {
            if (activeFilter !== 'viewAll') {
                clearDomainFilter();
                clearGatewayFilter();
                activeFilter = 'viewAll';
                updateActiveFilterState();
            }
        });

        // Favorites button
        favoritesBtn.addEventListener('click', () => {
            if (activeFilter !== 'favorites') {
                clearDomainFilter();
                clearGatewayFilter();
                activeFilter = 'favorites';
                updateActiveFilterState();
            }
        });

        // Favorite toggle in table
        document.querySelectorAll('.favorite-icon').forEach(icon => {
            icon.addEventListener('click', () => {
                icon.classList.toggle('active');
                icon.textContent = icon.classList.contains('active') ? '★' : '☆';
            });
        });

        // Demo scenarios
        function showScenario(scenario) {
            clearDomainFilter();
            clearGatewayFilter();
            
            switch(scenario) {
                case 'single-domain':
                    document.getElementById('domain1').checked = true;
                    applyDomainSelection();
                    break;
                case 'multiple-domain':
                    document.getElementById('domain1').checked = true;
                    document.getElementById('domain2').checked = true;
                    document.getElementById('domain10').checked = true;
                    applyDomainSelection();
                    break;
                case 'gateway':
                    document.getElementById('gateway2').checked = true;
                    applyGatewaySelection();
                    break;
                case 'both':
                    document.getElementById('domain1').checked = true;
                    document.getElementById('domain10').checked = true;
                    applyDomainSelection();
                    document.getElementById('gateway7').checked = true;
                    applyGatewaySelection();
                    break;
            }
        }

        // Initialize
        updateActiveFilterState();

        // Console helpers
        console.log('Demo scenarios:');
        console.log('- showScenario("single-domain") - Single domain');
        console.log('- showScenario("multiple-domain") - 3 domains');
        console.log('- showScenario("gateway") - Gateway selection');
        console.log('- showScenario("both") - Domain + Gateway together');
        
        // Auto-demo: Show both filters active
        setTimeout(() => showScenario('both'), 1000);
    </script>
</body>
</html>
