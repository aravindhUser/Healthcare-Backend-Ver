package com.infy.api.cloud.repository;

import com.infy.api.cloud.entity.ApiResourceLink;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Modifying;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import java.util.List;

@Repository
public interface ApiResourceLinkRepository extends JpaRepository<ApiResourceLink, Long> {

    List<ApiResourceLink> findByApiFamilyId(Long apiFamilyId);

    @Modifying
    @Query("DELETE FROM ApiResourceLink a WHERE a.apiFamilyId = :apiFamilyId")
    void deleteAllByApiFamilyId(@Param("apiFamilyId") Long apiFamilyId);

    @Query(value = """
    SELECT COUNT(*) 
    FROM UNNEST(CAST(:categoryIds AS INTEGER[]), CAST(:subcategoryIds AS INTEGER[])) 
        AS t(category_id, subcategory_id)
    WHERE EXISTS (
        SELECT 1 
        FROM apicloud.api_resource_categories c
        INNER JOIN apicloud.api_resource_subcategories s 
            ON c.category_id = s.category_id
        WHERE c.category_id = t.category_id 
            AND s.subcategory_id = t.subcategory_id
    )
    """, nativeQuery = true)
    int countValidCategorySubcategoryPairs(
            @Param("categoryIds") Integer[] categoryIds,
            @Param("subcategoryIds") Integer[] subcategoryIds
    );

}
