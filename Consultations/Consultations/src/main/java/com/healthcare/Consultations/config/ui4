  if(gateways) {
    console.log("returning gateways from ss", gateways);
    return new Observable(observer => {
      observer.next(JSON.parse(gateways))
      observer.complete();
    })
    
  } 
    let resp =  this.http.get(`${this._gatewayURL}`);
    return resp.pipe(map(
      (data: Gateway[]) => {
        console.log('gateways data from service', data);
