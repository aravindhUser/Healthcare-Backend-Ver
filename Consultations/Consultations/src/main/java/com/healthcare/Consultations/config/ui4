    // let url = `${this._apiURL}/availabilityCheck?apiName=${apiName}`+ `&apiVersion=${apiVersion}` + `&basePath=${basePath}`+ `&status=${statusForAPINameAndBasePathAvailability}`
    let url = `${this._apiURL}/availabilityCheck?apiName=${apiName}`+ `&apiVersion=${apiVersion}` + `&basePath=${basePath}`+ `&status=${statusForAPINameAndBasePathAvailability}`+ `&gatewayId=${gatewayId}`;//Code for implementing PINXTSS-2469
