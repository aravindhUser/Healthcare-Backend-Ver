  postAPIRating(payload: {
    apiId: number;
    username: string;
    rating: number;
  }): Promise<IApiAvgRating> {
    const body = {
      apiId: payload.apiId,
      ratingBy: payload.username,
      rating: payload.rating,
    };
    return this.http
      .put<IApiAvgRating>(`${this._apiURL}/${payload.apiId}/rating`, body)
      .toPromise();
  }

  getAPIFeedbacks(apiId: number): Observable<IFeedback[]> {
    return this.http.get<IFeedback[]>(`${this._apiURL}/${apiId}/feedback`);
  }

  postFeedback(payload: { apiId: number; username: string; feedback: string }) {
    let body = {
      apiId: payload.apiId,
      feedbackBy: payload.username,
      feedbackTxt: payload.feedback,
    };
    return this.http
      .post(`${this._apiURL}/${payload.apiId}/feedback`, body)
      .toPromise();
  }

  downloadSDK(link: string) {
    return this.http.get(link, {
      observe: 'response',
      responseType: 'blob' as 'json',
    });
  }
  editAPI(api) {
    return this.http.patch(`${this._apiURL}/${api.apiId}?isSimpleEdit=true`, api);
  }

