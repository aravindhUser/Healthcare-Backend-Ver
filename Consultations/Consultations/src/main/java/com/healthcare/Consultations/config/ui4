    checkServiceAvailability(apiName: string, apiVersion:string, basePath:string, statusForAPINameAndBasePathAvailability:string, apiId?:number,gatewayId?:number, apiFamilyId?:number) {//Code implemented for PINXTSS-2469. Added additional parameter apiFamilyId to implement PINXTSS-3029.
