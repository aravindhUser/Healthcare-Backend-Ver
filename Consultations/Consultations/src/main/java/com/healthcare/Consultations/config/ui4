  getApisOnDomainChange(domain: string, query: string, pageNum: number, pageSize: number): Observable<any> {
    console.log(query);
  
    const mustNot = {
      clientAccessType: "private"
    };
    const mustNotEncoded = encodeURIComponent(JSON.stringify(mustNot));
    
    let must;
    
    if(domain === "" && query === "") {
      must = {
        isLatest: true
      };
     
    } else if (domain !== "" && query !== "") {
      if(domain === 'Favorites'){
          must = {
            favoritesOnly: true,
            query: query,
            isLatest: true
         };
      }else{
          must = {
            gatewayName: domain,
            query: query,
            isLatest: true
         };
      }
     
    
    } else if (domain === "") {
     must = {
        query: query,
        isLatest: true
      };
     
    } else if (query === "") {
      if(domain === 'Favorites'){
          must = {
            favoritesOnly: true,
            isLatest: true
         };
        }else{
            must = {
          gatewayName: domain,
          isLatest: true
        };
        }
    }
  
    const paginationParams = `&pageNum=${pageNum}&pageSize=${pageSize}`;
    console.log("must", must, "mustNot", mustNot, "paginationparams", paginationParams)
    let mustEncoded = encodeURIComponent(JSON.stringify(must));
    console.log(`${this._documentsURL}?must=${mustEncoded}&mustNot=${mustNotEncoded}${paginationParams}`);
    
      return this.http.get<any>(`${this._documentsURL}?must=${mustEncoded}&mustNot=${mustNotEncoded}${paginationParams}`);
    
  }
