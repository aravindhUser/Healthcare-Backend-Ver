    // if(typeof apiId !== 'undefined') {
    //   url += `&apiId=${apiId}`
    // }
    // Above code commented to implement PINXTSS-3029
    // Code for implementing PINXTSS-3029 start
    if(typeof apiId !== 'undefined') {
      if(sessionStorage.getItem('resubmitFlowInitiatedBy')!=="ADD_VERSION_FLOW")
        url += `&apiId=${apiId}`
    }
    // alert(apiFamilyId);
    if(apiFamilyId!==undefined && apiFamilyId !== null){
      url += `&apiFamilyId=${apiFamilyId}`;
    }
    // Code for implementing PINXTSS-3029 end
    return this.http.get(url);
  }


  checkBasePath(basePath: string,statusForBasePathAvailability:string) {
    return this.http.get(`${this._apiURL}/availabilityCheck?basePath=${basePath}`+ `&status=${statusForBasePathAvailability}`);
  }

  getAllAPIByProductOwner(userId: string) {
    return this.http.get<IApi[]>(`${this._apiURL}?poUserId=${userId}`);
