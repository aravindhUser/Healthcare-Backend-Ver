	@Autowired
	private EntityManagerFactory entityManagerFactory;

	@SuppressWarnings("unchecked")
	public List<ApiResMod> getApis(Long productId, Boolean status, Boolean trending, String apiName, String poUserId, String category, Long limit)
			throws Exception {

		EntityManager session = entityManagerFactory.createEntityManager();

		try {
			String subQuery1ForCat = "SELECT * FROM (";
			String subQuery2ForCat = "   , COUNT (AR.RATING) + COUNT(AF.FEEDBACK_TXT) AS reviewCount \n";
			String selectClause = """
				SELECT  
					A.API_ID AS apiId,
					A.API_NM AS apiName,
					A.API_DESC AS apiDescription,
					A.VERSION AS apiVersion,
					A.PRODUCT_ID AS productId,
					P.PRODUCT_NM AS productName,
					A.REQUESTED_BY AS requestedBy,
					A.STATUS AS status,
					A.TRENDING AS trending,
					A.TAGS AS tags,
					ROUND(AVG(AR.RATING),0) AS rating,
					COUNT(AR.RATING_ID) as ratingcount,
					COUNT(AF.FEEDBACK_ID) as feedbackcount,				
					AD.REQUEST_ID as requestId
				""";


			String fromClause = """
					FROM
						APICLOUD.APIS A
						INNER JOIN APICLOUD.PRODUCTS P ON A.PRODUCT_ID = P.PRODUCT_ID
						LEFT OUTER JOIN APICLOUD.API_RATINGS AR ON A.API_ID = AR.API_ID
						LEFT OUTER JOIN APICLOUD.API_FEEDBACK AF ON A.API_ID = AF.API_ID
						INNER JOIN APICLOUD.ADMIN_DASHBOARD AD ON A.API_ID = AD.API_ID
					""";
//					+ "\tLEFT OUTER JOIN APICLOUD.PLANS PL ON P.DEFAULT_PLAN_ID = PL.PLAN_ID\n";

			String whereClause = "Where ";
			if (status != null) {

				whereClause = whereClause.concat("A.STATUS= " + status);

			}

			if (apiName != null) {
				if ("Where ".equalsIgnoreCase(whereClause)) {
					whereClause = whereClause.concat("A.API_NM= '" + apiName + "'");
				} else {
					whereClause = whereClause.concat(" AND A.API_NM= '" + apiName + "'");
				}
			}

			if (trending != null) {
				if ("Where ".equalsIgnoreCase(whereClause)) {
					whereClause = whereClause.concat("A.TRENDING= " + trending);
				} else {
					whereClause = whereClause.concat(" AND A.TRENDING= " + trending);
				}
			}

			if (poUserId != null) {
				if ("Where ".equalsIgnoreCase(whereClause)) {
					whereClause = whereClause.concat("P.PRODUCT_OWNER = '" + poUserId + "'");
				} else {
					whereClause = whereClause.concat(" AND P.PRODUCT_OWNER = '" + poUserId + "'");
				}
			}

			if (productId != null) {
				if ("Where ".equalsIgnoreCase(whereClause)) {
					whereClause = whereClause.concat("A.PRODUCT_ID= " + productId);
				} else {
					whereClause = whereClause.concat(" AND A.PRODUCT_ID= " + productId);
				}
			}

			if ("Where ".equalsIgnoreCase(whereClause)) {
				whereClause = "";
			}


			String groupByClause = """
					GROUP BY
					A.API_ID,
					A.API_NM,
					A.API_DESC,
					 A.VERSION,
					A.PRODUCT_ID,
					P.PRODUCT_NM,
					A.REQUESTED_BY,
					A.STATUS,
					A.TRENDING,
					P.PRODUCT_NM,
					AD.REQUEST_ID 
				""";
//					+ "\tP.DEFAULT_PLAN_ID ,\n"
//					+ "\tA.SB_SSL,\n"
//					+ "\tA.SB_TARGET,\n"
//					+ "\tA.CONSUMER_TYPE,\n"
//					+ "\tA.SPEC_TYPE , \n"
//					+ "\tA.SB_SPEC_TYPE , \n"
//					+ "\tA.SB_SPEC_PATH , \n"
//					+ "\tA.NB_AUTH_URL,\n"
//					+ "\tA.NB_TOKEN_URL , \n"
//					+ "\tA.NB_REFRESH_URL , \n"
//					+ "\tA.NB_AUTH_SCOPES, \n"
//					+ "\tA.SB_AUTH_URL , \n"
//					+ "\tA.SB_TOKEN_URL, \n"
//					+ "\tA.SB_REFRESH_URL , \n"
//					+ "\tA.SB_AUTH_SCOPES,\n"
//					+ "\tA.SB_ROUTING_LOCATION, \n"
//					+ "\tA.SB_ROUTING_FIELD, \n"
//					+ "\tA.SB_ROUTING_PATH, \n"
//					+ "\tA.PAYLOAD_SIZE_LIMIT , \n"
//					+ "\tA.PAYLOAD_SIZE_UNIT ,\n"
//					+ "\tA.BASE_PATH ,\n"
//					+ "\tA.NB_AUTH_LOCATION ,\n"
//					+ "\tA.NB_AUTH_FIELD ,\n"
//					+ "\tA.NB_AUTH_PATH ,\n"
//					+ "\tA.SB_AUTH_LOCATION, \n"
//					+ "\tA.SB_AUTH_FIELD ,\n"
//					+ "\tA.SB_AUTH_PATH, \n"
//					+ "\tA.RESPONSE_CACHE, \n"
//					+ "\tA.SB_TARGET_TYPE, \n"
//			        + "\tA.ALTERNATE_NM \n";
			
			
			String orderByClause = "";
			if (category == null) {

				orderByClause = """
							ORDER BY
						A.PRODUCT_ID,
						A.SEQ_NUMBER
						""";
			} else if (category.contains("newlyAdded")) {

				orderByClause = """
						 	 ORDER BY
						    A.UPDATED_TS DESC
						""";
			} else if (category.contains("mostReviewed")) {

				selectClause = subQuery1ForCat.concat(selectClause).concat(subQuery2ForCat);

				orderByClause = """
			            	 ORDER BY
			                reviewCount DESC) T WHERE reviewCount > 0 
			            """;
			}
			String limitClause = " LIMIT " + limit;

			String query = "";
			if (limit != null) {
				query = selectClause + fromClause + whereClause + groupByClause + orderByClause + limitClause;
			} else {
				query = selectClause + fromClause + whereClause + groupByClause + orderByClause;
			}


			Query value = session.createNativeQuery(query);
			//System.out.println("jedis--" + jedis.get(0).getApiName());
			return getResultList(value);

		} finally {
			if (session.isOpen()) {
				session.close();
			}
		}

	}


