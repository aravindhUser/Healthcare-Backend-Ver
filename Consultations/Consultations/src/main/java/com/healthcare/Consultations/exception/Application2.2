package com.infy.api.cloud.repository;

import java.util.List;
import java.util.Map;
import java.util.Optional;
import java.util.stream.Stream;

import com.infy.api.cloud.model.APIDocument;
import com.infy.api.cloud.model.APIDocumentProjection;

import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import com.infy.api.cloud.entity.Apis;
import com.infy.api.cloud.model.GetApiRequest;
import com.infy.api.cloud.model.GetAvailability;
import com.infy.api.cloud.model.LightweightApiResp;

import jakarta.transaction.Transactional;

@Repository
@Transactional
public interface ApiRepository extends JpaRepository<Apis, Long> {

	Optional<Apis> findByApiIdAndApiFamilyId(Long apiId, Integer apiFamilyId);//Code for implementing PINXTSS-2705


	@Query(value = """
			SELECT A.API_ID                              AS apiId,
				   A.TEAM_ID 							 AS teamId,
				   A.CAPACITY							 AS capacity,
				   A.API_NM                              AS apiName,
				   A.API_DESC                            AS apiDescription,
				   A.VERSION                             AS apiVersion,
				   A.ADDL_INFO                           AS apiAdditionalInfo,
				   A.PRODUCT_ID                          AS productId,
				   P.PRODUCT_NM                          AS productName,
				   P.DEFAULT_PLAN_ID                     AS defaultPlanId,
				   PL.PLAN_NM                            AS defaultPlanName,
				   A.REQUESTED_BY                        AS requestedBy,
				   A.UPDATED_TS                          AS requestedTimestamp,
				   A.STATUS                              AS status,
				   A.TRENDING                            AS trending,
				   A.SEQ_NUMBER                          AS seqNumber,
				   A.SPEC_PATH                           AS specPath,
				   A.NB_SECURITY                         AS nbSecurity,
				   A.NB_SECURITY_TYPE                    AS nbSecurityType,
				   A.NB_CORS                             AS nbCORS,
				   A.NB_CSRF                             AS nbCSRF,
				   A.NB_XSS                              AS nbXSS,
				   A.TAGS                                AS tags,
				   A.SB_SECURITY                         AS sbSecurity,
				   A.SB_SECURITY_TYPE                    AS sbSecurityType,
				   A.SB_SSL                              AS sbSSL,
				   A.SB_TARGET                           AS sbTarget,
				   A.SB_TARGET_TYPE                      AS sbTargetType,
				   A.API_QUOTA_LIMIT                     AS apiQuotaLimit,
				   A.APP_QUOTA_LIMIT                     AS appQuotaLimit,
				   A.APP_QUOTA_INTERVAL                  AS appQuotaInterval,
				   A.API_QUOTA_INTERVAL                  AS apiQuotaInterval,
				   A.CONSUMER_TYPE                       AS consumerType,
				   A.SPEC_TYPE                           AS specType,
				   A.SB_SPEC_TYPE                        AS sbSpecType,
				   A.SB_SPEC_PATH                        AS sbSpecPath,
				   A.NB_AUTH_URL                         AS nbAuthUrl,
				   A.NB_TOKEN_URL                        AS nbTokenUrl,
				   A.NB_REFRESH_URL                      AS nbRefreshUrl,
				   A.NB_AUTH_SCOPES                      AS nbAuthScopes,
				   A.SB_AUTH_URL                         AS sbAuthUrl,
				   A.SB_TOKEN_URL                        AS sbTokenUrl,
				   A.SB_REFRESH_URL                      AS sbRefreshUrl,
				   A.SB_AUTH_SCOPES                      AS sbAuthScopes,
				   A.SB_ROUTING_LOCATION                 AS sbRoutingLocation,
				   A.SB_ROUTING_FIELD                    AS sbRoutingField,
				   A.SB_ROUTING_PATH                     AS sbRoutingPath,
				   A.PAYLOAD_SIZE_LIMIT                  AS payloadSizeLimit,
				   A.PAYLOAD_SIZE_UNIT                   AS payloadSizeUnit,
				   A.BASE_PATH                           AS basePath,
				   A.NB_AUTH_LOCATION                    AS nbAuthLocation,
				   A.NB_AUTH_FIELD                       AS nbAuthField,
				   A.NB_AUTH_PATH                        AS nbAuthPath,
				   A.SB_AUTH_LOCATION                    AS sbAuthLocation,
				   A.SB_AUTH_FIELD                       AS sbAuthField,
				   A.SB_AUTH_PATH                        AS sbAuthPath,
				   A.RESPONSE_CACHE                      AS responseCache,
				   A.TARGET_BASE_PATH                    AS targetBasePath,
				   A.ALTERNATE_NM                        AS alternateName,
				   A.ADDITIONAL_PLUGIN_REQUIREMENTS      AS additionalPluginRequirements,
				   COALESCE(ROUND(AVG(AR.RATING), 1), 0) AS avgRating,
				   COUNT(AR.RATING)                      AS ratingCount,
				   COUNT(AF.FEEDBACK_TXT)                AS feedbackCount,
				   A.MODALITY							 AS modality,
				   A.DEPLOYED_ENVS						 AS deployedEnvironments,
				   A.LIFECYCLE_STAGE					 AS lifeCycleStage,
				   A.LIFECYCLE_COMMENT					 AS lifeCycleComment,
				   A.API_FAMILY_ID						 AS apiFamilyId,
				   A.IS_LATEST							 AS isLatest
			FROM APICLOUD.APIS A
					 INNER JOIN APICLOUD.PRODUCTS P ON A.PRODUCT_ID = P.PRODUCT_ID
					 LEFT OUTER JOIN APICLOUD.API_RATINGS AR ON A.API_ID = AR.API_ID
					 LEFT OUTER JOIN APICLOUD.API_FEEDBACK AF ON A.API_ID = AF.API_ID
					 LEFT OUTER JOIN APICLOUD.PLANS PL ON P.DEFAULT_PLAN_ID = PL.PLAN_ID
			WHERE A.API_ID = :id
			GROUP BY A.API_ID,
					 A.API_NM,
					 A.API_DESC,
					 A.VERSION,
					 A.ADDL_INFO,
					 A.PRODUCT_ID,
					 P.PRODUCT_NM,
					 A.REQUESTED_BY,
					 A.UPDATED_TS,
					 A.STATUS,
					 A.TRENDING,
					 A.SEQ_NUMBER,
					 A.SPEC_PATH,
					 A.NB_SECURITY,
					 A.NB_SECURITY_TYPE,
					 A.NB_CORS,
					 A.NB_CSRF,
					 A.NB_XSS,
					 A.SB_SECURITY,
					 A.SB_SECURITY_TYPE,
					 PL.PLAN_NM,
					 P.PRODUCT_NM,
					 P.DEFAULT_PLAN_ID,
					 A.SB_SSL,
					 A.SB_TARGET,
					 A.CONSUMER_TYPE,
					 A.SPEC_TYPE,
					 A.SB_SPEC_TYPE,
					 A.SB_SPEC_PATH,
					 A.NB_AUTH_URL,
					 A.NB_TOKEN_URL,
					 A.NB_REFRESH_URL,
					 A.NB_AUTH_SCOPES,
					 A.SB_AUTH_URL,
					 A.SB_TOKEN_URL,
					 A.SB_REFRESH_URL,
					 A.SB_AUTH_SCOPES,
					 A.SB_ROUTING_LOCATION,
					 A.SB_ROUTING_FIELD,
					 A.SB_ROUTING_PATH,
					 A.PAYLOAD_SIZE_LIMIT,
					 A.PAYLOAD_SIZE_UNIT,
					 A.BASE_PATH,
					 A.NB_AUTH_LOCATION,
					 A.NB_AUTH_FIELD,
					 A.NB_AUTH_PATH,
					 A.SB_AUTH_LOCATION,
					 A.SB_AUTH_FIELD,
