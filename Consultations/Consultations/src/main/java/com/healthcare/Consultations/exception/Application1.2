        logger.info("Inside bulkSyncOfApisToOpenSearch");

        List<APIDocumentProjection> apis = apiRepository.getApis(STATUS, APPROVED);

        if (apis == null || apis.isEmpty()) {
            logger.warn("No APIs found to sync.");
            return ResponseEntity.ok(new BulkDocumentActionResponse());
        }

        List<APIDocument> apisList = apis.stream()
                .map(projection -> modelMapper.map(projection, APIDocument.class))
                .collect(Collectors.toList());

        logger.info("Apis count from postgres :{}", apisList.size());
        HttpHeaders headers = new HttpHeaders();
        List<Long> deleteDocumentIds = fetchDeleteDocumentIds(headers, apisList);
        List<APIDocument> upsertDocuments = prepareUpsertDocuments(apisList);

        logger.info("Delete document IDs: {}", deleteDocumentIds);
        logger.info("Upsert document IDs: {}", upsertDocuments);

        return syncDocuments(headers, deleteDocumentIds, upsertDocuments);
    }


    public ResponseEntity<BulkDocumentActionResponse> bulkSyncOfApisToOpenSearch(BulkSyncOnDemandRequest bulkSyncOnDemandRequest,
                                                                                 String xTraceId) {
        logger.info("Inside bulkSyncOfApisToOpenSearch with request : {}", bulkSyncOnDemandRequest);

        List<Long> toBeUpsertedApiIds = bulkSyncOnDemandRequest.getToBeUpsertedApiIds();
        List<Long> toBeDeletedApiIds = bulkSyncOnDemandRequest.getToBeDeletedApiIds();

        boolean hasUpserts = toBeUpsertedApiIds != null && !toBeUpsertedApiIds.isEmpty();
        boolean hasDeletes = toBeDeletedApiIds != null && !toBeDeletedApiIds.isEmpty();

        if (!hasUpserts && !hasDeletes) {
            logger.warn("Nothing to upsert or delete, skipping sync.");
            return new ResponseEntity<>(HttpStatus.BAD_REQUEST);
        }

        List<APIDocument> upsertDocuments = new ArrayList<>();
        if (hasUpserts) {
            List<APIDocumentProjection> apis = apiRepository.getDetailsForApis(STATUS, APPROVED, toBeUpsertedApiIds);

            if (apis == null || apis.isEmpty()) {
                logger.warn("No APIs data found from DB to upsert.");
            } else {
                upsertDocuments = prepareUpsertDocuments(
                        apis.stream().map(projection -> modelMapper.map(projection, APIDocument.class))
                                .collect(Collectors.toList()));
            }
        }

        List<Long> deleteDocumentIds = hasDeletes ? toBeDeletedApiIds : Collections.emptyList();

        if ((upsertDocuments == null || upsertDocuments.isEmpty())
                && (deleteDocumentIds == null || deleteDocumentIds.isEmpty())) {
            logger.warn("Both upsert and delete documents are empty after processing, skipping sync.");
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "No valid documents found to sync in OpenSearch.");
        }

        logger.info("Delete document IDs: {}", deleteDocumentIds);
        logger.info("Upsert document IDs: {}", upsertDocuments);

        HttpHeaders headers = new HttpHeaders();
        return syncDocuments(headers, deleteDocumentIds, upsertDocuments);

    }

    public ResponseEntity<BulkDocumentActionResponse> syncDocuments(HttpHeaders headers, List<Long> deleteDocumentIds,
                                                                    List<APIDocument> upsertDocuments) {
        logger.info("Inside syncDocuments method");
        BulkDocumentActionRequest request = createBulkDocumentActionRequest(deleteDocumentIds, upsertDocuments);
        String uri = openSearchServicePath + "/documents/bulksync";
        try {
            ResponseEntity<BulkDocumentActionResponse> bulkSyncResponse = restTemplate.postForEntity(uri, new HttpEntity<>(request, headers), BulkDocumentActionResponse.class);
            return ResponseEntity.ok(bulkSyncResponse.getBody());
        } catch (IndexNotFoundException e) {
            logger.error("Index not found in OpenSearch: {}", e.getMessage(), e);
            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Index not found in OpenSearch", e);

        } catch (RestClientException e) {
            logger.error("Exception occured in syncDocuments :", e);
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Error occurred while making the HTTP request in syncDocuments method", e);
        } catch (Exception e) {
            logger.error("Exception occured in syncDocuments :", e);
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Exception occured in the syncDocuments method", e);
        }
    }

    public List<Long> fetchDeleteDocumentIds(HttpHeaders headers, List<APIDocument> apisList) {
        logger.info("Inside fetchDeleteDocumentIds rest call method");
        ResponseEntity<DocumentIdSearchResponse> response;
        String url = openSearchServicePath + "/documentIds";
        try {
            response = restTemplate.exchange(url, HttpMethod.GET, new HttpEntity<>(null),
                    DocumentIdSearchResponse.class);
        } catch (Exception e) {
            throw new RuntimeException("Failed to fetch document IDs from OpenSearch", e);
        }

        if (response.getBody() != null && response.getBody().getDocumentIds() != null) {
            logger.info("Document ids from opensearch :{}", response.getBody().getDocumentIds());
            List<Long> apiIds = apisList.stream().map(apiDocument -> Long.valueOf(apiDocument.getApiId())).toList();

            return response.getBody().getDocumentIds().stream().filter(docId -> !apiIds.contains(docId))
                    .collect(Collectors.toList());
        }
        return Collections.emptyList();
    }

    private List<APIDocument> prepareUpsertDocuments(List<APIDocument> apisList) {
        logger.info("Inside prepareUpsertDocuments method");
        List<APIDocument> upsertDocuments = new ArrayList<>();

        for (APIDocument api : apisList) {
            List<String> intakeJiras = apiRepository.getIntakeTickets(api.getApiId(), ITDMINTAKE);
            List<String> pinxtJiras = apiRepository.getPinxtTrackingInfo(RESOURCE, TICKET_TYPE, api.getApiId(), ITDMINTAKE);
            List<String> plugins = apiRepository.getPlugins(api.getApiId());
            List<String> clients = apiRepository.getClients(api.getApiId());
            // Start of implementing as part of PINXTSS-3583
            List<String> appRefs = apiToCmdbAppMappingRepository.findCmdbAppRefIdsByApiId(Long.valueOf(api.getApiId())); //create this
            String cmdbAppId = apiToCmdbAppMappingRepository.findCmdbAppIdByApiId(Long.valueOf(api.getApiId())); //create this

            CmdbAppDocument cmdbAppDocument = new CmdbAppDocument();
            cmdbAppDocument.setAppRefs(appRefs);
            cmdbAppDocument.setCmdbAppId(cmdbAppId);
            // end of implementing as part of PINXTSS-3583
//            api.setContacts(getApiContactsByApiId(Long.valueOf(api.getApiId())));//Code commented to implement PINXTSS-3235
            api.setContacts(getApiContactsWithTeamName(Long.valueOf(api.getApiId())));//Code for implementing PINXTSS-3235
            api.setTags(getTags(apiRepository.getTags(api.getApiId())));
            api.setPlugins(plugins != null ? plugins : new ArrayList<>());
            api.setClients(clients != null ? clients : new ArrayList<>());
            api.setIntakeTrackingInfo(intakeJiras != null ? intakeJiras : new ArrayList<>());
            api.setPinxtTrackingInfo(pinxtJiras != null ? pinxtJiras : new ArrayList<>());
            api.setCmdbAppMapping(cmdbAppDocument); // implementing as part of PINXTSS-3583
            upsertDocuments.add(api);
        }
        return upsertDocuments;
    }

    private BulkDocumentActionRequest createBulkDocumentActionRequest(List<Long> deleteDocumentIds, List<APIDocument> upsertDocuments) {
        BulkDocumentActionRequest request = new BulkDocumentActionRequest();
        request.setTobeDeletedDocuments(deleteDocumentIds);
        request.setTobeUpsertedDocuments(upsertDocuments);
        return request;
    }

