    private void deleteS3Directory(String apiName, String apiVersion) {
        String fileName = getFileName(apiName, apiVersion);
        String url = filemgmtDeleteApiUrl + fileName + "/apis/" + apiName + "/versions/" + apiVersion;
        try {
            restTemplate.delete(url);
        } catch (Exception e) {
            String message = "Failed to delete content from: %s - %s".formatted(url, e.getMessage());
            logger.error(message);
            throw new ServerErrorException(message, e);
        }
    }

    public String getFileName(String apiName, String apiVersion) {
        String majorVersion = extractMajorVersion(apiVersion);
        String productName = DEFAULT_PRODUCT;
        String fileName = productName + "-" + apiName.toLowerCase().replaceAll("[^a-zA-Z0-9]+", "-") + "-"
                + majorVersion;
        return fileName;
    }

    public String extractMajorVersion(String apiVersion) {
        if (apiVersion == null) {
            return null;
        }
        Matcher matcher = Pattern.compile("\\D*?([vV]?\\d+).*").matcher(apiVersion);
        return matcher.matches() ? matcher.group(1) : "";
    }

