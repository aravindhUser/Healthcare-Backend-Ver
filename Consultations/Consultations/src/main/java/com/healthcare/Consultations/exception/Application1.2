    void dynamicScopeManagement(ApiRequest apiReq) {
        try {
            logger.info("Inside dynamicScopeManagement method:{}", apiReq);
            List<String> dbScopesNames = new ArrayList<>();
            List<GatewayScopes> listOfNewGatewayScopes = new ArrayList<>();
            Set<String> newEntriesToUpdateInDb = new HashSet<>();
            if (apiReq.getCpAttachedPlugins() != null && !apiReq.getCpAttachedPlugins().isEmpty()) {
                for (CpAttachedPlugins cp : apiReq.getCpAttachedPlugins()) {
                    if (cp.getPluginData().getPluginId().equals(4) || cp.getPluginData().getPluginId().equals(8)) {
                        logger.info("Oauth and Client mTLS Plugin Info:{}", cp);
                        Set<String> setOfScopesNames = new HashSet<>();
                        if (cp.getFormValues().getScopes() != null && !cp.getFormValues().getScopes().isEmpty()) {
                            setOfScopesNames.addAll(cp.getFormValues().getScopes());
                        }
                        if (cp.getFormValues().getOverrides() != null && !cp.getFormValues().getOverrides().isEmpty()) {
                            for (ScopeOverrides scopeOverrides : cp.getFormValues().getOverrides()) {
                                setOfScopesNames.add(scopeOverrides.getScope());
                            }
                        }
                        logger.info("new scope entries:{}", setOfScopesNames);
                        dbScopesNames = gatewayScopeRepository.getAllScopeNames();
                        newEntriesToUpdateInDb.addAll(findNewEntries(setOfScopesNames, dbScopesNames));
                    }
                }
                if (newEntriesToUpdateInDb != null && !newEntriesToUpdateInDb.isEmpty()) {
                    logger.info("newEntriesToUpdateInDb:{}", newEntriesToUpdateInDb);
                    listOfNewGatewayScopes = newGatewayScopesMapping(newEntriesToUpdateInDb, apiReq,
                            listOfNewGatewayScopes);
                    logger.info("New Scopes to be saved to DB:{}", listOfNewGatewayScopes);
                    gatewayScopeRepository.saveAll(listOfNewGatewayScopes);
                }
            }

        } catch (Exception e) {
            logger.error("Unable to save new scope entries to DB:{}", e);
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
                    "Unable to save new scope entries to DB:{}", e);
        }
    }

    List<String> findNewEntries(Set<String> uniqueScopesFromRequest, List<String> dbScopesNames) {
        logger.info("uniqueScopesFromRequest:{} and dbScopesNames:{} ", uniqueScopesFromRequest, dbScopesNames);
        return uniqueScopesFromRequest.stream().filter(entry -> !dbScopesNames.contains(entry))
                .collect(Collectors.toList());
    }

    List<GatewayScopes> newGatewayScopesMapping(Set<String> newEntriesToUpdateInDb, ApiRequest apiReq,
                                                List<GatewayScopes> listOfNewGatewayScopes) {
        logger.info("Inside newGatewayScopesMapping:{}, ApiRequest:{}", newEntriesToUpdateInDb, apiReq);
        String scopeType;
        String scope;
        for (String str : newEntriesToUpdateInDb) {
            String[] scopeParts = str.split("\\.");
            scopeType = scopeParts[scopeParts.length - 1];
            scope = String.join(".", Arrays.copyOfRange(scopeParts, 0, scopeParts.length - 1));
            GatewayScopes gatewayScopes = prepareGatewayScopePayload(apiReq, scopeType, scope);
            listOfNewGatewayScopes.add(gatewayScopes);

        }
        logger.info("listOfNewGatewayScopes:{} ", listOfNewGatewayScopes);
        return listOfNewGatewayScopes;

    }

    private GatewayScopes prepareGatewayScopePayload(ApiRequest apiReq, String scopeType, String scope) {
        GatewayScopes gatewayScopes = new GatewayScopes();
        gatewayScopes.setGatewayId(apiReq.getApiGatewayId());
        gatewayScopes.setPluginId(4);
        gatewayScopes.setScopeName(scope + "." + scopeType);
        gatewayScopes.setScopeType(scopeType);
        gatewayScopes.setUpdatedTs(new Timestamp(System.currentTimeMillis()));
        gatewayScopes.setCreationTs(new Timestamp(System.currentTimeMillis()));
        gatewayScopes.setScope(scope);
        gatewayScopes.setScopeVisibility("public");
        return gatewayScopes;
    }

