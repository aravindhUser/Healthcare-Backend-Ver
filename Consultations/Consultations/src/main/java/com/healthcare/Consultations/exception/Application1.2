    public ResponseEntity<VersionLockResponse> createOrUpdateVersionLock(VersionLockRequest versionLockRequest, String userId) {
        try {
            Optional<Apis> api = apiRepository.findByApiIdAndApiFamilyId(Long.valueOf(versionLockRequest.getApiId()), versionLockRequest.getApiFamilyId());
            if (api.isPresent()) {
                logger.info("Record present for apiId: {}", versionLockRequest.getApiId());
                if (!api.get().getIsLatest()) {
                    logger.info("Api for apiId {} is not latest.", versionLockRequest.getApiId());
                    throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "API is not latest to add new version.");
                }
            } else {
                logger.info("Record not present for apiId: {}", versionLockRequest.getApiId());
                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Couldn't find the given API & API Family Association in the system");
            }
            Optional<ApiVersionLocks> isApiVersionLocks = apiVersionLocksRepository.findByApiIdAndApiFamilyId(versionLockRequest.getApiId(), versionLockRequest.getApiFamilyId());
            String message = null;
            String error = null;
            VersionLockResponse versionLockResponse = null;
            if (isApiVersionLocks.isPresent()) {
                logger.info("Record present for apiId: {} and apiFamilyId : {} in Version Lock Table :{}", versionLockRequest.getApiId(), versionLockRequest.getApiFamilyId(), versionLockRequest);
                ApiVersionLocks apiVersionLocks = isApiVersionLocks.get();
                if (apiVersionLocks.getUserId().equals(userId)) {
                    logger.info("Same user {} is trying to acquire lock", userId);
                    ApiVersionLocks res = saveVersionLock(apiVersionLocks, apiVersionLocks.getUserId());
                    logger.info("Record saved successfully(Timestamps updated)");
                    message = "Lock Acquired successfully";
                    versionLockResponse = getVersionLockResponse(res, message, error);
                    return new ResponseEntity<>(versionLockResponse, HttpStatus.CREATED);
                } else {
                    logger.info("Different user is trying to acquire lock for api whose lock is already acquired by a different user");
                    message = "Currently, this API is being edited by " + apiVersionLocks.getUserId() + ". Please note that concurrent revisions of the API is not supported.";
                    error = "Conflict";
                    versionLockResponse = getVersionLockResponse(apiVersionLocks, message, error);
                    return new ResponseEntity<>(versionLockResponse, HttpStatus.CONFLICT);
                }
            } else {
                logger.info("Record not present for apiId {} and apiFamilyId {} in Version Lock Table.", versionLockRequest.getApiId(), versionLockRequest.getApiFamilyId());
                ApiVersionLocks apiVersionLocks = new ApiVersionLocks();
                apiVersionLocks.setApiFamilyId(versionLockRequest.getApiFamilyId());
                apiVersionLocks.setApiId(versionLockRequest.getApiId());
                ApiVersionLocks res = saveVersionLock(apiVersionLocks, userId);
                logger.info("Record saved successfully");
                message = "Lock Acquired successfully";
                versionLockResponse = getVersionLockResponse(res, message, error);
                logger.info("Returning response: {}", versionLockResponse);
                return new ResponseEntity<>(versionLockResponse, HttpStatus.CREATED);
            }
        } catch (ResponseStatusException e) {
            logger.error("Exception (ResponseStatusException) occurred in createOrUpdateVersionLock: {}", e.getMessage());
            throw e;
        } catch (Exception e) {
            logger.error("Exception occurred in createOrUpdateVersionLock: {}", e.getMessage());
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Unable to process your request");
        }
    }

    public ApiVersionLocks saveVersionLock(ApiVersionLocks apiVersionLocks, String userId) {
        try {
            logger.info("Parameters received by saveVersionLock: apiVersionLocks: {}, userId: {}", apiVersionLocks, userId);
            apiVersionLocks.setLockStartedAt(Timestamp.from(Instant.now()));
            apiVersionLocks.setLockExpiresAt(Timestamp.from(Instant.now().plus(lockExpiryTimeIntervalInMinutes, ChronoUnit.MINUTES)));
            apiVersionLocks.setIsLockActive(true);
            apiVersionLocks.setUserId(userId);
            ApiVersionLocks res = apiVersionLocksRepository.save(apiVersionLocks);
            logger.info("Returning response (saveVersionLock): {}", res);
            return res;
        } catch (Exception e) {
            logger.error("Exception occurred in saveVersionLock: {}", e.getMessage());
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Unable to process your request");
        }
    }

    public ResponseEntity<VersionLockResponse> deleteVersionLock(Integer apiId) {
        logger.info("Inside deleteVersionLock with apiId: {}", apiId);
        Optional<ApiVersionLocks> apiVersionLocks = apiVersionLocksRepository.findByApiId(apiId);
        if (apiVersionLocks.isPresent()) {
            logger.info("Record found for apiId: {}", apiId);
            ApiVersionLocks res = apiVersionLocks.get();
            apiVersionLocksRepository.delete(res);
            logger.info("Record deleted successfully for apiId: {}", apiId);
            VersionLockResponse versionLockResponse = new VersionLockResponse();
            versionLockResponse.setMessage("Successfully deleted lock on API");
            versionLockResponse.setApiId(res.getApiId());
            versionLockResponse.setApiFamilyId(res.getApiFamilyId());
            logger.info("Returning response obj: {}", versionLockResponse);
            return new ResponseEntity<>(versionLockResponse, HttpStatus.OK);
        } else {
            logger.info("Record not found for apiId: {}", apiId);
            throw new ResponseStatusException(NOT_FOUND, "Unable to release lock");
        }
    }

    public VersionLockResponse getVersionLockResponse(ApiVersionLocks apiVersionLocks, String message, String error) {
        VersionLockResponse versionLockResponse = new VersionLockResponse();
        versionLockResponse.setError(error);
        versionLockResponse.setMessage(message);
        versionLockResponse.setLockId(apiVersionLocks.getLockId());
        versionLockResponse.setLockedBy(apiVersionLocks.getUserId());
        versionLockResponse.setApiId(apiVersionLocks.getApiId());
        versionLockResponse.setApiFamilyId(apiVersionLocks.getApiFamilyId());
        versionLockResponse.setLockedAt(apiVersionLocks.getLockStartedAt());
        return versionLockResponse;
    }
