    public ResponseEntity<List<String>> getApiRating(long id) {
        logger.info("Inside getApiRating method :");
        List<ApiRating> entity = apiRatingRepository.findById(id);
        Optional<Apis> userData = apiRepository.findById(id);
        GetApiRating getApiRating = new GetApiRating();

        if (userData.isPresent() && entity.isEmpty()) {
            getApiRating.setApiId(id);
            getApiRating.setApiName(null);
            getApiRating.setRatingCount(0);
            getApiRating.setAvgRating(0.0);

            return new ResponseEntity(getApiRating, HttpStatus.OK);
        } else if (!entity.isEmpty()) {

            DoubleSummaryStatistics stats = entity.stream().mapToDouble(ApiRating::getRating)
                    .filter(rating -> rating > 0.0D).summaryStatistics();
            long count = stats.getCount();
            double averageRating = stats.getAverage();
            double range = 0.5;

            double factor = Math.round(averageRating / range);

            double avgRatingRoundOff = factor * range;

            getApiRating.setApiId(id);
            if (userData.isPresent()) {
                getApiRating.setApiName(userData.get().getApiName());
            }
            getApiRating.setRatingCount(count);
            getApiRating.setAvgRating(avgRatingRoundOff);
            logger.info("Inside getApiRating ", getApiRating.toString());
            return new ResponseEntity(getApiRating, HttpStatus.OK);
        } else {
            throw new RecordNotFoundException("No matching record found for id: " + id);
        }
    }

