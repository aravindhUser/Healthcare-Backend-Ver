	public void updateMonitoringInfo(ApiRequest apiReq, Apis newEntity) {
		logger.info("Inside updateMonitoringInfo method:");

		List<MonitoringInfoDTO> monitoringInfoList = apiReq.getMonitoringInfo();
		if (monitoringInfoList == null || monitoringInfoList.isEmpty()) {
		    logger.info("Monitoring info is null or empty. Deleting all existing monitoring info.");

		    // Delete all existing monitoring info
		    List<ApiMonitoringInfo> existingLinks = monitoringInfoRepository.findByApiApiId(apiReq.getApiId());
		    for (ApiMonitoringInfo toDelete : existingLinks) {
		        monitoringInfoRepository.delete(toDelete);
		    }

		    newEntity.getMonitoringInfo().clear(); // Clear entity's monitoring info
		    return;
		}

		Map<Long, ApiMonitoringInfo> existingLinks = monitoringInfoRepository
                .findByApiApiId(apiReq.getApiId())
                .stream()
                .collect(Collectors.toMap(ApiMonitoringInfo::getLinkId, Function.identity()));

        List<ApiMonitoringInfo> updatedList = new ArrayList<>();

        for (MonitoringInfoDTO dto : apiReq.getMonitoringInfo()) {
            if (dto.getLinkId() != null && existingLinks.containsKey(dto.getLinkId())) {
                ApiMonitoringInfo existing = existingLinks.get(dto.getLinkId());
                modelMapper.map(dto, existing); // Update fields
                updatedList.add(existing);
                existingLinks.remove(dto.getLinkId());
            } else {
                ApiMonitoringInfo newInfo = modelMapper.map(dto, ApiMonitoringInfo.class);
                newInfo.setApi(newEntity);
                updatedList.add(newInfo);
            }
        }

        // Delete remaining
        for (ApiMonitoringInfo toDelete : existingLinks.values()) {
            monitoringInfoRepository.delete(toDelete);
        }

        //newEntity.setMonitoringInfo(updatedList);
        newEntity.getMonitoringInfo().clear(); // removes all existing entries
        newEntity.getMonitoringInfo().addAll(updatedList); // adds updated/new entries
	}

    @Async
    public void updateDocumentToOpenSearch(Apis apiResponse, AdminDashboard adminDashboard) {
        logger.info("Inside updateDocumentToOpenSearch :");
        logger.info("Api Response Object:{}", apiResponse);
        logger.info("Admin Dashboard Object:{}", adminDashboard);
        APIDocument doc = new APIDocument();
        doc.setApiId((int) apiResponse.getApiId());
        doc.setApiName(apiResponse.getApiName());
        doc.setRequestId((int) adminDashboard.getRequestId());
        doc.setApiVersion(apiResponse.getApiVersion());
        doc.setApiDescription(apiResponse.getApiDescription());
        doc.setClientBasePath(apiResponse.getBasePath());
        doc.setServiceBasePath(apiResponse.getTargetBasePath());
        doc.setModality(apiResponse.getModality());
        doc.setClientAccessType(apiResponse.getConsumerType());
        doc.setLifeCycleStage(apiResponse.getLifeCycleStage());
        doc.setStatus(apiResponse.getStatus());
        doc.setUpdatedTimestamp(apiResponse.getUpdatedTimestamp());//Code for PINXTSS-2890

        doc.setCmdbAppMapping(cmdbAppMappingOpenSearch(adminDashboard)); // implementing as part of PINXTSS-3583



//		Fix for Edit Page issue start
        if (adminDashboard.getApiDetails().getContacts() != null) {
//            doc.setContacts(adminDashboard.getApiDetails().getContacts());//Commented to implement PINXTSS-3235
            doc.setContacts(getApiContactsWithTeamName(apiResponse.getApiId()));//Code to implement PINXTSS-3235
        }

        if (adminDashboard.getApiDetails().getTagAssignments() != null) {
            Set<String> tags = new HashSet<>();
            for (TagAssignments ta : adminDashboard.getApiDetails().getTagAssignments()) {
                tags.addAll(Arrays.asList(ta.getTags()));
            }
            doc.setTags(new ArrayList<String>(tags));
        }
        Set<String> plugins = new HashSet<>();
        for (CpAttachedPlugins cp : adminDashboard.getApiDetails().getCpAttachedPlugins()) {
            if (cp.getPluginData() != null) {
                plugins.add(cp.getPluginData().getPluginName());
            }
        }
        for (SpAttachedPlugins sp : adminDashboard.getApiDetails().getSpAttachedPlugins()) {
            if (sp.getPluginData() != null) {
                plugins.add(sp.getPluginData().getPluginName());
            }
        }
        doc.setPlugins(new ArrayList<String>(plugins));
        doc.setIntakeTrackingInfo(adminDashboard.getApiDetails().getIntakeJIRAs());
        List<String> pinxtJiras = apiRepository.getPinxtTrackingInfo(RESOURCE, TICKET_TYPE, (int) apiResponse.getApiId(), ITDMINTAKE);
        doc.setPinxtTrackingInfo(pinxtJiras);
        List<String> clients = apiRepository.getClients(apiResponse.getApiId());
        doc.setClients(clients);
        //code change for PINXTSS-2728
        doc.setIsLatest(apiResponse.getIsLatest());
        doc.setApiFamilyId(apiResponse.getApiFamilyId());
//		Fix for Edit Page issue end
        logger.info("Document to update :{}", doc);
        String url = openSearchServicePath + "/documents";
        try {
            HttpHeaders headers = new HttpHeaders();
            ResponseEntity<DocumentActionResponse> openSearchResponse = restTemplate.exchange(url, HttpMethod.PUT, new HttpEntity<>(doc, headers), DocumentActionResponse.class);
            logger.info("Response from OpenSearch - Status: {}, Body: {}", openSearchResponse.getStatusCode(), openSearchResponse.getBody());
        } catch (Exception e) {
            logger.error("Failed to post api: {} to OpenSearch. Exception: {}", doc, e.getMessage(), e);
        }


    }

    private CmdbAppDocument cmdbAppMappingOpenSearch(AdminDashboard adminDashboard) {
        CmdbAppDocument cmdbAppDocument = new CmdbAppDocument();

        cmdbAppDocument.setCmdbAppId(
                Optional.ofNullable(adminDashboard.getApiDetails())
                        .map(ApiResponse::getCmdbAppMapping)
                        .map(CmdbAppMappingResponse::getCmdbAppId)
                        .orElse(null)
        );

        cmdbAppDocument.setAppRefs(
                Optional.ofNullable(adminDashboard.getApiDetails())
                        .map(ApiResponse::getCmdbAppMapping)
                        .map(CmdbAppMappingResponse::getAppRefs)
                        .orElse(Collections.emptyList())
                        .stream()
                        .filter(Objects::nonNull)
                        .map(ApiToCmdbAppMappingResponse::getCmdbAppRefId)
                        .collect(Collectors.toList())
        );

        return cmdbAppDocument;
    }

