    public void createOrUpdateTargetMapping(ApiRequest apiReq, Apis api) {
        logger.info("Inside createOrUpdateTargetMapping method: {}", api.getApiId());
        ApiTargetMapping apiTargetMapping = new ApiTargetMapping();
        try {
            if (apiReq != null) {
                if (apiReq.getTargetMapping() != null && !apiReq.getTargetMapping().isEmpty()) {

                    apiTargetMappingRepository.deleteTargetMapping(api.getApiId());

                    for (TargetMapping targetMappingReq : apiReq.getTargetMapping()) {
                        apiTargetMapping = new ApiTargetMapping();
                        apiTargetMapping.setApiGatewayId(apiReq.getApiGatewayId());
                        apiTargetMapping.setApiId(api.getApiId());
                        apiTargetMapping.setEnvDesc(targetMappingReq.getEnvDesc());
                        apiTargetMapping.setEnvId(targetMappingReq.getEnvId());
                        apiTargetMapping.setTargetURL(targetMappingReq.getTargetURL());
                        apiTargetMapping.setOverrideInd(targetMappingReq.getOverrideInd());
                        apiTargetMapping.setMethod(targetMappingReq.getMethod());
                        apiTargetMapping.setResourceLocation(targetMappingReq.getOperation());
                        apiTargetMapping.setCreateTs(new Timestamp(System.currentTimeMillis()));
                        apiTargetMapping.setUpdateTs(new Timestamp(System.currentTimeMillis()));
                        logger.info("Before Saving the apiTargetMapping data to DB :{}", apiTargetMapping);
                        apiTargetMappingRepository.save(apiTargetMapping);
                    }
                    if (apiReq.getApiGatewayId() == 99 || apiReq.getApiGatewayId() == 88 || apiReq.getApiGatewayId() >= 100) {
                        logger.info("Skipping the saving of overrides data for the gateway id :{}", apiReq.getApiGatewayId());
                    } else {
                        createOrUpdateOverrideTargetMapping(apiReq, api);
                    }
                }
                logger.info("Saving the apiTargetMapping data to DB :{}", apiTargetMapping);
            }
        } catch (Exception e) {
            logger.error("Inside catch Block of createOrUpdateTargetMapping", e.getMessage());
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
                    "Exception occured while adding or updating api target details", e);
        }

    }

    public void createOrUpdateOverrideTargetMapping(ApiRequest apiReq, Apis api) {
        logger.info("Inside createOrUpdateOverrideTargetMapping method: {}", api.getApiId());

        try {

            if (apiReq.getOverrides() != null && !apiReq.getOverrides().isEmpty()) {

                for (Overrides overridesIterator : apiReq.getOverrides()) {
                    if (overridesIterator.getTargetURLOverride() != null
                            && !overridesIterator.getTargetURLOverride().isEmpty()) {

                        for (TargetURLOverride targetURLOverrideIterator : overridesIterator.getTargetURLOverride()) {
                            ApiTargetMapping targetMapping = new ApiTargetMapping();
                            targetMapping.setApiId(api.getApiId());
                            targetMapping.setMethod(overridesIterator.getMethod());
                            targetMapping.setResourceLocation(overridesIterator.getResourceLocation());
                            targetMapping.setOverrideInd(overridesIterator.getOverrideInd());
                            targetMapping.setEnvId(targetURLOverrideIterator.getGatewayEnvId());
                            targetMapping.setEnvDesc(targetURLOverrideIterator.getTargetEnvDesc());
                            targetMapping.setTargetURL(targetURLOverrideIterator.getTargetURL());
                            targetMapping.setApiGatewayId(apiReq.getApiGatewayId());
                            apiTargetMappingRepository.save(targetMapping);
                        }

                    }

                }

            }
        } catch (Exception e) {
            logger.error("Inside catch Block of createOrUpdateOverrideTargetMapping", e.getMessage());
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
                    "Exception occured while adding or updating api target details", e);
        }
    }

    public ResponseEntity<List<GatewayHostnameResponse>> getAllGatewayInfo() {
        logger.info("Inside getAllGatewayInfo method");
        List<GatewayHostname> gatewayHostnameList = new ArrayList<>();
        logger.info("Making call to Db to fetch all the gateway info");
        try {
            gatewayHostnameList = gatewayHostnameRepository.findAll();
            List<GatewayHostnameResponse> gatewayHostnameResponseList = new ArrayList<>();
            Map<Integer, Map<Integer, List<GatewayHostname>>> groupedEnvironments = new HashMap<>();
            if (gatewayHostnameList != null && !gatewayHostnameList.isEmpty()) {
                groupedEnvironments = gatewayHostnameList.stream().collect(Collectors.groupingBy(
                        GatewayHostname::getGatewayId, Collectors.groupingBy(GatewayHostname::getGatewayEnvId)));

                for (Entry<Integer, Map<Integer, List<GatewayHostname>>> iterator : groupedEnvironments.entrySet()) {
                    List<Environments> environmentsList = new ArrayList();
                    GatewayHostnameResponse gatewayHostnameResponse = new GatewayHostnameResponse();
                    Map<Integer, List<GatewayHostname>> mapValue = iterator.getValue();
                    for (Entry<Integer, List<GatewayHostname>> environmentIterator : mapValue.entrySet()) {
                        Environments environments = new Environments();
                        List<Url> urlList = new ArrayList<>();
                        for (GatewayHostname gatewayHostnameIterator : environmentIterator.getValue()) {
                            mappingGatewayHostnameFields(gatewayHostnameResponse, environments, urlList,
                                    gatewayHostnameIterator);
                        }
                        environments.setUrl(urlList);
                        environmentsList.add(environments);
                    }
                    gatewayHostnameResponse.setEnvironments(environmentsList);
                    gatewayHostnameResponseList.add(gatewayHostnameResponse);
                }
                logger.info("Whole gateway info response:{}", gatewayHostnameResponseList);
            }
            return new ResponseEntity<>(gatewayHostnameResponseList, HttpStatus.OK);
        } catch (Exception e) {
            logger.error("Inside catch Block of getAllGatewayInfo:{}", e.getMessage());
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
                    "Exception occured while fetching details from gatewayHostname table", e);
        }
    }

