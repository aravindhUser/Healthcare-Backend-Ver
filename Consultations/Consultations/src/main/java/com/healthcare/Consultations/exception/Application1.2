    public List<String> getTags(String tag) {
        List<String> tagNames = new ArrayList<>();
        if (tag != null) {
            String[] arrOfStr = tag.split("\\^");
            TagAssignments[] assignments = new TagAssignments[arrOfStr.length];

            for (int k = 0; k < arrOfStr.length; k++) {
                String[] valArr = arrOfStr[k].split("\\|");
                if (valArr.length < 2) {
                    continue;
                }

                TagAssignments tagval = new TagAssignments();
                tagval.setCategoryName(valArr[0]);
                String[] tagnm = valArr[1].split("~");
                tagval.setTags(tagnm);
                assignments[k] = tagval;
            }

            List<String> allTags = Arrays.stream(assignments)
                    .filter(Objects::nonNull)
                    .flatMap(tagAssignment -> Arrays.stream(tagAssignment.getTags()))
                    .collect(Collectors.toList());

            return allTags;
        }
        return Collections.emptyList();
    }


    public ResponseEntity<DocumentSearchResponse> openSearch(Integer pageNum, Integer pageSize, String sortBy,
                                                             String sortOrder, String xTraceId, String must, String mustNot) {

        String url = openSearchServicePath + "/documents";
        logger.info("Inside Open search service class");
        logger.info("Request Values: pageNum:{},pageSize:{}, sortBy:{}, sortOrder:{}, x-trace-id:{}, must:{}, mustNot:{}", pageNum, pageSize, sortBy, sortOrder, xTraceId, must, mustNot);

        UriComponentsBuilder uriBuilder = UriComponentsBuilder.fromHttpUrl(url)
                .queryParam("pageNum", pageNum)
                .queryParam("pageSize", pageSize)
                .queryParam("sortBy", sortBy)
                .queryParam("sortOrder", sortOrder);

        if (must != null && !must.isEmpty()) {
            uriBuilder.queryParam("must", must);
        }
        if (mustNot != null && !mustNot.isEmpty()) {
            uriBuilder.queryParam("mustNot", mustNot);
        }

        URI uri = uriBuilder.build().toUri();
        logger.info("URL with query params :{}", uri);

        return restTemplate.exchange(uri, HttpMethod.GET, HttpEntity.EMPTY,
                DocumentSearchResponse.class);
    }

