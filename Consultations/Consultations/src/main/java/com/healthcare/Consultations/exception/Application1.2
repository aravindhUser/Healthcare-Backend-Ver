    private void mappingGatewayHostnameFields(GatewayHostnameResponse gatewayHostnameResponse,
                                              Environments environments, List<Url> urlList, GatewayHostname gatewayHostnameIterator) {
        gatewayHostnameResponse.setGatewayId(gatewayHostnameIterator.getGatewayId());
        gatewayHostnameResponse.setGatewayName(gatewayHostnameIterator.getGatewayName());
        gatewayHostnameResponse.setStatus(gatewayHostnameIterator.getStatus());
        environments.setEnvId(gatewayHostnameIterator.getGatewayEnvId());
        environments.setEnv(gatewayHostnameIterator.getGatewayEnv());
        environments.setGatewayDesc(gatewayHostnameIterator.getGatewayDesc());
        environments.setEnvKeyword(gatewayHostnameIterator.getEnvKeyword());
        Url url = new Url();
        url.setType(gatewayHostnameIterator.getGatewayType());
        url.setValue(gatewayHostnameIterator.getGatewayHostnameValue());
        urlList.add(url);
        gatewayHostnameResponse.setCreatedTimestamp(gatewayHostnameIterator.getCreationTs());
        gatewayHostnameResponse.setModifiedTimestamp(gatewayHostnameIterator.getUpdatedTs());
        gatewayHostnameResponse.setActionBy(gatewayHostnameIterator.getActionBy());
    }


