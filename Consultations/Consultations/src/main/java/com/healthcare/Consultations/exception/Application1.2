	@GetMapping("/apis/opensearch")
	public ResponseEntity<DocumentSearchResponse> openSearch(
			@RequestParam(required = false) Integer pageNum,
			@RequestParam(required = false) Integer pageSize,
			@RequestParam(required = false) String sortBy,
			@RequestParam(required = false) String sortOrder,
			@RequestHeader(value = "x-trace-id") String xTraceId,
			@RequestParam(required = false) String must,
			@RequestParam(required = false) String mustNot){

		logger.info("Inside openSearch method:");
		ResponseEntity<DocumentSearchResponse> response = null;
		try {
			if(must!=null && !must.isEmpty()){
				if(!isJsonValid(must)){
					logger.info("Exception occurred in open search. Invalid must Json:{}",must);
					DocumentSearchResponse docResponse = new DocumentSearchResponse();
					docResponse.setStatus(HttpStatus.BAD_REQUEST.toString());
					docResponse.setDocuments(null);
					docResponse.setDetailedMessage("Invalid must json: ".concat(must));
					docResponse.setIndex(null);
					docResponse.setHighLevelError("Invalid Json");
					return ResponseEntity.badRequest().body(docResponse);
				}
			}
			if(mustNot!=null && !mustNot.isEmpty()){
				if(!isJsonValid(mustNot)){
					logger.info("Exception occurred in open search. Invalid mustNot Json:{}",mustNot);
					DocumentSearchResponse docResponse = new DocumentSearchResponse();
					docResponse.setStatus(HttpStatus.BAD_REQUEST.toString());
					docResponse.setDocuments(null);
					docResponse.setDetailedMessage("Invalid mustNot json: ".concat(mustNot));
					docResponse.setIndex(null);
					docResponse.setHighLevelError("Invalid Json");
					return ResponseEntity.badRequest().body(docResponse);
				}
			}
//			Code for implementing PINXTSS-2634 start
			boolean status = true;
			JSONObject mustJson = new JSONObject();
			if(must!=null && !must.isEmpty()){
				mustJson = new JSONObject(must);
			}
			mustJson.put("status",status);
			must = mustJson.toString();
//			Code for implementing PINXTSS-2634 end
			response = apiService.openSearch(pageNum,pageSize,sortBy,sortOrder,xTraceId,must,mustNot);
			logger.info("GET search response :",response);
			return response;
		} catch (Exception ex) {
			logger.info("Exception occurred in open search :", ex);
			throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, ex.getMessage(), ex);
		}
	}

//	Code for 4xx error handling start
	private boolean isJsonValid(String json){
		try{
			objectMapper.readTree(json);
			return true;
		} catch (JsonProcessingException e) {
			return false;
        }
    }
//	Code for 4xx error handling end

	public ResponseEntity<String> loggedInAdmin(String authToken) {
		logger.info("Inside loggedInAdmin Method");
		ArrayList<String> userRoleAndEmail = tokenValidation(authToken);

		String userRole = userRoleAndEmail.get(0);

		try {
			logger.info("Inside loggedInAdmin JWT  userRole :");
			if (userRole == null) {
				userRole = "0";
			}

			if ("0".equals(userRole)) {
				throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "User is not Registered");
			} else if (!"Admin".equals(userRole)) {
				throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Does not have Admin Privileges");
			}

		} catch (Exception exception) {
			logger.error("Inside loggedInAdmin JWT Catch Block :",exception);
			throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, exception.getMessage());
		}

		return new ResponseEntity<>(userRole, HttpStatus.OK);
	}


	//public ResponseEntity<String> loggedInAdminPost(String authToken, Long productId, TagAssignments[] tagAssignments) {
	public ResponseEntity<String> loggedInUserPost(String authToken, Long productId, TagAssignments[] tagAssignments) {
		logger.info("Inside loggedInUserPost Method");
		ArrayList<String> userRoleAndEmail = tokenValidation(authToken);

		String userRole = userRoleAndEmail.get(0);
		String email = userRoleAndEmail.get(1);

		try {
			logger.info("Inside loggedInUserPost JWT   userRole :");

			String productOwner = apiRepository.getProductOwner(productId);

			List<String> domainOwnerNames = new ArrayList<>();
			if (tagAssignments != null && tagAssignments.length > 0){
				for (TagAssignments arr :tagAssignments) {

					if (arr.getTags() != null) {
						for (String tag :arr.getTags()) {
							domainOwnerNames.add(apiRepository.getDomainOwner(tag));
						}
					}
				}
			}


			if (userRole == null) {
				throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "User is not Registered");
			} else if (Boolean.TRUE.equals(isEditingDisabled) && !("Admin".equals(userRole))) {
				return new ResponseEntity<>(HttpStatus.FORBIDDEN);
			} else if ("Admin".equals(userRole) || "Developer".equals(userRole) || "OrgAdmin".equals(userRole) || "Manager".equals(userRole)) {
				return new ResponseEntity<>(userRole, HttpStatus.OK);
			} else if (!"Admin".equals(userRole) && !"Developer".equals(userRole) && !"OrgAdmin".equals(userRole) || !"Manager".equals(userRole)) {
				throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Does not have required Privileges");
			}

			if (email.equals(productOwner)) {
				return new ResponseEntity<>(productOwner, HttpStatus.OK);
			}

