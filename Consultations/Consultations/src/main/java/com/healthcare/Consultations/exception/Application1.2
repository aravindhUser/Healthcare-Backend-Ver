    public ResponseEntity<CMDBAppValidationResponse> validateApp(String appId, String appRefId, String traceId) {
        logger.info("Inside Service clas validateApp()");
        if (!isCMDBInfoValidationEnabled) {
            logger.info("CMDB validation feature is disabled");
            CMDBAppValidationResponse cmdbAppValidationResponse = new CMDBAppValidationResponse();
            cmdbAppValidationResponse.setDetailedMessage("");
            cmdbAppValidationResponse.setHighLevelError("");
            cmdbAppValidationResponse.setStatus(OK.toString());
            cmdbAppValidationResponse.setCmdbAppInfo(null);
            return ResponseEntity.status(OK)
                    .body(cmdbAppValidationResponse);
        }

        logger.info("Validating inputs");
        String validateInputResponse = validateInputs(appId, appRefId);
        logger.info("Input validation completed");
        if(!validateInputResponse.equalsIgnoreCase(VALID_INPUT)){
            CMDBAppValidationResponse cmdbAppValidationResponse = new CMDBAppValidationResponse();
            cmdbAppValidationResponse.setDetailedMessage(validateInputResponse);
            cmdbAppValidationResponse.setHighLevelError(BADREQUEST);
            cmdbAppValidationResponse.setStatus(String.valueOf(HttpStatus.BAD_REQUEST.value()));
            cmdbAppValidationResponse.setCmdbAppInfo(null);
            return ResponseEntity.status(BAD_REQUEST)
                    .body(cmdbAppValidationResponse);
        }

        try {
            String cmdbUrl = buildCmdbUrl(appId, appRefId);
            HttpEntity<Void> entity = createHttpEntity(traceId);
            logger.info("Calling CMDB service with URL: {}", cmdbUrl);
            ResponseEntity<CMDBAppValidationResponse> cmdbResponse = restTemplate.exchange(
                    UriComponentsBuilder.fromUriString(cmdbUrl).build(true).toUri(),
                    HttpMethod.GET,
                    entity,
                    CMDBAppValidationResponse.class);

            logger.info("CMDB response: {}", cmdbResponse);
            return ResponseEntity.status(cmdbResponse.getStatusCode())
                    .body(cmdbResponse.getBody());

        } catch (HttpClientErrorException e) {
            logger.error("Client error when calling CMDB service: Status Code = {}, Body = {}", e.getStatusCode(), e.getResponseBodyAsString(), e);
            CMDBAppValidationResponse cmdbAppValidationResponse;
            try {
                cmdbAppValidationResponse = objectMapper.readValue(
                        e.getResponseBodyAsString(),
                        CMDBAppValidationResponse.class
                );
                cmdbAppValidationResponse.setTraceId(traceId);
            } catch (Exception ex) {
                logger.error("Error parsing CMDB client error response", ex);
                cmdbAppValidationResponse = new CMDBAppValidationResponse();
                cmdbAppValidationResponse.setDetailedMessage(INVALID_REQUEST_TO_CMDB_SERVICE);
                cmdbAppValidationResponse.setHighLevelError(INTERNALSERVERERROR);
                cmdbAppValidationResponse.setStatus(String.valueOf(HttpStatus.NOT_FOUND.value()));
                cmdbAppValidationResponse.setCmdbAppInfo(null);
                cmdbAppValidationResponse.setTraceId(traceId);
            }
            return ResponseEntity.status(e.getStatusCode())
                    .body(cmdbAppValidationResponse);
        } catch (HttpServerErrorException e) {
            logger.error("Server error when calling CMDB service", e);
            CMDBAppValidationResponse cmdbAppValidationResponse;
            try {
                cmdbAppValidationResponse = objectMapper.readValue(e.getResponseBodyAsString(), CMDBAppValidationResponse.class);
                cmdbAppValidationResponse.setTraceId(traceId);
            } catch (Exception ex) {
                logger.error("Error parsing CMDB error response", ex);
                cmdbAppValidationResponse = new CMDBAppValidationResponse();
                cmdbAppValidationResponse.setDetailedMessage(CMDB_SERVICE_UNAVAILABLE);
                cmdbAppValidationResponse.setHighLevelError(INTERNALSERVERERROR);
                cmdbAppValidationResponse.setStatus(String.valueOf(HttpStatus.INTERNAL_SERVER_ERROR.value()));
                cmdbAppValidationResponse.setCmdbAppInfo(null);
                cmdbAppValidationResponse.setTraceId(traceId);
            }
            return ResponseEntity.status(e.getStatusCode())
                    .body(cmdbAppValidationResponse);
        } catch (Exception e) {
            logger.error("Unexpected error calling CMDB service:", e);
            CMDBAppValidationResponse cmdbAppValidationResponse = new CMDBAppValidationResponse();
            cmdbAppValidationResponse.setDetailedMessage(UNEXPECTED_ERROR_CALLING_CMDB);
            cmdbAppValidationResponse.setHighLevelError(INTERNALSERVERERROR);
            cmdbAppValidationResponse.setStatus(String.valueOf(HttpStatus.INTERNAL_SERVER_ERROR.value()));
            cmdbAppValidationResponse.setCmdbAppInfo(null);
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body(cmdbAppValidationResponse);
        }
    }

    private String validateInputs(String appId, String appRefId) throws IllegalArgumentException {
        if ((appId==null || appId.isEmpty()) && (appRefId==null || appRefId.isEmpty())) {
            return APPID_OR_APPREFID_MUST_BE_PRESENT;
        }

        if (appId != null && !appId.isEmpty() && !APP_ID_PATTERN.matcher(appId).matches()) {
            return INVALID_APP_ID_FORMAT;
        }

        if (appRefId!=null && !appRefId.isEmpty() && !APP_REF_ID_PATTERN.matcher(appRefId).matches()) {
            return INVALID_APP_REF_ID_FORMAT;
        }
        return VALID_INPUT;
    }

    private String buildCmdbUrl(String appId, String appRefId) {
        return UriComponentsBuilder.fromUriString(cmdbServiceUrl)
                .queryParam(StringUtils.hasText(appId) ? "appId" : "appRefId",
                        StringUtils.hasText(appId) ? appId : appRefId)
                .toUriString();
    }

    private HttpEntity<Void> createHttpEntity(String traceId) {
        HttpHeaders headers = new HttpHeaders();
        headers.set("x-trace-id", traceId);
        return new HttpEntity<>(headers);
    }
