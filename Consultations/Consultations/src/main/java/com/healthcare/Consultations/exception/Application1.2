    private String removeTrailingPath(String basePath) {
        logger.info("Inside removeTrailingPath method");
        if (basePath != null && basePath.endsWith("/")) {
            basePath = basePath.substring(0, basePath.length() - 1);
        }
        return basePath;
    }

    public List<GetAvailability> getMatchingPaths(String inputPath, List<GetAvailability> dbPaths) {
        logger.info("Input getMatchingPaths with inputPath :{}", inputPath);
        if (hasOneSegment(inputPath)) {
            String normalizedInputPath = removeNumbersAndSpecialChars(inputPath);
            return dbPaths.stream().filter(entity -> hasOneSegment(entity.getBasePath()))
                    .filter(entity -> removeNumbersAndSpecialChars(entity.getBasePath()).equals(normalizedInputPath))
                    .collect(Collectors.toList());

        } else {
            List<String> inputSegments = getSegments(removeNumbersAndSpecialChars(inputPath));
            logger.info("Input basepath segments :{}", inputSegments);
            return dbPaths.stream().filter(entry -> {
                List<String> dbSegments = getSegments(removeNumbersAndSpecialChars(entry.getBasePath()));
                int inputSize = inputSegments.size();
                int dbSize = dbSegments.size();
                return (dbSize == inputSize || dbSize == inputSize + 1 || dbSize + 1 == inputSize)
                        && segmentsMatch(inputSegments, dbSegments);
            }).collect(Collectors.toList());
        }
    }

    private boolean hasOneSegment(String inputPath) {
        if (inputPath == null) {
            return false;
        }
        return inputPath.chars().filter(ch -> ch == '/').count() == 1;
    }


    private List<String> getSegments(String path) {
        return Arrays.asList(path.split("/"));
    }

    private boolean segmentsMatch(List<String> segments1, List<String> segments2) {
        int minSize = Math.min(segments1.size(), segments2.size());
        for (int i = 0; i < minSize; i++) {
            if (!segments1.get(i).equals(segments2.get(i))) {
                return false;
            }
        }
        return true;
    }

    private String removeNumbersAndSpecialChars(String path) {
        if (path == null || path.isEmpty()) {
            return "";
        }
        return path.replaceAll("[^a-zA-Z/]", "");
    }

