    public void getFullMatches(Long apiId, String apiName, String basePath, String apiVersion,
                               CheckAvailabilityResponse avail, List<GetAvailability> apis, ApiMatch match, Long gatewayId, String status, Integer apiFamilyId) {
        logger.info("Inside getFullMatches  method");
        List<GetAvailability> basePathMatches = new ArrayList<>();

        if (status.equalsIgnoreCase(UNDEFINED) && apiFamilyId == null && apiId == null) {
            if (basePath != null) {
                String normalizedPath = removeTrailingPath(basePath);
                if (normalizedPath != null && !normalizedPath.isEmpty()) {
                    basePathMatches = apiRepository.getFullMatchBasePath(normalizedPath.toLowerCase());
                }
                logger.info("BasePathMatches :{}", basePathMatches);
                List<GetAvailability> listOfBasepaths = apiRepository.getAllBasePaths();

                logger.info("Searching the matches with basepath :{}", basePath);
                List<GetAvailability> matchingPaths = getMatchingPaths(basePath, listOfBasepaths);

                if (basePathMatches != null && !basePathMatches.isEmpty() && apiId == null) {
                    match = createFullMatchObj(basePathMatches.get(0), match);
                    avail.setFullMatch(match);
                    avail.setErrorDetails(BasePath_ErrMsg);
                } else if (basePathMatches.isEmpty() && matchingPaths != null && !matchingPaths.isEmpty()) {
                    if (apiName != null && apiVersion != null) {
                        if (apis.isEmpty() && apiId == null) {

                            GetAvailability basePathMatchObj = matchingPaths.get(0);
                            match = createFullMatchObj(basePathMatchObj, match);
                            avail.setFullMatch(match);
                            avail.setErrorDetails(SameApiName_ErrMsg.replace("$apiName", match.getApiName()));

                        } else {
                            avail.setFullMatch(null);
                        }
                    }

                } else {
                    if (apis != null && !apis.isEmpty() && apiId == null) {
                        ApiMatch matEntityOpt = new ApiMatch();
                        matEntityOpt = createFullMatchObj(apis.get(0), matEntityOpt);
                        avail.setFullMatch(matEntityOpt);
                        avail.setErrorDetails(ApiName_ErrMsg.replace("$apiName", apiName));
                    } else {
                        avail.setFullMatch(null);
                    }
                }
                // Code changes for PINXTSS-2703
                if (apiName != null && !matchingPaths.isEmpty() && apiId == null) {
                    for (GetAvailability existingApi : matchingPaths) {
                        if (existingApi.getApiName().equals(apiName) && !existingApi.getBasePath().equals(basePath)) {
                            avail.setFullMatch(null);
                            avail.setErrorDetails(BasePath_ErrMsg);
                            break;
                        }
                    }
                }
            }

            if ((gatewayId.equals(PRIVATE_GATEWAY_ID) || gatewayId.equals(NONE_GATEWAY_ID)
                    || gatewayId.equals(OTHER_GATEWAY_ID)) && basePath.matches("^/$")) {
                if (avail.getErrorDetails() != null && avail.getErrorDetails().contains("Major version")) {
                    avail.setFullMatch(null);
                    avail.setErrorDetails(null);
                }
            }
        }

        //new version flow
		if (status.equalsIgnoreCase(UNDEFINED) && apiFamilyId != null && apiId == null) {
			if (basePath != null) {
				List<GetAvailability> apiList = apiRepository.findApisByBasepath(basePath, Arrays.asList(SUBMITTED, APPROVED));
				if (apiList != null && !apiList.isEmpty()) {
					if ((gatewayId.equals(PRIVATE_GATEWAY_ID) || gatewayId.equals(NONE_GATEWAY_ID)
							|| gatewayId.equals(OTHER_GATEWAY_ID))) {
						avail.setFullMatch(null);
						avail.setErrorDetails(null);

					} else {
						avail.setFullMatch(createFullMatchObj(apiList.get(0), new ApiMatch()));
						avail.setErrorDetails(BASEPATH_UNIQUE_ERROR);
					}
				}
			}
		}


        //approval flow
        if (status.equalsIgnoreCase(SUBMITTED) && apiFamilyId != null && apiId != null) {

            Apis existingRecord = apiRepository.findByApiId(apiId);
            if (existingRecord != null) {
                boolean isApiNameChanged = !existingRecord.getApiName().equals(apiName);
                boolean isBasePathChanged = !existingRecord.getBasePath().equals(basePath);

                if (isApiNameChanged || isBasePathChanged) {
                    if (isApiNameChanged) {
                        List<GetAvailability> apiList = apiRepository.findApisByApiNameAndDifferentApiFamily(apiName,
                                apiFamilyId);
                        if (apiList != null && !apiList.isEmpty()) {
                            avail.setFullMatch(createFullMatchObj(apiList.get(0), new ApiMatch()));
                            avail.setErrorDetails(APINAME_UNIQUENESS_ERROR);
                        }
                    }

                    if (isBasePathChanged) {
                        var current = parseVersion(existingRecord.getApiVersion());
                        var updated = parseVersion(apiVersion);

                        if (updated.major() > current.major()) {
                            logger.info("Major version incremented.");
                            List<GetAvailability> apiList = apiRepository.findApisByBasepath(basePath, Arrays.asList(SUBMITTED, APPROVED));
                            if (apiList != null && !apiList.isEmpty()) {
                                avail.setFullMatch(createFullMatchObj(apiList.get(0), new ApiMatch()));
                                avail.setErrorDetails(BASEPATH_UNIQUE_ERROR);
                            }
                        } else if (updated.major() == current.major() && updated.minor() > current.minor()) {
                            logger.info("Minor version incremented.");
                            avail.setErrorDetails(BASEPATH_CANT_BE_CHANGED_FOR_MINOR_VERSION);

                        } else {
                            logger.info("No version change detected.");
                        }
                    }

                }

//			if(basePath != null && !basePath.isEmpty()) {
//				List<GetAvailability> apiList = apiRepository.findApisByBasepathAndDifferentApiFamily(basePath, apiFamilyId);
//				if(apiList != null && !apiList.isEmpty()) {
//					avail.setFullMatch(createFullMatchObj(apiList.get(0),new ApiMatch()));
//					avail.setErrorDetails(BASEPATH_UNIQUE_ERROR);
//				}
//			}
//			
//			if(apiName != null && !apiName.isEmpty()) {
//				List<GetAvailability> apiList = apiRepository.findApisByApiNameAndDifferentApiFamily(apiName, apiFamilyId);
//				if(apiList != null && !apiList.isEmpty()) {
//					avail.setFullMatch(createFullMatchObj(apiList.get(0),new ApiMatch()));
//					avail.setErrorDetails(APINAME_UNIQUENESS_ERROR);
//				}
//			}
            }

        }

        logger.info("Full Match Response :{}", avail);
    }


    private static Version parseVersion(String version) {
        var parts = version.substring(1).split("\\.");
        return new Version(Integer.parseInt(parts[0]), Integer.parseInt(parts[1]));
    }

