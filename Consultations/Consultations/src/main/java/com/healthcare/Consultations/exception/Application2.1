                logger.info("Api id: {}", api.getApiId());
                if (apiReq.getContacts() != null && !apiReq.getContacts().isEmpty()) {
                    for (Contacts contacts : apiReq.getContacts()) {
                        ApiContacts apiContacts = new ApiContacts();
                        apiContacts.setApiId(api.getApiId());
                        if (contacts.getContactType() != null) {
                            apiContacts.setContactType(contacts.getContactType());
                        }

                        if (contacts.getTeamId() != null) {
                            apiContacts.setTeamId(contacts.getTeamId());
                        }

                        apiContactsRepository.save(apiContacts);
                    }
                }
            }
        } catch (Exception e) {
            logger.error("Inside Catch Block of createOrUpdateApiContacts method: {}", e.getMessage());
            throw new MethodFailureException(
                    "Exception occurred in createOrUpdateApiContacts method: " + e.getMessage());
        }
