    @GetMapping("/apis/opensearch")
    public ResponseEntity<DocumentSearchResponse> openSearch(
            @RequestParam(required = false) Integer pageNum,
            @RequestParam(required = false) Integer pageSize,
            @RequestParam(required = false) String sortBy,
            @RequestParam(required = false) String sortOrder,
            @RequestHeader(value = "x-trace-id") String xTraceId,
            @RequestParam(required = false) String must,
            @RequestParam(required = false) String mustNot){

        logger.info("Inside openSearch method:");
        ResponseEntity<DocumentSearchResponse> response = null;
        try {
            if(must!=null && !must.isEmpty()){
                if(!isJsonValid(must)){
                    logger.info("Exception occurred in open search. Invalid must Json:{}",must);
                    DocumentSearchResponse docResponse = new DocumentSearchResponse();
                    docResponse.setStatus(HttpStatus.BAD_REQUEST.toString());
                    docResponse.setDocuments(null);
