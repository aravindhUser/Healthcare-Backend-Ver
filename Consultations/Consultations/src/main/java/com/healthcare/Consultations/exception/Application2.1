    @PostMapping(value = "/apis")
    public ResponseEntity<List<String>> createApi(
            @RequestBody ApiRequest apiReq,
            @RequestHeader(value = "X-JWT", required = false) String jwtToken,
            @RequestHeader(value = "X-TRANSACTION-ID", required = false) String transactionID,
            @RequestHeader(value = "x-trace-id") String xTraceId) {
        logger.info("Inside createApi method  with ApiRequest: {}", apiReq.toString());
        if (jwtToken == null || jwtToken.isEmpty()) {
            return new ResponseEntity<>(HttpStatus.FORBIDDEN);
        }
        ResponseEntity<List<String>> response = null;
        try {
            //loggedInAdminPost(jwtToken, apiReq.getProductId(), apiReq.getTagAssignments());
            ResponseEntity<String> loggedInUserPostResponse = loggedInUserPost(jwtToken, apiReq.getProductId(), apiReq.getTagAssignments());

            if (loggedInUserPostResponse.getStatusCode() == HttpStatus.FORBIDDEN) {
                return new ResponseEntity<>(null, loggedInUserPostResponse.getStatusCode());
            }

            response = apiService.createNewApi(apiReq);
        } catch (Exception ex) {
            logger.info("Exception occurred in createApi :", ex);
            throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR, "Exception occurred in createApi", ex);
        }
        return response;

    }


