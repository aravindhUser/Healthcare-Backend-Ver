  chkOverrideValidations(serverInfo){
    this.errorListForURLOverride = new Set();
    // console.log(this.overrideForm.valid);
    let globalGtwyEnvs = serverInfo.map(m => m.envId)
    const validHostnameRegex = /^((https?|ftp|smtp):\/\/)?(www.)?[\.a-zA-Z0-9-:]+(\.[a-zA-Z0-9]{2,}){0,3}(:)?(0-9)?(#?\/?[a-zA-Z0-9#-.]+)*\/?(\?[a-zA-Z0-9-_]+=[a-zA-Z0-9-%]+&?)?$/;
    const validIpAddressRegex = /^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$/;
    let arr = this.overrideForm.value.overrideArray.filter(data=> data.overrideInd===true)
    arr.forEach(x=>{
      let targetUrlDetails = x.targetURLOverride;
      targetUrlDetails.forEach(data => {
        if(data.gatewayEnvId === 0)
          this.errorListForURLOverride.add('Gateway environment blank for '+ x.resourceLocation +' '+ x.method+' resource override');
        if(data.targetURL === '')
          this.errorListForURLOverride.add('Target URL blank for '+ x.resourceLocation +' '+ x.method +' resource override');
        // if(!globalGtwyEnvs.includes(data.gatewayEnvId))
        //   this.errorListForURLOverride.add('Gateway environments are not part of service level gateway environments for '+ x.resourceLocation +' '+ x.method+' resource override');
        if((!validHostnameRegex.test(data.targetURL)) && (!validIpAddressRegex.test(data.targetURL)))
          this.errorListForURLOverride.add('Invalid target URL for '+ x.resourceLocation +' '+ x.method+' resource override');
      })
      const uniqueValues = new Set(targetUrlDetails.map(v => v.gatewayEnvId));
      if(uniqueValues.size < targetUrlDetails.length)
          this.errorListForURLOverride.add('Duplicate environments found for '+ x.resourceLocation +' '+ x.method+' resource override');
    })
    return  this.errorListForURLOverride;

  }




