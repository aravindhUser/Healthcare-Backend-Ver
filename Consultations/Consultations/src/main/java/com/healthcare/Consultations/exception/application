      Array.isArray(intakeJIRAs) && intakeJIRAs.length === 0) ||
      (this.errorList?.size ?? 0) > 0 ||
      !this.connectivityInfoForm.valid ||
      (Array.isArray(tagsPerCategory) && tagsPerCategory.length > 5) ||
      (category !== '' && Array.isArray(tagsPerCategory) && tagsPerCategory.length === 0);
  }
