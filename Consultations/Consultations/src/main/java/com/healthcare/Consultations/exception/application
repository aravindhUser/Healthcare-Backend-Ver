  decideClientBasePathInputEnabled() {
    const apiGatewayId = this.detailsForm.get('apiGatewayId').value;

    // Enable client base path in publish mode
    if (this.mode === DashboardModes.PUBLISH) {
      // Code to implement PINXTSS-3996 start
      if (apiGatewayId === GatewayType.PRIVATE || apiGatewayId === GatewayType.NONE || apiGatewayId >= GatewayType.OTHERGW) {
        return false;
      }
      // Code to implement PINXTSS-3996 end
      return true;
    }

    // Disable client base path for specific gateway types
    if (apiGatewayId === GatewayType.PRIVATE || apiGatewayId === GatewayType.NONE || apiGatewayId >= GatewayType.OTHERGW) {
      return false;
    }

    // Handle resubmit mode
    // if (this.mode === DashboardModes.RESUBMIT) {//Code commented to implement PINXTSS-3214
    if (this.mode === DashboardModes.RESUBMIT || this.mode === DashboardModes.REVIEW) {//Code to implement PINXTSS-3214
      const originalApiVersion = this.selectedApiData.apiDetails.apiVersion;
      const newApiVersion = this.detailsForm.get('apiVersion').value;
      const isMajorVersionChange = this.isMajorVersion(originalApiVersion, newApiVersion);

      // If switching back to a minor version after editing the base path, reset the base path to the original value
      if (!isMajorVersionChange) {
        if (this.detailsForm.get('basePath').enabled) {
          // Code to implement PINXTSS-3996 start
          if(this.isApiPreviouslyApproved){
            this.detailsForm.get('basePath').setValue(this.selectedApiData.apiDetails.basePath);            
            this.detailsForm.get('basePath').disable();            
            sessionStorage.setItem('basePath',JSON.stringify(this.detailsForm.get('basePath').value));
          }
          else{
            this.detailsForm.get('basePath').setValue(sessionStorage.getItem('basePath')?JSON.parse(sessionStorage.getItem('basePath')):this.detailsForm.get('basepath').value);
            this.detailsForm.get('basePath').enable();
            sessionStorage.setItem('basePath',JSON.stringify(this.detailsForm.get('basePath').value));            
          }
          // Code to implement PINXTSS-3996 end
          // Below code commented to implement PINXTSS-3996.
          // this.detailsForm.get('basePath').setValue(this.selectedApiData.apiDetails.basePath); // Reset to original base path
          // sessionStorage.setItem('basePath',JSON.stringify(this.detailsForm.get('basePath').value));//Code for implementing PINXTSS-3919
          // this.detailsForm.get('basePath').disable();
          // Above code commented to implement PINXTSS-3996.
        }
        // Code for implementing PINXTSS-3881 start
        // if(this.mode === DashboardModes.REVIEW && !this.isApiPreviouslyApproved && (JSON.parse(sessionStorage.getItem('hasSwaggerChanged'))===true || JSON.parse(sessionStorage.getItem('backButtonTriggered'))===true)){//Code commented to implement PINXTSS-3996
        if((this.mode === DashboardModes.REVIEW || this.mode === DashboardModes.RESUBMIT) && !this.isApiPreviouslyApproved && (JSON.parse(sessionStorage.getItem('hasSwaggerChanged'))===true || JSON.parse(sessionStorage.getItem('backButtonTriggered'))===true)){//Code to implement PINXTSS-3996
          this.detailsForm.get('basePath').setValue(JSON.parse(sessionStorage.getItem('basePath')));            
          this.detailsForm.get('apiName').setValue(sessionStorage.getItem('apiName'));
          this.detailsForm.get('basePath').enable();
          // Code to implement PINXTSS-3996 start
          if(this.mode===DashboardModes.RESUBMIT && sessionStorage.getItem('resubmitFlowInitiatedBy').toUpperCase()==="ADD_VERSION_FLOW"){
            return false;
          }
          return true;
          // Code to implement PINXTSS-3996 end          
        }
        // Code for implementing PINXTSS-3881 end
      } else {
        // Code for implementing PINXTSS-3881 start
        if(this.mode === DashboardModes.REVIEW && !this.isApiPreviouslyApproved && (JSON.parse(sessionStorage.getItem('hasSwaggerChanged'))===true || JSON.parse(sessionStorage.getItem('backButtonTriggered'))===true)){
          // this.detailsForm.get('basePath').setValue(JSON.parse(sessionStorage.getItem('basePath')));//Code commented to implement PINXTSS-3919
          this.detailsForm.get('apiName').setValue(sessionStorage.getItem('apiName'));
        }
        // Code for implementing PINXTSS-3881 end
        // this.detailsForm.get('basePath').setValue(JSON.parse(sessionStorage.getItem('basePath')));//Code for implementing PINXTSS-3919//Code commented to implement PINXTSS-3996
        this.detailsForm.get('basePath').setValue(sessionStorage.getItem('basePath')?JSON.parse(sessionStorage.getItem('basePath')):this.detailsForm.get('basepath').value);//Code for implementing PINXTSS-3996
        this.detailsForm.get('basePath').enable(); // Allow editing for major version change
      }

      return isMajorVersionChange;
    }

    // Default to enabling the client base path
    return true;
  }



