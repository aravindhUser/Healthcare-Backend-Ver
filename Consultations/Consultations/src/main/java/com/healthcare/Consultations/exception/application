            let secSchemaObj;
            if (data.component) {
              if (data.component.securitySchemes) {
                secSchemaObj = Object.keys(data.components.securitySchemes)
              }
            }
            else if (data.components) {
              if (data.components.securitySchemes) {
                secSchemaObj = Object.keys(data.components.securitySchemes)
              }
            }
            else if (data.securityDefinitions) {
              secSchemaObj = Object.keys(data.securityDefinitions)
            }

            else if (data.security) {
              secSchemaObj = Object.keys(data.security)
            }
            if (secSchemaObj) {
              let currentUserObj = JSON.parse(localStorage.getItem('currentUser'));
              let appKey = currentUserObj.subscriptions[0].appKey;

              let trialKey = {};
              secSchemaObj.forEach(secType => {

                trialKey[secType] = appKey;
              })
              localStorage.setItem('TryIt_securitySchemeValues', JSON.stringify(trialKey));
            }

          });
      }
      else if (this.specType === 'WSDL') {
        this.wsdlUrl = data.specPath;
        this.isGQL = false;
        this.isRAML = false;
        this.isWSDL = true;
        this.isYAML = false;
      }
      else if (this.specType === 'GraphQL') {
        this.specPath = data.specPath;
        this.isGQL = true;
        this.isRAML = false;
        this.isWSDL = false;
        this.isYAML = false;

      }
