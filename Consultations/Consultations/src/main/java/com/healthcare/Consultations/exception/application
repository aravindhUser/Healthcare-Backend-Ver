  fetchSecurityDetails() {
    let securityData = JSON.parse(sessionStorage.getItem('securityData'));
    let overViewData = JSON.parse(
      sessionStorage.getItem(this.sessionStorageOverviewSnapshot)
    );
    if (securityData) {
      let securityType = securityData.type.replace(' ', '').toLowerCase();

      if (securityType === 'apikey') {
        let name = securityData.name || '';
        let str = securityData.in || 'Header';
        let location = str[0].toUpperCase() + str.slice(1);
        this.fillApiKeyDetails(overViewData.specType, location, name);
      }

      if (securityType === 'oauth2') {
        let authUrl = securityData.authorizationUrl || '';
        let refreshUrl = securityData.refreshUrl || '';
        let tokenUrl = securityData.tokenUrl || '';
        let flow = securityData.flow || 'client crendentials';
        let scopes = securityData.scopes || '';
        let scopeData = Object.keys(scopes).join(', ');
        this.fillOAuthDetails(
          overViewData.specType,
          flow,
          authUrl,
          tokenUrl,
          refreshUrl,
          scopeData
        );
      }
    }
  }

