  //comparing Client Base Path version against actual Version
  validateVersionAgainstBasePath(clientBasePath, version) {

    let majorVersion = version.split('.')[0];
    // console.log("clientBasePath", clientBasePath, "major version", majorVersion, "!clientBasePath.includes(majorVersion)", !clientBasePath.includes(majorVersion))
    if (!clientBasePath.includes(majorVersion)) {
      return {
        errorType: 'WARNING',
        message: 'Client Base Path & Service Version not matching'
      };
    }
  }

  extractVersion(v) {
    v = v.replace(/^v|V/, ""); // Remove leading 'v' or 'V'
    const versionRegex = /^(\d+)\.(\d+)$/; // Match major.minor format
    const match = v.match(versionRegex);

    if (match) {
      const major = parseInt(match[1], 10);
      const minor = parseInt(match[2], 10);
      return { major, minor }; // Return an object with major and minor parts
    } else {
      return null; // Return null if the version format is invalid
    }
  }

  compareVersions(version1, version2) {
    const v1 = this.extractVersion(version1);
    const v2 = this.extractVersion(version2);

    if (v1 === null || v2 === null) {
      return 0; // Treat invalid versions as equal
    }

    if (v1.major !== v2.major) {
      return v1.major - v2.major; // Compare major versions
    }

    return v1.minor - v2.minor; // Compare minor versions if majors are equal
  }


  validateHigherVersion(currentVersion, existingVersions, newVersion) {
    console.log("validateHigherVersion currentVersion", currentVersion, "existingVersions", existingVersions, "newVersion", newVersion);

    if (
      this.resubmitFlowInitiatedBy == "ADD_VERSION_FLOW" &&
      this.compareVersions(newVersion, currentVersion) <= 0
    ) {
      return {
        errorType: 'ERROR',
        message: 'Please enter a higher version than the existing version: ' + currentVersion
      };
    }

    if (existingVersions === undefined || existingVersions === null) {
      return;
    }

    let versions = existingVersions.versions.map(v => v.version);
    console.log("versions", versions);

    let matchedVersions = versions.filter(v => {
      let extractedVersion = this.extractVersion(v);
      let newExtractedVersion = this.extractVersion(newVersion);
      return extractedVersion !== null && extractedVersion === newExtractedVersion;
    });

    console.log("matchedVersions", matchedVersions);

    if (matchedVersions.length > 0) {
      return {
        errorType: 'ERROR',
        message: 'Please enter a higher version than the existing versions: ' + versions
      };
    }
  }

