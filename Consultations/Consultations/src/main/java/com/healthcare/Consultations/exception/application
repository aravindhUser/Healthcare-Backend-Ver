  //lets Open up the feedback component in side mat dialog.
  openFeedbackDialog() {
    const dialogConfig = new MatDialogConfig();
    dialogConfig.autoFocus = true;
    dialogConfig.hasBackdrop = true;
    dialogConfig.width = '25%';
    dialogConfig.data = {
      rating: this.userRating || 0
    };
    const dialogRef = this.dialog.open(ApiFeedbackComponent, dialogConfig);

    dialogRef.afterClosed().subscribe(async (data) => {
      if (data) {
        const payload = {
          ...data,
          apiId: this.api.apiId,
          username: this.authService.username,
        };
        //Update the userRating with the rating which he has submitted just now.
        //So that if he clicks on Rate this api again, he'll see his last rating
        this.userRating = payload.rating;

        const apirating = await this.apiService.postAPIRating(payload);
        this.apiAvgRating = apirating.avgRating;
        this.apiRatingCount = apirating.ratingCount;
      }
    });
  }

