          // console.log('availability data', data);
          if (data.fullMatch) {
            this.fullMatchApis = data.fullMatch;
            this.errorMessage = '';
          } else {
            this.errorMessage = '';
          }
          if (data.partialMatch) {
            this.partialMatchApis = data.partialMatch;
          }
          //Conditional in order to call the dialog box function
          let error;
          if (data.errorDetails !== null) {
            error = {
              errorType: 'ERROR',
              message: data.errorDetails
            };
          }

          cb(this.fullMatchApis, this.partialMatchApis, error);
        },
        error => {
          // console.log(error.message);
          const data = { action: DialogBoxActionEnum.AVAILABILITYCHECKERROR};
          const dialogRef = this.dialog.open(DialogBoxComponent, {
            width: '750px',
            data,
          });

        }
      );
  }

