                connectivityInfoForm.get("cmdbAppId").updateValueAndValidity();
              }   else{
                connectivityInfoForm.get("cmdbAppId").clearValidators();
                connectivityInfoForm.get("cmdbAppId").updateValueAndValidity();
              }
            }

          },
          (error) => {
            //console.log(error);
            connectivityInfoForm.get("cmdbAppId").setValidators(f => <any>{ error: error.error.detailedMessage});
            connectivityInfoForm.get("cmdbAppId").updateValueAndValidity();
          }
        );

        }
      } else {
        //console.log('admin entering default value');
        connectivityInfoForm.get("cmdbAppId").clearValidators();
        connectivityInfoForm.get("cmdbAppId").updateValueAndValidity();
      }
    }else{
      console.log(connectivityInfoForm.get("cmdbAppId").value)
    if (connectivityInfoForm.get("cmdbAppId").value.length !== 7 || !connectivityInfoForm.get("cmdbAppId").value.startsWith("APP") || !/\d{4}$/.test(connectivityInfoForm.get("cmdbAppId").value) ) {
       connectivityInfoForm.get("cmdbAppId").setValidators(f => <any>{invalidCmdbAppId:true});
       connectivityInfoForm.get("cmdbAppId").updateValueAndValidity();
    }
    }
    return null;
    //
  };
}
