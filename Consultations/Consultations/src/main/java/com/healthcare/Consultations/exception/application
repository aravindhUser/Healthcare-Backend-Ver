  validateVersionFormat(version: string): { errorType: string; message: string } | null {
  const versionRegex = /^v(\d+)\.(\d+)$/; // Matches v{major}.{minor} format
  const match = version.match(versionRegex);

  if (!match) {
    return {
      errorType: 'ERROR',
      message: 'Invalid Version format. Expected format: v{major}.{minor} e.g., v1.0.'
    };
  }

  const major = parseInt(match[1], 10);
  const minor = parseInt(match[2], 10);

  if (isNaN(major) || isNaN(minor)) {
    return {
      errorType: 'ERROR',
      message: 'Version major and minor must be valid numbers.'
    };
  }

  if (major === 0 && minor === 0) {
    return {
      errorType: 'ERROR',
      message: 'Both major and minor version of an API cannot be zero simultaneously.'
    };
  }

  return null; // Valid version format
