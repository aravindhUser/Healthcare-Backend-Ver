  getSortIcon(column: string): string {
    if (this.sortColumn === column) {
        return this.sortDirection === 'asc' ? '▲' : '▼';
    }
    return '↕';
}


  sortTable(column: string) {
    if (this.sortColumn === column) {
        this.sortDirection = this.sortDirection === 'asc' ? 'desc' : 'asc';
    } else {
        this.sortColumn = column;
        this.sortDirection = 'asc';
    }

    this.filteredUrls.sort((a, b) => {
        const valueA = a[column];
        const valueB = b[column];

        if (valueA < valueB) {
            return this.sortDirection === 'asc' ? -1 : 1;
        } else if (valueA > valueB) {
            return this.sortDirection === 'asc' ? 1 : -1;
        } else {
            return 0;
        }
    });
}


filterTable() {
  const { environment, type, url, available } = this.filters;

  if (!environment && !type && !url && !available) {
      this.filteredUrls = [...this.processedUrls]; // Reset to all records if no filters are applied
  } else {
      this.filteredUrls = this.processedUrls.filter(item => {
          return Object.keys(this.filters).every(key => {
              return item[key].toLowerCase().includes(this.filters[key].toLowerCase());
          });
      });
  }
}

toggleFilter(column: string) {
  if (column === 'environment') {
      this.showEnvironmentFilter = !this.showEnvironmentFilter;
  } else if (column === 'type') {
      this.showTypeFilter = !this.showTypeFilter;
  } else if (column === 'url') {
      this.showUrlFilter = !this.showUrlFilter;
  } else if (column === 'available') {
      this.showAvailableFilter = !this.showAvailableFilter;
  }
}

clearFilter(column: string) {
  this.filters[column] = '';
  this.filterTable();
}

