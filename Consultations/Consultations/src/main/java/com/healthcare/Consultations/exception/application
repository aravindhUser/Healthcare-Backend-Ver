  convertVersionObj(v) {
    console.log("convertVersionObj v", v)
    // let vs = v.version.replace("V", "").replace("v", "").split(".")//Code commented to implement PINXTSS-4036
    let vs = v.version.replace(/[^0-9.]/g, "").split(".");//Code to implement PINXTSS-4036
    //in order to handle old data v2 or v3, which don't minor version. In such cases, we are considering minor version as 0
    let minorVersion = parseInt(vs[1]);
    if(isNaN(minorVersion)) {
      minorVersion = 0;
    }

    return { major: parseInt(vs[0]), minor: minorVersion }

  }

  versionStr(v) {
    return "v" + v.major + "." + v.minor
  }

  validateAllowedVersion(existingVersions, currentVersion, newVersion) {
    currentVersion.major=this.majorVersionFromGetCall;//Code for implementing PINXTSS-3120
    console.log("validateAllowedVersion existingVersions::", existingVersions, "currentVersion", currentVersion, "newVersion ", newVersion)
    existingVersions.sort(this.compare);
    console.log("Current Version: ",currentVersion);
    console.log("New Version: ",newVersion);
    let type = this.typeOfVersionChange(currentVersion, newVersion)
    console.log("type", type)
    if (type == 'INVALID_MAJOR' || type == 'INVALID_MINOR' || type == 'NO_CHANGE') {
      return {
        code: type,
        errorType: "ERROR",
        message: "New version: " + this.versionStr(newVersion) + " should be higher than current version: " + this.versionStr(currentVersion)
      }
    }

    let matchedVersions = existingVersions.filter(v => v.major === newVersion.major && v.minor === newVersion.minor);
    if (matchedVersions.length > 0) {
      return {
        code: 'VERSION_EXISTS',
        errorType: "ERROR",
        message: "New version: " + this.versionStr(newVersion) + " already exists "
      }
    }

    if (type == 'MAJOR') {
      let highVersion = existingVersions[existingVersions.length - 1]
      console.log("validateAllowedVersion highVersion", highVersion)
      if (newVersion.major < highVersion.major) {
        return {
          code: "LOWER_MAJOR_VERSION",
          errorType: "ERROR",
          message: "New version: " + this.versionStr(newVersion) + " should be higher than next high version: " + this.versionStr(highVersion)
        }
      }
      else if (currentVersion.major < highVersion.major) {
        return {
            code: "HIGHER_THAN_HIGH_MAJOR_VERSION",
            errorType: "ERROR",
            message: "The new version: " + this.versionStr(newVersion) + " is invalid. It must be greater than the current version: " + this.versionStr(currentVersion) + " but less than or equal to the highest major version: " + this.versionStr(highVersion) + "."
        }
    }
    } else if (type == 'MINOR') {
      let nextHighVersion = { major: currentVersion.major + 1, minor: 0 };
      console.log("validateAllowedVersion nexthighVersion", nextHighVersion);
      if (this.compare(newVersion, nextHighVersion) >= 0) {
          return {
              code: "LOWER_MINOR_VERSION",
              errorType: "ERROR",
              message: `The new version: ${this.versionStr(newVersion)} is invalid. Minor versions must be within the current major version: ${this.versionStr(currentVersion)} and cannot exceed the next major version: ${this.versionStr(nextHighVersion)}.`
          };
      }
  }
    return null
  }


  typeOfVersionChange(currentVersion, newVersion) {
    let res = newVersion.major - currentVersion.major;
    if (res > 0) {
      return "MAJOR"
    } else if (res < 0) {
      return "INVALID_MAJOR"
    }

    let minorComp = newVersion.minor - currentVersion.minor;
    if (minorComp == 0) {
      return "NO_CHANGE"
    } else if (minorComp < 0) {
      return "INVALID_MINOR"
    } else {
      return "MINOR"
    }
  }

  compare(v1, v2) {
    let majorDiff = v1.major - v2.major;
    if (majorDiff != 0) {
      return majorDiff
    }

    return v1.minor - v2.minor;
  }

