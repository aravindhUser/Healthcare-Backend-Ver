import { ApiService } from 'src/app/core/services/api/api.service';
import { number } from 'prop-types';

enum Selection {
  myActions = 'myActions',
  others = 'others',
  viewAll = 'viewAll'
}

enum Tab {
  inbox = 'inbox',
  approved = 'approved',
  pending = 'pending',
  rejected = 'rejected'
}

@Component({
  selector: 'app-admin',
  templateUrl: './admin.component.html',
  styleUrls: ['./admin.component.scss'],
})
export class AdminComponent implements OnInit {
  private destroyed$: ReplaySubject<boolean> = new ReplaySubject(1);

  COMPONENT = COMPONENTS;
  pendingAPIs: IApi[];
  approvedAPIs$: Observable<IApi[]>;
  breadcrumbArray = BREADCRUMB.ADMIN.MAIN;
  submittedApis: IDashboard[];
  resubmittedApis: IDashboard[];
  submittedAndResubmittedApis: IDashboard[];
  rejectedApis: IDashboard[];
  approvedApis: IDashboard[];
  pendingApis: IDashboard[];

  tab = Tab;
  selection = Selection;

  viewAllInbox: boolean = true;
  myActionsInbox: boolean = false;
  othersInbox: boolean = false;

  viewAllPending: boolean = true;
  myActionsPending: boolean = false;
  othersPending: boolean = false;

  viewAllApproved: boolean = true;
  myActionsApproved: boolean = false;
  othersApproved: boolean = false;

  viewAllRejected: boolean = true;
  myActionsRejected: boolean = false;
  othersRejected: boolean = false;

  userId = String(this.authService.currentUserValue?.userId);
  currentUser: IUser;
  selectedDashboard: string;
  dashboardTitle: string = "Dashboard";
  submittedApps: IAppDashboard[];
  rejectedApps: IAppDashboard[];
  approvedApps: IAppDashboard[];
  pendingApps: IAppDashboard[];

  dashboards = ['Service', 'Subscriptions']
  
  gatewayMap: Map<number, Gateway>;
  constructor(
    private apiSubmissionService: ApiSubmissionService,
    private authService: AuthService,
    private pageTitleFilterService: PageTitleFilterService,
    private stateVariablesService: StateVariablesService,
    private userService: UserService,
    public apiService: ApiService,

    private appSubmissionService: AppSubmissionService

  ) {
    //This is intentional
  }




  ngOnInit(): void {
    sessionStorage.setItem("selectedScopes","");//Code for implementing PINXTSS-2253
    sessionStorage.setItem("removedScopes","");//Code for implementing PINXTSS-2253
    let gatewayValues = JSON.parse(sessionStorage.getItem('gateways'))

    // this.apiService.getGateways()
    // .subscribe((data: Gateway[])=> {
     
     
      this.gatewayMap = new Map<number, Gateway>();
      gatewayValues.forEach(g => {
        this.gatewayMap.set(g.gatewayId, g)
      })
      console.log("Admin -- this.gatewayMap", this.gatewayMap) 
    // });
    this.selectedDashboard = "Service";
    // this.currentUser = this.authService.currentUserValue;

    this.userService.currentUser$.subscribe((user) => {
      this.userId = user.userId;
      this.currentUser = user

      // Update the view or perform any other logic based on the updated user object
    });
    if ((this.currentUser?.extension?.additionalRoles?.includes(AdditionalRoles.Domainowner) ||
      this.currentUser?.extension?.additionalRoles?.includes(AdditionalRoles.Productowner)) &&
      this.currentUser?.role.toLowerCase() !== Role.admin) {
      this.apiSubmissionService.getDashboardEntriesForProductOwner('Submitted')
        .pipe(takeUntil(this.destroyed$))
        .subscribe(x => {
          this.submittedApis = x;
          this.apiSubmissionService.getDashboardEntriesForProductOwner('Re-submitted')
            .pipe(takeUntil(this.destroyed$))
            .subscribe(x => {
              this.resubmittedApis = x;
              this.submittedAndResubmittedApis = this.submittedApis.concat(this.resubmittedApis)
              // console.log("api admin submittedAndResubmittedApis", this.submittedAndResubmittedApis)
              // this.submittedAndResubmittedApis.forEach(api => {
              //   console.log("api admin", api)
              //   // this.gatewayMap.get(api.)
              // })
            }, err => console.log('logged error', err));
        }, err => console.log('logged error', err));
      console.log('resubmit call------------------------------------------')


      this.apiSubmissionService.getDashboardEntriesForProductOwner('Pending')
        .pipe(takeUntil(this.destroyed$))
        .subscribe(x => {
          this.pendingApis = x;
        }, err => console.log('logged error', err));

      this.apiSubmissionService.getDashboardEntriesForProductOwner('Approved')
        .pipe(takeUntil(this.destroyed$))
        .subscribe(x => {
          this.approvedApis = x;
        }, err => console.log('logged error', err));

      this.apiSubmissionService.getDashboardEntriesForProductOwner('Rejected')
        .pipe(takeUntil(this.destroyed$))
        .subscribe(x => {
          this.rejectedApis = x;
        }, err => console.log('logged error', err));

    } else {
      // API Inbox Backend Calls.
      this.apiSubmissionService.getAdminDashboardEntries('Submitted')
        .pipe(takeUntil(this.destroyed$))
        .subscribe(x => {
          this.submittedApis = x;
          this.apiSubmissionService.getAdminDashboardEntries('Re-submitted')
            .pipe(takeUntil(this.destroyed$))
            .subscribe(x => {
              this.resubmittedApis = x;
              this.submittedAndResubmittedApis = this.submittedApis.concat(this.resubmittedApis)
              
              this.injectApiGatewayName(this.submittedAndResubmittedApis);
              // console.log("api admin submittedAndResubmittedApis", this.submittedAndResubmittedApis)
            }, err => console.log('logged error', err));
        }, err => console.log('logged error', err));

      this.apiSubmissionService.getAdminDashboardEntries('Pending')
        .pipe(takeUntil(this.destroyed$))
        .subscribe(x => {
          this.pendingApis = x;
          this.injectApiGatewayName(this.pendingApis);
        }, err => console.log('logged error', err));

      this.apiSubmissionService.getAdminDashboardEntries('Approved')
        .pipe(takeUntil(this.destroyed$))
        .subscribe(x => {
          this.approvedApis = x;
          this.injectApiGatewayName(this.approvedApis);
        }, err => console.log('logged error', err));

      this.apiSubmissionService.getAdminDashboardEntries('Rejected')
        .pipe(takeUntil(this.destroyed$))
        .subscribe(x => {
          this.rejectedApis = x;
          this.injectApiGatewayName(this.rejectedApis);
        }, err => console.log('logged error', err));


      // End of API Inbox backend calls.

      // APP Inbox Backend calls.
      // this.appSubmissionService.getAppDashboardEntries('Submitted')
      //   .pipe(takeUntil(this.destroyed$))
      //   .subscribe(x => {
      //     this.submittedApps = x;
      //   }, err => console.log('logged error', err));

      // this.appSubmissionService.getAppDashboardEntries('Pending')
      //   .pipe(takeUntil(this.destroyed$))
      //   .subscribe(x => {
      //     this.pendingApps = x;
      //   }, err => console.log('logged error', err));

      // this.appSubmissionService.getAppDashboardEntries('Approved')
