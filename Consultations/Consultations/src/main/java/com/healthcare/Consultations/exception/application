  setOverrideData(){
    const HttpVerbs = ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD", "TRACE"];
       let overrideData = {"overrides" : this.override.filter( e => HttpVerbs.includes(e.method.toUpperCase()) )}
       if(overrideData.overrides){
        // console.log(overrideData.overrides);
          for(let index = 0;index<overrideData.overrides.length; index++){

            if(overrideData.overrides[index].method !=="parameters"){
              const overrideValue = overrideData.overrides[index];
              let resourceLocation = overrideValue.resourceLocation || "";
              let method = overrideValue.method || "";
              let overrideInd = overrideValue.overrideInd ;
              // console.log(overrideInd);
              let override = this.newOverride();
              override.controls.resourceLocation.setValue(resourceLocation);
              override.controls.method.setValue(method);
              override.controls.overrideInd.setValue(overrideInd);
              this.overrideArray().push(override);

              for(let j=0; j<overrideValue.targetURLOverride.length; j++){
                  const targetUrlValue = overrideValue.targetURLOverride[j];
                  let gatewayEnvId = targetUrlValue.gatewayEnvId;
                  let targetEnvDesc = targetUrlValue.targetEnvDesc;
                  let targetURL = targetUrlValue.targetURL;
                  let newTargetUrl = this.newTargetUrl();
                  newTargetUrl.controls.gatewayEnvId.setValue(gatewayEnvId);
                  newTargetUrl.controls.targetEnvDesc.setValue(targetEnvDesc);
                  newTargetUrl.controls.targetURL.setValue(targetURL);

                  let value = this.overrideArray().at(index).get('targetURLOverride') as FormArray;
                  value.push(newTargetUrl);

              }
            }

          }
       }
      //  console.log(this.overrideForm);
  }

