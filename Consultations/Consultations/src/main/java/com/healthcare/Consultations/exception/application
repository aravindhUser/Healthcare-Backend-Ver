import { AfterViewInit, Component, OnInit, OnDestroy, Inject, Input } from "@angular/core";
import { take } from "rxjs/operators";
import { AuthService } from "./core/services/auth/auth.service";
import { EnvConfig } from "./core/config/env-config";
import { EnvironmentLoaderService } from "./core/config/environment-loader.service";
import { MatDialog, MatDialogRef } from "@angular/material/dialog";
import { Router } from "@angular/router";
import { SessionExpiryDialogComponent } from "./shared/components/session-expiry-dialog/session-expiry-dialog.component";
import { UserService } from "./core/services/auth/user.service";
import { Iteams } from "./core/models/auth/iuser";

@Component({
  selector: "app-root",
  templateUrl: "./app.component.html",
  styleUrls: ["./app.component.scss"],
})
export class AppComponent implements OnInit, AfterViewInit, OnDestroy {
  public envConfig: EnvConfig;
  private expirationCheckInterval: any;
  @Input() isBannerRequired: boolean = true;
  target = this.envService.getEnvConfig().dynamicRouteTarget;

  constructor(
    public readonly envService: EnvironmentLoaderService,
    private authService: AuthService,
    private dialog: MatDialog,
    private router: Router,
    private userService: UserService // Added UserService
  ) {}

  ngOnInit(): void {
    this.envConfig = this.envService.getEnvConfig();
    // this.getGateways();//Commented to fix inaccuracies
    // this.fetchUserTeams();//Commented to fix inaccuracies
    this.authService.isDoneLoading$.pipe(take(1)).subscribe((isDone) => {
      if (isDone) {
        !this.authService.hasValidAccessTokenAndIdToken &&
        localStorage.getItem("access_token")
          ? this.authService.logout()
          : this.notLoggedIn();

      }
    });

      if(!this.authService.hasValidAccessTokenAndIdToken){
        this.authService.logout();
        console.log("Came to 43",this.authService.hasValidAccessTokenAndIdToken);
      } 

    // Start the session expiration check
    this.startExpirationCheck();
    this.getGateways();//Added to fix inaccuracies made in function call sequence
    // this.fetchUserTeams();//Added to fix inaccuracies made in function call sequence
  }

  notLoggedIn() {
    return null;
  }

  ngAfterViewInit() {}


  // }

  async getGateways() {
    if (!this.envConfig) {
      throw new Error("Environment configuration is not loaded.");
    }

    const _gatewayURL = `${this.envConfig.origin}/gateway`;

    // Wait until accessToken is available in localStorage
    let accessToken = localStorage.getItem('access_token');
    let retryCount = 0;
    const maxRetries = 50; // Limit retries to avoid infinite loop

    while (!accessToken && retryCount < maxRetries) {
      console.warn(`Retrying to fetch accessToken... Attempt ${retryCount + 1}`);
      await new Promise(resolve => setTimeout(resolve, 100)); // Poll every 100ms
      accessToken = localStorage.getItem('access_token');
      retryCount++;
    }

    if (!accessToken) {
      console.error('Failed to retrieve accessToken after multiple attempts.');
      return;
    }

    try {

      const response = await fetch(_gatewayURL, {
        headers: {
          "Authorization": "Bearer " + accessToken,
          "Content-Type": "application/json",
          'target': this.target
        },
      });

      if (!response.ok) {
        const errorDetails = await response.text();
        throw new Error(`Gateway call failed with status: ${response.status}, details: ${errorDetails}`);
      }

      const gateways = await response.json();
      console.log('gateways', gateways);
      sessionStorage.setItem("gateways", JSON.stringify(gateways));

      // Code for implementing PINXTSS-3371 start
      const gatewayHostnameSet = new Set<string>();
      gatewayHostnameSet.add("localhost".toLowerCase());
      gateways.forEach((gateway:any)=>{
        gateway.environments.forEach((env: any)=>{
          env.url.forEach((urlObj)=>{
            try{
              const hostname = new URL(urlObj.value).hostname.toLowerCase();
              gatewayHostnameSet.add(hostname);
            }
            catch(e){
              console.error('Invalid URL: ',urlObj.value);
            }
          });
        });
      });
      const gatewayHostnames: string[]=Array.from(gatewayHostnameSet);
      sessionStorage.setItem('gatewayHostnames',JSON.stringify(gatewayHostnames));
      // Code for implementing PINXTSS-3371 end

      // Call fetchUserTeams if getGateways is successful
      await this.fetchUserTeams();
    } catch (error) {
      console.error('Failed to fetch gateways:', error);
    }
  }

  async fetchUserTeams(): Promise<void> {
    try {
      const teams: Iteams[] = await this.userService.getUserTeams().toPromise();
      console.log('Fetched Teams:', teams);
      sessionStorage.setItem('teams', JSON.stringify(teams));
    } catch (error) {
      console.error('Failed to fetch teams:', error);
    }
  }

  ngOnDestroy() {

    const accessToken = localStorage.getItem("access_token");
    const _gatewayURL = `${this.envConfig.origin}/gateway`;

    fetch(_gatewayURL, {
      headers: {
        Authorization: "Bearer " + accessToken,
        "Content-Type": "application/json",
        target: this.target,
      },
    })
      .then((data) => {
        let response = data.json();
        return response;
      })
      .then((response) => {
        console.log("gateways", response);
        sessionStorage.setItem("gateways", JSON.stringify(response));
      })
      .catch((error) => error);
  }

  startExpirationCheck() {
    const expirationTime = JSON.parse(localStorage.getItem('expiration'));

    // Clear any existing interval
    if (this.expirationCheckInterval) {
      clearInterval(this.expirationCheckInterval);
    }

    this.expirationCheckInterval = setInterval(() => {
      this.checkExpiration(expirationTime);
    }, 1000 * 6); // Check every minute
  }

  checkExpiration(expirationTime: number) {
    if (expirationTime && expirationTime < Date.now()) {
      console.log('Session expired, logging out...');
      localStorage.clear();
      sessionStorage.clear();

      const dialogRef = this.dialog.open(SessionExpiryDialogComponent);

   

      clearInterval(this.expirationCheckInterval);
    }
  }

}

