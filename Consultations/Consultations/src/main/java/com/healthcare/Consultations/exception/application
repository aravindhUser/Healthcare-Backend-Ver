        );


      } else {
        //console.log('admin entering default value');
        this.connectivityInfoForm.get("cmdbAppId").clearValidators();
        this.connectivityInfoForm.get("cmdbAppId").updateValueAndValidity();
      }
    }else{
      //console.log(ctrl.value)
    if (ctrl.value.length !== 7 || !ctrl.value.startsWith("APP") || !/\d{4}$/.test(ctrl.value) ) {
      this.connectivityInfoForm.get("cmdbAppId").setValidators(f => <any>{ invalidCmdbAppId: true});
