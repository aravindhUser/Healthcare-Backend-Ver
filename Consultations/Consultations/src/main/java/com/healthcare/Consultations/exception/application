  // Code for implementing PINXTSS-4030 start
  basePathValidator(control: AbstractControl): ValidationErrors | null {
    // Code for implementing PINXTSS-4032 & PINXTSS-4033 start
    if(this.mode===DashboardModes.PUBLISH){
      return null;
    }
    // Code for implementing PINXTSS-4032 & PINXTSS-4033 end
    const originalApiVersion = this.selectedApiData.apiDetails.apiVersion;
    const originalBasePath = this.selectedApiData.apiDetails.basePath;
    const newBasePath = control.value;
    const newApiVersion = this.detailsForm.get('apiVersion')?.value;
    const isMajorVersionChange = this.isMajorVersion(originalApiVersion, newApiVersion);

    if (!this.isApiPreviouslyApproved || !isMajorVersionChange) {
      return null;
    }

    const normalize = (path: string) => path.replace(/\/+$/, '').toLowerCase();
    const versionRegex = /\/v\d+(\.\d+)?$/;

    const originalWithoutVersion = normalize(originalBasePath).replace(versionRegex, '');
    const updatedWithoutVersion = normalize(newBasePath).replace(versionRegex, '');

    return originalWithoutVersion !== updatedWithoutVersion ? { invalidBasePath: true } : null;
  }
