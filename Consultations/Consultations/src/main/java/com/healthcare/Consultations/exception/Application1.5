	private static DasboardMasterRequest buildDasboardMasterRequest(String submissionType, AdminDashboard adminEntity,
			List<DashboardActionHistory> actionHistoryEntity) {

		List<DashboardActionHistoryModel> actionHistoryModels = new ArrayList<>();
		for (DashboardActionHistory x : actionHistoryEntity) {
			DashboardActionHistoryModel actionHistoryModel = new DashboardActionHistoryModel();
			actionHistoryModel.setActionBy(x.getActionBy());
			actionHistoryModel.setActionTimestamp(x.getActionTimestamp());
			actionHistoryModel.setCommentText(x.getCommentText());
