	@SuppressWarnings({"rawtypes", "unchecked"})
	@PostMapping(value = "/dashboard")
	public ResponseEntity<List<AdminDashboard>> createdashbord(
	@RequestBody AdminDashboardRequest entity,
	@RequestHeader(value = "X-JWT", required = false) String jwtToken,
	@RequestHeader(value = "X-TRANSACTION-ID") String transactionID,
	@RequestHeader(value = "x-trace-id") String xTraceId) throws Exception {
		LOGGER.info("Inside createdashbord method with AdminDashboardRequest:{}", entity.toString());
		LOGGER.info("JWT Token :{}", jwtToken);
		ResponseEntity<List<AdminDashboard>> dashboardList = null;
		if (jwtToken == null || jwtToken.isEmpty()) {
			return new ResponseEntity<>(HttpStatus.FORBIDDEN);
		}
		if (entity.getApiDetails()!=null){
			mandatoryValidationsForGatedNonGatedApis(entity);
		}
