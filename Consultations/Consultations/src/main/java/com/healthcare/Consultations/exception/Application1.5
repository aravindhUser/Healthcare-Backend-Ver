	public void updateIsLatestForApisInOpensearch(AdminDashboardRequest newEntity) {
		log.info("Inside updateIsLatestForApisInOpensearch");
		Long apiFamilyId = newEntity.getApiDetails().getApiFamilyId();
		String version = newEntity.getApiDetails().getApiVersion();
		String targetMajorVersion = getMajorVersion(version);
		List<Apis> apis = apiRepository.findByApiFamilyId(apiFamilyId);
		List<Apis> targetApis = apis.stream()
				.filter(api -> getMajorVersion(api.getApiVersion()).equals(targetMajorVersion))
				.collect(Collectors.toList());
		log.info("APIS Data in updateIsLatestForApisInOpensearch: {}",apis);
		if (targetApis.isEmpty()) {
			log.info("No records found for given major version: {}", targetMajorVersion);
		} else {
			List<Long> tobeUpsertedIds = targetApis.stream().map(Apis::getApiId).collect(Collectors.toList());
			if (targetApis != null && !targetApis.isEmpty()) {
				BulkSyncOnDemandRequest bulkSyncOnDemandRequest = new BulkSyncOnDemandRequest();
				bulkSyncOnDemandRequest.setToBeUpsertedApiIds(tobeUpsertedIds);
				callBulkSyncOnDemand(bulkSyncOnDemandRequest);
			}
		}
	}
	
	
	private void callBulkSyncOnDemand(BulkSyncOnDemandRequest bulkSyncOnDemandRequest) {
