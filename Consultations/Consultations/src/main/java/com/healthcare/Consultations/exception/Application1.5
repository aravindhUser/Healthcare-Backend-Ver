	public ResponseEntity<String> loggedInInternalUserIsEditingDisabled(String authToken) {
		LOGGER.info("Inside loggedInUserIsEditingDisabled method");
		ArrayList<String> userRoleAndEmail = tokenValidation(authToken);

		String userRole = userRoleAndEmail.get(0);
		String email = userRoleAndEmail.get(1);

		String orgType = null;

		try {
			if (userRole == null) {
				throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "User is not Registered");
			} else if (Boolean.TRUE.equals(isEditingDisabled) && !("Admin".equals(userRole))) {
				return new ResponseEntity<>(HttpStatus.FORBIDDEN);
			} else if ("Admin".equals(userRole) || "Developer".equals(userRole) || "Manager".equals(userRole)) {
				orgType = adminDashboardRepository.getOrgType(email);

				if ("Internal".equals(orgType)) {
					return new ResponseEntity<>(userRole, HttpStatus.OK);
				} else {
					throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Not an Internal User");
				}
			}

		} catch (Exception exception) {
			LOGGER.info("Exception occured in loggedInInternalUser method :{}", exception.getMessage());
			throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, exception.getMessage());
		}

		throw new ResponseStatusException(HttpStatus.FORBIDDEN, "User is not Registered");
	}

