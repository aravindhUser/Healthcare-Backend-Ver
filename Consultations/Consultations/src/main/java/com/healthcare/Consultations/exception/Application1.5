		for (ModifiedInboxPayload inboxList : modifiedInboxPayload) {
			InboxApiDetails apiDetails = new InboxApiDetails();
			ClientTrackingInfo clientTrackingInfo = new ClientTrackingInfo();
			ModifiedGetDashboardInboxPayload modifiedGetDashboardInboxPayload = new ModifiedGetDashboardInboxPayload();
