	private ApiResponse apiServiceCallAfterPublish(AdminDashboardRequest newEntity, long apiId, HttpHeaders previousHeaders,
			String specPath) {
		log.info("\n\nUpdating API table post publish workflow\n");
		ApiRequest apiRequest = newEntity.getApiDetails();
		if(!newEntity.getStatus().equalsIgnoreCase("Re-submitted")) {
			apiRequest.setStatus(true);
		}
		log.info("specPath :{} sbspecBucketName:{} nbspecBucketName:{}", specPath, sbspecBucketName, nbspecBucketName);
		if (specPath.contains("/" + sbspecBucketName + "/")) {
			log.info("Inside specpath If");
			String tempSpecPath = specPath.replace("/" + sbspecBucketName + "/", "/" + nbspecBucketName + "/");
			apiRequest.setSpecPath(tempSpecPath);
			apiRequest.setSpecType(newEntity.getApiDetails().getSbSpecType());
		}
		ResponseEntity<ApiResponse> resultTagApi;
		HttpEntity<String> apisEntity2 = new HttpEntity(apiRequest, previousHeaders);
		log.info("Api request: {}", apiRequest);
		try {
			 resultTagApi = restTemplate.exchange(apiServicePath + "/" + apiId,
					HttpMethod.PATCH, apisEntity2, ApiResponse.class);
			log.info("resultTagApi body: {}", resultTagApi.getBody());
		} catch (RestClientException e) {
			log.error("Failed to PATCH API using API Service");
			throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
					"Exception occured in createOrUpdateDashboard Api ", e);
		}
		return resultTagApi.getBody();
	}

