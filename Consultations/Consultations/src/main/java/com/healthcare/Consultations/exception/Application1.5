			ResponseEntity loggedInInternalUserIsEditingDisabledResponse = loggedInInternalUserIsEditingDisabled(jwtToken);

			if (loggedInInternalUserIsEditingDisabledResponse.getStatusCode() == HttpStatus.FORBIDDEN) {
				return loggedInInternalUserIsEditingDisabledResponse;
			}

			dashboardList = adminDashboardService.createdashbord(entity, jwtToken, transactionID, xTraceId);

		} catch (Exception ex) {
			LOGGER.error("Exception occured in createdashbord api", ex);
			throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
					"Exception occured in createdashbord api", ex);
		}
		return dashboardList;
	}


