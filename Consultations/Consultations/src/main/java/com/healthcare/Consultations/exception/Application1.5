			modifiedGetDashboardInboxPayload.setCommentText(inboxList.getCommentText());
			modifiedGetDashboardInboxPayload.setActionTs(inboxList.getActionTimestamp());
			modifiedGetDashboardInboxPayload.setStatus(inboxList.getStatus());
			modifiedGetDashboardInboxPayload.setRequestId(inboxList.getRequestId());
			modifiedGetDashboardInboxPayload.setUpdatedTs(inboxList.getUpdatedTimestamp());
			apiDetails.setApiId(inboxList.getApiId());
			apiDetails.setApiName(inboxList.getApiName());
			apiDetails.setProductName(inboxList.getProductName());
			apiDetails.setProductId(inboxList.getProductId());
			apiDetails.setRequestedBy(inboxList.getRequestedBy());
			apiDetails.setRequestedTimestamp(inboxList.getRequestedDate());
			apiDetails.setApiVersion(inboxList.getApiVersion());
