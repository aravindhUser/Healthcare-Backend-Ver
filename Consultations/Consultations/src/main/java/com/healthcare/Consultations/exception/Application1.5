	private String getMajorVersion(String version) {
		try {
			return version.split("\\.")[0].substring(1);
		} catch (Exception e) {
			log.error("Invalid version format:{}",version);
			throw new IllegalArgumentException("Invalid version format: " + version, e);
		}
	}

	private void validateVersion(String version) {
		if (!Pattern.matches(VERSION_REGEX, version)) {
			log.error("Invalid version format. Version must follow the pattern vX.Y where X and Y are between 1 and 99.");
			throw new IllegalArgumentException("Invalid version format. Version must follow the pattern vX.Y where X and Y are between 1 and 99.");
		}
	}

	private Double parseVersion(String version) {
		try {
			return Double.parseDouble(version.substring(1).replace(".", ""));
		} catch (NumberFormatException e) {
			log.error("Invalid version format:{}",version);
			throw new IllegalArgumentException("Invalid version format: " + version, e);
		}
	}

	@Transactional
	public List<Apis> updateIsLatestForApis(Long familyId, String targetMajorVersion) {
		List<Apis> apis = apiRepository.findByApiFamilyId(familyId);
		List<Apis> targetApis = apis.stream()
				.filter(api -> getMajorVersion(api.getApiVersion()).equals(targetMajorVersion))
				.collect(Collectors.toList());
		log.info("APIS Data in updateIsLatestForAPIS: {}",apis);

		if (targetApis.isEmpty()) {
			log.info("No records found for given major version: {}", targetMajorVersion);
			throw new IllegalArgumentException("No records found for given major version: " + targetMajorVersion);
		}

		log.info("Targeted APIS Data in updateIsLatestForAPIS: {}",targetApis);

		if(targetApis.size()==1){
			targetApis.get(0).setIsLatest(true);
			apiRepository.save(targetApis.get(0));
		}
		else{
			List<Apis> validPatternApis = targetApis.stream()
					.filter(api -> isNewVersionPattern(api.getApiVersion()))
					.collect(Collectors.toList());
			log.info("Valid Pattern APIS: {}",validPatternApis);
			Apis latestVersion = validPatternApis.stream()
					.max(Comparator.comparing(api -> parseVersion(api.getApiVersion())))
					.orElse(null);
			log.info("LatestVersion API: {}",latestVersion);
			targetApis.forEach(api -> {
//				if (isNewVersionPattern(api.getApiVersion())) {
					api.setIsLatest(api.equals(latestVersion));
//				} else {
//					api.setIsLatest(false);
//				}
				apiRepository.save(api);
			});
			log.info("IsLatest data updated successfully");
		}
		return targetApis;
	}

	private boolean isNewVersionPattern(String version) {
		return version.matches(VERSION_REGEX);
	}

