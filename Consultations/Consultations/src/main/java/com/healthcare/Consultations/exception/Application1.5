	private ResponseEntity<String> deleteApi(Long apiId, String jwtToken, String xTraceId) {
		log.info("Inside deleteApi method");
		ResponseEntity<String> resp = null;
		MultiValueMap<String, String> headers = new LinkedMultiValueMap<>();
		headers.add(AppConstant.XJWT, jwtToken);
		headers.add(AppConstant.XTRACEID, xTraceId);
		HttpEntity<?> request = new HttpEntity<Object>(headers);
		String commonUrl = appConfig.getApiServicePath().substring(0,appConfig.getApiServicePath().lastIndexOf('/'));
		String url = commonUrl + "/internal-api/apis/" + apiId;
		
		try {
			resp = restTemplate.exchange(url, HttpMethod.DELETE, request, String.class);
		} catch (RestClientException e) {
			log.error("Failed to Delete Api with Api id :{}", apiId);
			throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,
					"Exception occured in deleteApi service method", e);
		}
		return resp;
	}
}
