	public long returnCurrentTimestamp() {
		return Instant.now().getEpochSecond();
	}

	public ResponseEntity<String> loggedInAdmin(String authToken) {
		LOGGER.info("Inside loggedInAdmin method");
		ArrayList<String> userRoleAndEmail = tokenValidation(authToken);

		String userRole = userRoleAndEmail.get(0);
		String email = userRoleAndEmail.get(1);

		String orgType = null;
		Boolean isAdmin = false;

		try {

			email = email.toLowerCase();
			userRole = adminDashboardRepository.getRole(email);

			if (userRole == null) {
				throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "User is not Registered");
			}
			if ("Admin".equals(userRole)) {
				isAdmin = true;
			}

			if (!isAdmin) {
				return new ResponseEntity<>(HttpStatus.FORBIDDEN);

			}

		} catch (Exception exception) {
			LOGGER.error("Inside JWT catch Block of loggedInAdmin method", exception.getMessage());
			throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, exception.getMessage());
		}

		return new ResponseEntity<>(HttpStatus.OK);
	}

	public ArrayList<String> tokenValidation(String authToken) {
		String token = authToken;
		String[] tokenArray = token.split("\\.");
		String tokenHeader = tokenArray[0];
		String tokenPayload = tokenArray[1];

		String userRole = null;

		ArrayList<String> userRoleAndEmail = new ArrayList<>();

		try {
			LOGGER.info("Inside try block");
			//Extracting Payload and validating JSON
			LOGGER.info("before decoding");
			byte[] decodedPayload = Base64.getDecoder().decode(tokenPayload);
			String decodedPayloadString = new String(decodedPayload);
			LOGGER.info("before validation");
			boolean isValidPaylaod = this.isJSONValid(decodedPayloadString);
			LOGGER.info("after decoding");

			//Extracting Values from JSON
			JSONObject jsonObject = new JSONObject(decodedPayloadString);

			String iss = jsonObject.getString("iss");
			int exp = jsonObject.getInt("exp");
			String email = getEmail(jsonObject);
			long currentTimestamp = returnCurrentTimestamp();

			if (exp < currentTimestamp) {
				throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "The token has expired");
			}
			if (iss == null) {
				throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Issuer Null");
			} else if (!iss.equals(appConfig.getIssString())) {
				throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Issuer Mismatch");
			}
			email = email.toLowerCase();

			userRole = adminDashboardRepository.getRole(email);

			userRoleAndEmail.add(userRole);
			userRoleAndEmail.add(email);

		} catch (Exception exception) {
			LOGGER.info("Exception occured in loggedInInternalUser method :{}", exception.getMessage());
			throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, exception.getMessage());
		}
		return userRoleAndEmail;
	}

	public String getEmail(JSONObject jsonObject) {
		return jsonObject.getString("Email");
	}


	public boolean isJSONValid(String jsonInString) {
		try {
			final ObjectMapper mapper = new ObjectMapper();
			mapper.readTree(jsonInString);
			return true;
		} catch (IOException e) {
			return false;
		}
	}

	public void mandatoryValidationsForGatedNonGatedApis(AdminDashboardRequest entity) {

		Long gatewayId = entity.getApiDetails().getApiGatewayId();
		String clientAccessType = entity.getApiDetails().getConsumerType();


		if (entity.getApiDetails().getSbSpecPath()== null || entity.getApiDetails().getSbSpecPath().isEmpty()) { 
			LOGGER.error("Service swagger cannot be Empty");
			throw new ResponseStatusException(HttpStatus.BAD_REQUEST, SBSPECEMPTYERRORMSG);
		}
		if ("Private".equalsIgnoreCase(clientAccessType) && gatewayId != 99) {
			LOGGER.error("Client Access and Gateway selection are conflicting. Gateway must be Private");
			throw new ResponseStatusException(HttpStatus.BAD_REQUEST, PRIVTEACCESSTYPEERRORMSG);
		}

		if (("External".equalsIgnoreCase(clientAccessType) || "Internal".equalsIgnoreCase(clientAccessType) || "Both".equalsIgnoreCase(clientAccessType)) && gatewayId == 99) {
			LOGGER.error("Client Access and Gateway selection are conflicting.Gateway cannot be Private");
			throw new ResponseStatusException(HttpStatus.BAD_REQUEST, INTEXTBOTHACCESSTYPEERRORMSG);
		}
		// 88 - None GW, 99- Private GW , 100 series - Other GW
		if (gatewayId == 88 || gatewayId == 99 || gatewayId >= 100 )	{
			
			LOGGER.info("Non Gated APIs :{}", gatewayId); 
			if(entity.getApiDetails().getBasePath() != null && !entity.getApiDetails().getBasePath().isEmpty())  {
				if(entity.getApiDetails().getBasePath().matches("^/$") 
						&& (entity.getApiDetails().getTargetBasePath() == null || entity.getApiDetails().getTargetBasePath().isEmpty())) {
					LOGGER.info("Skipping basepath and targetBasePath comparing validation when basepath has only slash.");
				} else if(!(entity.getApiDetails().getBasePath()
						.equals(entity.getApiDetails().getTargetBasePath()))) {
					LOGGER.error(
							"For the selected Gateway, the Client Base path and Target Base path must be the same");
					throw new ResponseStatusException(HttpStatus.BAD_REQUEST, CLIENTVSTARGETBASEPATHERRORMSG);
				}
			}

			if (entity.getApiDetails().getOverrides()!= null && ! (entity.getApiDetails().getOverrides().isEmpty())) {

				LOGGER.error("Resource level overrides must be Empty");
				throw new ResponseStatusException(HttpStatus.BAD_REQUEST, OVERRIDESEMPTYERRORMSG);
			}
			if ( entity.getApiDetails().getCpAttachedPlugins() != null && ! (entity.getApiDetails().getCpAttachedPlugins().isEmpty()))
			{
				LOGGER.error("Plugins must be Empty");
				throw new ResponseStatusException(HttpStatus.BAD_REQUEST, CPSPPLUGINEMPTYERRORMSG);
			}
			if ((entity.getApiDetails().getTargetMapping() == null || entity.getApiDetails().getTargetMapping().isEmpty())){
				LOGGER.error("Target Mapping cannot be Empty:{}", gatewayId);
				throw new ResponseStatusException(HttpStatus.BAD_REQUEST, TARGETMAPPINGERRORMSG);
			}
			else {
				boolean isCheckDuplicates = checkEnvUniqueness(entity);
				if (isCheckDuplicates ){
					LOGGER.error("Connectivity Information cannot have duplicate environments");
					throw new ResponseStatusException(HttpStatus.BAD_REQUEST, DUPLICATEENVERRORMSG);
				}
			}
		}
		else {

//			Code for implementing PINXTSS-2546 start
			if(entity.getApiDetails().getApiGatewayId()==ENTERPRISEGW || entity.getApiDetails().getApiGatewayId()==PAYMENTGW || entity.getApiDetails().getApiGatewayId()==MOBILEGW)
			{
				if(entity.getApiDetails().getIntakeJIRAs()==null || entity.getApiDetails().getIntakeJIRAs().isEmpty()){
					LOGGER.error("For the selected Gateway,intakeJIRAs cannot be Empty");
					throw new ResponseStatusException(HttpStatus.BAD_REQUEST,INTAKEJIRASERRORMSG);
				}
			}

//			Code for implementing PINXTSS-2546 end
			if (entity.getApiDetails().getCpAttachedPlugins() == null || entity.getApiDetails().getCpAttachedPlugins().isEmpty())
			{
				LOGGER.error("For the selected Gateway,Client Plugins cannot be Empty");
				throw new ResponseStatusException(HttpStatus.BAD_REQUEST, CPPLUGINERRORMSG);
			}
			if ((entity.getApiDetails().getTargetMapping() == null || entity.getApiDetails().getTargetMapping().isEmpty()) ){
				LOGGER.error("Target Mapping cannot be Empty:{}", gatewayId);
				throw new ResponseStatusException(HttpStatus.BAD_REQUEST, TARGETMAPPINGERRORMSG);
			}

		}

	}
public boolean checkEnvUniqueness(AdminDashboardRequest entity){

	List<TargetMapping> targetMappingResponse = entity.getApiDetails().getTargetMapping();
	return targetMappingResponse.stream().map(TargetMapping::getEnvId).collect(Collectors.groupingBy(Function.identity(),Collectors.counting())).values().stream().anyMatch(count -> count >1);
}

