			   AP.IS_LATEST as isLatest,
			   AD.creation_ts as creationTimestamp,
			   AD.updated_ts as updatedTimestamp,
			   (select distinct gateway_name from apicloud.gateway_hostname gh where gh.gateway_id = cast(AD.api_gateway as INT)) as gatewayName,
			   AD.REQUEST_ID as requestId
			   
			   FROM APICLOUD.ADMIN_DASHBOARD AD
			   INNER JOIN APICLOUD.APIS AP ON AD.API_ID = AP.API_ID
			   WHERE AD.status = :dashboardStatus AND CAST(AP.STATUS as varchar) = :status AND AP.API_FAMILY_ID = :apiFamilyId
			   AND SUBSTRING(AP.version,'v([0-9]+)\\.') = :targetMajorVersion
			""", nativeQuery = true)
